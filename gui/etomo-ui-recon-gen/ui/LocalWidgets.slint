// Widgets the reconstruction back-end dialogs need that
// `gui/etomo-ui-common/ui/widgets.slint` does not carry.  Each is named after
// the Swing class in `IMOD/Etomo/src/etomo/ui/swing` it stands for.  This file
// mirrors no single Java dialog; it is the local half of the shared
// vocabulary, kept here because the common crate must not be edited.

import {
    EtomoStyle, EtomoBridge, ContextArea, BridgedTextBox, BridgedButton, BridgedComboBox,
} from "../../etomo-ui-common/ui/widgets.slint";

// `EtchedBorder` (`EtchedBorder.java`): a titled etched group box.  Swing's
// etched border draws a dark line with a light line inside it; Slint gives a
// Rectangle one border colour, so the light half is an inset Rectangle.
export component EtchedBorder inherits Rectangle {
    in property <string> title;
    // Wired: false while the titled panel is not showing (`visible-value`
    // "brd"); the box then takes no room.
    out property <bool> shown-visible: !EtomoBridge.wired || root.title == ""
        || EtomoBridge.visible-value("brd", root.title, true, EtomoBridge.generation);
    height: root.shown-visible ? etched-layout.preferred-height : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    border-color: EtomoStyle.border;
    Rectangle {
        visible: root.shown-visible;
        border-width: 1px;
        border-color: EtomoStyle.border-light;
        background: transparent;
    }
    ContextArea { kind: "brd"; label: root.title; visible: root.shown-visible; }
    etched-layout := VerticalLayout {
        visible: root.shown-visible;
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;
        if root.title != "": Text {
            text: root.title;
            font-size: EtomoStyle.font-size-pt * 1px;
            color: EtomoStyle.text;
        }
        @children
    }
}

// `SingleLineButton` (`SingleLineButton.java`): the exit-row button.
export component SingleLineButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: named "bn." + its label (`setName(getUnformattedLabel())`);
    // `labels` lists every label the button can carry ("Advanced|Basic"), and
    // the shown text is the Swing button's.
    in property <string> labels: root.text;
    property <string> shown-text: EtomoBridge.wired
        ? EtomoBridge.text-value("bn", root.labels, root.text, EtomoBridge.generation)
        : root.text;
    // Wired: drawn only while the Swing component shows; it then takes no room.
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("bn", root.labels, true, EtomoBridge.generation);
    height: root.shown-visible ? EtomoStyle.field-height + 4px : 0px;
    min-width: root.shown-visible ? 90px : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 2px : 0px;
    border-color: EtomoStyle.border;
    Text {
        visible: root.shown-visible;
        text: root.shown-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        font-weight: 700;
    }
    area := BridgedButton {
        visible: root.shown-visible;
        kind: "bn";
        label: root.labels;
        default-enabled: root.enabled;
    }
}

// `GlobalExpandButton` (`GlobalExpandButton.java`): the Advanced/Basic toggle.
// `GlobalExpandButton.getInstance("Advanced", "Basic")` shows the label of the
// state it would switch *to*; the collapsed state shows "Advanced".
export component GlobalExpandButton inherits SingleLineButton {
    in property <bool> expanded: false;
    text: root.expanded ? "Basic" : "Advanced";
    labels: "Advanced|Basic";
}

// `ProcessDialog.pnlExitButtons` (`ProcessDialog.java:76-91`): Cancel,
// Postpone, Execute and Advanced, separated by horizontal glue.  Slint has no
// glue, so the row is `alignment: space-around`, which is what the glue does.
export component ExitButtons inherits HorizontalLayout {
    in property <string> execute-text: "Execute";
    in property <bool> use-postpone: true;
    in property <bool> show-advanced: true;
    alignment: space-around;
    padding: EtomoStyle.inset;
    spacing: EtomoStyle.gap;
    SingleLineButton { text: "Cancel"; }
    if root.use-postpone: SingleLineButton { text: "Postpone"; }
    SingleLineButton { text: root.execute-text; }
    if root.show-advanced: GlobalExpandButton { }
}

// `ComboBox` (`ComboBox.java`) / `JComboBox`: label, closed drop-down box.
export component ComboBox inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> box-width: 140px;
    in property <string> name;
    // `ComboBox.getEditableInstance`: the box takes typed text.
    in property <bool> editable: false;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("cbb", (root.name != "" ? root.name : root.label), true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        // `ComboBox.createPanel` (`ComboBox.java:119-124`): rigid 2px, the
        // label, rigid 3px, the combo box, rigid 2px.
        padding-left: 2px;
        padding-right: 2px;
        spacing: 3px;
        alignment: start;
        if root.label != "": Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        // Wired: "cbb." + the label (`ComboBox.setName`); `name` overrides the
        // label for a combo box drawn without one.
        BridgedComboBox {
            width: root.box-width;
            kind: "cbb";
            label: root.name != "" ? root.name : root.label;
            text: root.text;
            enabled: root.enabled;
            editable: root.editable;
        }
    }
}

// `javax.swing.JFileChooser` embedded in a panel with
// `setControlButtonsAreShown(false)` (`CleanupPanel.java:217-221`): the Metal
// chooser's "Look In" directory and Up button, its file list, the "File Name"
// field and the "Files of Type" combo box.  Wired, everything is the Swing
// chooser's (`EtomoBridge.chooser-*`): the list holds what the chooser accepts
// under its current filter, a click selects (Ctrl adds in its
// multi-selection list), a double click enters a directory.
export component FileChooser inherits Rectangle {
    in property <string> directory: ".";
    property <string> shown-directory: EtomoBridge.wired
        ? EtomoBridge.chooser-directory(EtomoBridge.generation) : root.directory;
    property <[string]> entries: EtomoBridge.wired
        ? EtomoBridge.chooser-entries(EtomoBridge.generation) : [];
    property <[bool]> selected: EtomoBridge.wired
        ? EtomoBridge.chooser-selected(EtomoBridge.generation) : [];
    property <[string]> filters: EtomoBridge.wired
        ? EtomoBridge.chooser-filters(EtomoBridge.generation) : ["Intermediate files"];
    property <int> current-filter: EtomoBridge.wired
        ? EtomoBridge.chooser-current-filter(EtomoBridge.generation) : 0;
    property <string> file-name: EtomoBridge.wired
        ? EtomoBridge.chooser-file-name(EtomoBridge.generation) : "";
    height: 220px;
    background: EtomoStyle.field-background;
    border-width: 1px;
    border-color: EtomoStyle.border;
    VerticalLayout {
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            Text { text: "Look in:"; vertical-alignment: center; }
            Rectangle {
                height: EtomoStyle.field-height;
                background: EtomoStyle.panel;
                border-width: 1px;
                border-color: EtomoStyle.border;
                Text { x: 3px; text: root.shown-directory; vertical-alignment: center; overflow: elide; }
            }
            Rectangle {
                width: 40px;
                height: EtomoStyle.field-height;
                background: EtomoStyle.panel;
                border-width: 1px;
                border-color: EtomoStyle.border;
                Text { text: "Up"; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { EtomoBridge.chooser-up(); } }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: EtomoStyle.field-background;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Flickable {
                viewport-height: chooser-list.preferred-height;
                chooser-list := VerticalLayout {
                    alignment: start;
                    for entry[index] in root.entries: Rectangle {
                        height: 18px;
                        background: root.selected[index] ? #c0c0ff : transparent;
                        Text { x: 4px; text: entry; vertical-alignment: center; color: EtomoStyle.text; }
                        entry-area := TouchArea {
                            property <bool> pressed-control: false;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down {
                                    self.pressed-control = event.modifiers.control;
                                }
                            }
                            clicked => { EtomoBridge.chooser-entry-clicked(index, entry-area.pressed-control); }
                            double-clicked => { EtomoBridge.chooser-entry-entered(index); }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            Text { text: "File Name:"; vertical-alignment: center; }
            Rectangle {
                height: EtomoStyle.field-height;
                background: EtomoStyle.field-background;
                border-width: 1px;
                border-color: EtomoStyle.border;
                Text { x: 3px; text: root.file-name; vertical-alignment: center; overflow: elide; }
            }
        }
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            Text { text: "Files of Type:"; vertical-alignment: center; }
            filter-box := Rectangle {
                height: EtomoStyle.field-height;
                background: EtomoStyle.field-background;
                border-width: 1px;
                border-color: EtomoStyle.border;
                Text {
                    x: 3px;
                    text: root.filters.length > root.current-filter ? root.filters[root.current-filter] : "";
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea { clicked => { filter-popup.show(); } }
                filter-popup := PopupWindow {
                    x: 0;
                    y: - root.filters.length * EtomoStyle.field-height;
                    width: filter-box.width;
                    Rectangle {
                        background: EtomoStyle.field-background;
                        border-width: 1px;
                        border-color: EtomoStyle.border;
                        VerticalLayout {
                            for filter[index] in root.filters: Rectangle {
                                height: EtomoStyle.field-height;
                                background: filter-item.has-hover ? EtomoStyle.panel : transparent;
                                Text { x: 3px; text: filter; vertical-alignment: center; }
                                filter-item := TouchArea { clicked => { EtomoBridge.chooser-filter-chosen(index); } }
                            }
                        }
                    }
                }
            }
        }
    }
}

// `JLabel` added with `Component.CENTER_ALIGNMENT`.
export component CenteredLabel inherits Text {
    horizontal-alignment: center;
    color: EtomoStyle.text;
    font-size: EtomoStyle.font-size-pt * 1px;
}

// `TextField` (`TextField.java`): an entry box with no label of its own; the
// wording comes from the check box or radio button next to it.
// `label`: the Java `reference` the field is named from ("tf." + it); not
// drawn.
export component TextField inherits BridgedTextBox {
    kind: "tf";
    // A `JTextField`'s maximum width is unbounded: it keeps this preferred
    // width only where its row does not stretch it.
    preferred-width: root.shown-visible ? 70px : 0px;
}

// `Spinner` (`Spinner.java`) built with `Spinner.getInstance(...)`: the string
// passed is an internal name only, so no label is drawn.
// `label`: the text the Java names the spinner from ("sp." + it); not drawn.
export component Spinner inherits HorizontalLayout {
    in property <string> label;
    in property <string> text: "1";
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("sp", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        BridgedTextBox {
            width: 50px;
            kind: "sp";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        Rectangle {
            width: 14px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            VerticalLayout {
                Text {
                    text: "^";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.label, true); } }
                }
                Text {
                    text: "v";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.label, false); } }
                }
            }
        }
    }
}

// `FileTextField` (`FileTextField.java`) and `ButtonControlTextEfield`
// (`ButtonControlTextEfield.java`): a label, an entry box and a small
// file-chooser icon button, optionally followed by a clear button.  Swing draws
// real icons; Slint has no icon resource here, so the buttons carry the glyphs
// the icons stand for.
export component FileTextField inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> clear-button: false;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        BridgedTextBox {
            kind: "tf";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        Rectangle {
            width: 22px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text { text: "..."; horizontal-alignment: center; vertical-alignment: center; }
            BridgedButton { kind: "fbn"; label: root.label; default-enabled: root.enabled; }
        }
        if root.clear-button: Rectangle {
            width: 22px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text { text: "X"; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
