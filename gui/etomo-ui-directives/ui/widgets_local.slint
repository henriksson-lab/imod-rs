// Widgets these two dialogs need that the shared vocabulary in
// `gui/etomo-ui-common/ui/widgets.slint` does not carry.  Same convention as
// the common crate: one component per Swing widget class in
// `IMOD/Etomo/src/etomo/ui/swing`, named after that class.
//
// None of the eTomo button icons (`openSmall.png`, `closeSmall.png`,
// `openFile.png`, the red "X" of `XButtonStyleExtension`) are pointed at from
// here: the established convention in the other `gui/*` crates is a text glyph
// standing in for a vendored icon, so that is what these use too.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";

// `EtchedBorder` (`EtchedBorder.java`): a `TitledBorder` wrapped around
// `BorderFactory.createEtchedBorder(highlight, shadow)`.  Used untitled as
// well, by the plain `BorderFactory.createEtchedBorder()` calls in
// `DirectiveEditorDialog.createPanel`.
export component EtchedBorder inherits Rectangle {
    in property <string> title;
    background: EtomoStyle.panel;
    border-width: 1px;
    // Swing's etched border is a light line (248,254,255) inside a dark one
    // (121,124,136).  Slint has one border colour per rectangle, so only the
    // dark line is drawn.
    border-color: #797c88;
    VerticalLayout {
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.gap;
        // Slint has no titled border, so the title is the first row inside the
        // box instead of being drawn into its top edge.
        if root.title != "": Text {
            text: root.title;
            font-size: EtomoStyle.font-size-pt * 1px;
            color: EtomoStyle.text;
        }
        @children
    }
}

// `SingleLineButton` (`SingleLineButton.java`): `MultiLineButton` with a label
// that is never wrapped and a preferred size taken from the label's metrics.
export component SingleLineButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    height: 28px;
    background: EtomoStyle.panel;
    border-width: 2px;
    border-color: EtomoStyle.border;
    Text {
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        // `MultiLineButton` word-wraps; `SingleLineButton` does not.
        wrap: no-wrap;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        font-weight: 700;
    }
}

// `Ebutton` (`Ebutton.java`): one `JButton` whose appearance is set by a
// `ButtonStyleExtension`.  Slint has no equivalent of swapping a style object
// into a widget, so the style is a property; the values name the extension the
// Java factory installs:
//
//   "single-line" -> `getSingleLineInstance`, `SingleLineButtonStyleExtension`
//   "open-close"  -> `getOpenCloseInstance`,  `OpenCloseButtonStyleExtension`
//                    (a toggle drawn with `openSmall.png`/`closeSmall.png`)
//   "header"      -> `getHeaderInstance`,     `HeaderButtonStyleExtension`
//                    (`setContentAreaFilled(false)` plus an etched border, and
//                    the label gets ": " appended)
export component Ebutton inherits Rectangle {
    in property <string> text;
    in property <string> button-style: "single-line";
    in property <bool> enabled: true;
    // `Ebutton.setSelected`; the open/close style shows the open icon selected.
    in property <bool> selected: false;
    // `hTitle.setHorizontalAlignment(SwingConstants.RIGHT)` in
    // `DirectivesDirectiveRow.createPanel`.
    in property <bool> align-right: false;
    height: root.button-style == "header" ? EtomoStyle.field-height : 28px;
    // `HeaderButtonStyleExtension.setup` calls `setContentAreaFilled(false)`.
    background: root.button-style == "header" ? transparent : EtomoStyle.panel;
    border-width: root.button-style == "header" ? 1px : 2px;
    border-color: root.button-style == "header" ? #797c88 : EtomoStyle.border;
    HorizontalLayout {
        // `OpenCloseButtonStyleExtension.setup`: `new Insets(0, 8, 0, 8)`.
        padding-left: root.button-style == "open-close" ? 8px : 2px;
        padding-right: root.button-style == "open-close" ? 8px : 2px;
        spacing: EtomoStyle.gap;
        alignment: root.align-right ? end : center;
        if root.button-style == "open-close": Text {
            // Stands in for `openSmall.png` / `closeSmall.png`.
            text: root.selected ? "-" : "+";
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        Text {
            // `HeaderButtonStyleExtension.setup` sets the text to `label + ": "`.
            text: root.button-style == "header" && root.text != "" ? root.text + ": " : root.text;
            vertical-alignment: center;
            wrap: no-wrap;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-weight: root.button-style == "header" ? 400 : 700;
        }
    }
}

// `ToggleEbutton` (`ToggleEbutton.java`), as built by `getOverrideInstance`: a
// `FixedDim.INLINE_SQUARE_SIZE` (22x22) toggle carrying
// `XButtonStyleExtension`.  `DirectivesDirectiveRow` starts it disabled.
export component ToggleEbutton inherits Rectangle {
    in property <bool> selected: false;
    in property <bool> enabled: false;
    width: 22px;
    height: 22px;
    background: EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        // Stands in for the "X" icon of `XButtonStyleExtension`.
        text: root.selected ? "X" : "";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
}

// `CheckBoxEfield` (`CheckBoxEfield.java`): a `JCheckBox` with eTomo's naming
// and control-mediator plumbing.  Appearance is a plain check box.
export component CheckBoxEfield inherits HorizontalLayout {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    spacing: EtomoStyle.gap;
    alignment: start;
    Rectangle {
        width: 13px;
        height: 13px;
        y: (parent.height - 13px) / 2;
        background: EtomoStyle.field-background;
        border-width: 1px;
        border-color: EtomoStyle.border;
        if root.checked: Text { text: "x"; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text {
        text: root.text;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
}

// `TextField` (`TextField.java`): an entry box with no label of its own.
export component TextField inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    height: EtomoStyle.field-height;
    background: root.enabled ? EtomoStyle.field-background : EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        x: 3px;
        text: root.text;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
}

// `ComboBox` (`ComboBox.java`), as built by `getUnlabeledInstance` and
// `getUnlabeledEmptyChoiceInstance`: a drop-down with no label of its own.  The
// popup and the item list are behaviour, so only the closed box is drawn.
export component ComboBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    height: EtomoStyle.field-height;
    background: root.enabled ? EtomoStyle.field-background : EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    HorizontalLayout {
        padding-left: 3px;
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        Rectangle {
            width: 16px;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text { text: "v"; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// `SimpleButton` (`SimpleButton.java`) carrying `ScaledImage.OPEN_FILE`, sized
// to `UIUtilities.getScaledFolderButtonDimension()` by
// `DirectivePanel.createPanel`.  The icon is not pointed at; the glyph stands
// in for it.
export component SimpleButton inherits Rectangle {
    in property <bool> enabled: true;
    width: 22px;
    height: 22px;
    background: EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        text: "[]";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
}

// `TextEfield` (`TextEfield.java`), as built by `getOverrideInstance`: the
// extensible text field used for a directive value.  It is unlabelled in the
// table (the label lives in the row's `hTitle` header button).
export component TextEfield inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // `setColumns()` sizes the field from the directive's value type.
    in property <length> field-width: 120px;
    width: root.field-width;
    height: EtomoStyle.field-height;
    background: root.enabled ? EtomoStyle.field-background : EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        x: 3px;
        text: root.text;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
}

// `ComboBoxEfield` (`ComboBoxEfield.java`), as built by `getOverrideInstance`:
// the extensible drop-down used for a choice-list directive value.
export component ComboBoxEfield inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    width: 120px;
    height: EtomoStyle.field-height;
    background: root.enabled ? EtomoStyle.field-background : EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    HorizontalLayout {
        padding-left: 3px;
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        Rectangle {
            width: 16px;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text { text: "v"; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// `BooleanComboBoxEfield` (`BooleanComboBoxEfield.java`): a `ComboBoxEfield`
// whose items are the empty choice at index 0 then
// `SharedStrings.TRUE_STRING` ("Yes") and `SharedStrings.FALSE_STRING` ("No").
// Nothing selects an item at construction, so the empty choice shows.
export component BooleanComboBoxEfield inherits ComboBoxEfield {
    text: "";
}

// `ButtonControlTextEfield` (`ButtonControlTextEfield.java`), as built by
// `getFileOverrideInstance`: the entry box plus its file-chooser `Ebutton`.
export component ButtonControlTextEfield inherits HorizontalLayout {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> field-width: 120px;
    spacing: 0px;
    TextField {
        width: root.field-width;
        text: root.text;
        enabled: root.enabled;
    }
    // `Ebutton.getSelectFileInstance` with `FileOpenButtonStyleExtension`; the
    // `openFile.png` icon is not pointed at, so the glyph stands in for it.
    Rectangle {
        width: 22px;
        height: 22px;
        background: EtomoStyle.panel;
        border-width: 1px;
        border-color: EtomoStyle.border;
        Text { text: "[]"; horizontal-alignment: center; vertical-alignment: center; }
    }
}
