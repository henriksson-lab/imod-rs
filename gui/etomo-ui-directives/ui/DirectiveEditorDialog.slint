// Mirrors `IMOD/Etomo/src/etomo/ui/swing/DirectiveEditorDialog.java`.
//
// `pnlRoot` is a Y-axis box of three panels, in this order: the Source panel,
// the Control Panel, and the section columns (`createPanel`, lines 181-183).
// The section panels themselves are `DirectiveSectionPanel.java`, translated in
// `DirectiveSectionPanel.slint`.
//
// Wired (`slint_bridge`): the fixed widgets are bridged by their Java labels;
// the unnamed include/exclude check boxes (`new CheckBox()`) by their action
// command, the file type's label (kind "acb", "#1" include, "#2" exclude); the
// three section columns are models read from the translated component tree,
// since the sections and directives come from `directives.csv` at run time.

import {
    EtomoStyle, EtomoBridge, PanelHeader, LabeledTextField, CheckBox, MultiLineButton,
    BridgedToggle,
} from "../../etomo-ui-common/ui/widgets.slint";
import { EtchedBorder } from "widgets_local.slint";
import {
    DirectiveSectionPanel, DirectiveSectionPanelShowCheckBox, DirectiveSectionData,
} from "DirectiveSectionPanel.slint";

// One of `cbInclude[i]` / `cbExclude[i]`: a `new CheckBox()` with no text and
// no name, told apart by its action command (`DirectiveFileType.getLabel(i)`).
component ActionCommandCheckBox inherits Rectangle {
    in property <string> label;
    width: 13px;
    height: 13px;
    background: EtomoStyle.field-background;
    border-width: 1px;
    border-color: toggle.shown-enabled ? EtomoStyle.border : EtomoStyle.disabled-text;
    toggle := BridgedToggle {
        kind: "acb";
        label: root.label;
        default-checked: false;
        default-enabled: false;
    }
    if toggle.checked: Text {
        text: "x";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: toggle.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
}

// One section column (`pnlSectionColumns[i]`): the sections' show check boxes,
// padding, then the section panels.
component SectionColumn inherits VerticalLayout {
    in property <[DirectiveSectionData]> sections;
    // `int extraRow = remainder-- > 0 ? 1 : 0` decides the padding between a
    // column's check boxes and its section panels: 20px with no extra row,
    // 5px with one (lines 283-288).
    in property <bool> extra-row;
    spacing: 0px;
    alignment: start;
    for section in root.sections: HorizontalLayout {
        DirectiveSectionPanelShowCheckBox {
            text: section.title;
            occurrence: section.show-occurrence;
        }
        Rectangle { }
    }
    Rectangle { height: root.extra-row ? 5px : 20px; }
    for section in root.sections: DirectiveSectionPanel {
        data: section;
    }
}

export component DirectiveEditorDialog inherits Rectangle {
    // The three columns of `DirectiveSectionPanel`s, as `createPanel` dealt
    // them (`nSections / 3` rows per column, the remainder one extra row at a
    // time to the leftmost columns), with each section's showing rows.
    in property <[DirectiveSectionData]> column-1-sections;
    in property <[DirectiveSectionData]> column-2-sections;
    in property <[DirectiveSectionData]> column-3-sections;
    in property <bool> column-1-extra-row: false;
    in property <bool> column-2-extra-row: false;
    in property <bool> column-3-extra-row: false;

    // `cbInclude[i].setActionCommand(DirectiveFileType.getLabel(i))`; index 0
    // (`BATCH_DEFAULTS`) has a null label, so its two check boxes carry no
    // action command and are found as the first two with an empty one.
    property <[string]> file-type-labels: ["", "Scope Template", "System Template", "User Template", "Batch Directive File"];
    // `lInclude[i] = new JLabel(DirectiveFileType.toString(i))`, null (no
    // text) for index 0.
    property <[string]> include-labels: ["", "Scope", "System", "User", "Batch"];
    // `pnlSourceBody` / `pnlControlBody` visibility (`expand` hides them when the
    // `phSource` / `phControl` open/close button closes): whether a widget of
    // the body is showing (the bridge answers the default for a widget that is
    // not).
    property <bool> source-open: EtomoBridge.wired
        ? EtomoBridge.text-value("tf", "Dataset: ", "\u{1}", EtomoBridge.generation) != "\u{1}"
        : true;
    property <bool> control-open: EtomoBridge.wired
        ? EtomoBridge.text-value("cb", "Show unchanged", "\u{1}", EtomoBridge.generation) != "\u{1}"
        : true;

    background: EtomoStyle.background;
    VerticalLayout {
        padding: EtomoStyle.inset;
        spacing: 0px;
        alignment: start;

        // ---- pnlSource --------------------------------------------------
        // `pnlSource.setBorder(BorderFactory.createEtchedBorder())`: untitled.
        EtchedBorder {
            VerticalLayout {
                spacing: 0px;
                ph-body-23 := PanelHeader { title: "Source"; }
                // The header's body: drawn while it is open (`PanelHeader`, `expand`).
                if ph-body-23.shown-open: VerticalLayout {
                    spacing: 0px;
                    // `pnlSourceBody`; the three fields are `setEditable(false)`.
                    if root.source-open: VerticalLayout {
                        spacing: 0px;
                        LabeledTextField { label: "Dataset: "; }
                        LabeledTextField { label: "Dataset saved at: "; }
                        LabeledTextField { label: "File saved at: "; }
                    }
                }
            }
        }

        // ---- pnlControl -------------------------------------------------
        // `pnlControl.setBorder(BorderFactory.createEtchedBorder())`: untitled.
        EtchedBorder {
            VerticalLayout {
                spacing: 0px;
                ph-body-24 := PanelHeader { title: "Control Panel"; }
                // The header's body: drawn while it is open (`PanelHeader`, `expand`).
                if ph-body-24.shown-open: VerticalLayout {
                    spacing: 0px;
                    // `pnlControlBody`, an X-axis box:
                    // pnlIncludeSettings, glue, pnlShow, glue, pnlButtons.
                    if root.control-open: HorizontalLayout {
                        spacing: 0px;

                        // `pnlIncludeSettings`
                        EtchedBorder {
                            title: "Include Based on Directives in Files";
                            // `pnlIncludeCheckboxes`, a `GridLayout(0, 3)`.
                            GridLayout {
                                spacing: EtomoStyle.gap;
                                Row {
                                    Text { text: "Include"; color: EtomoStyle.text; }
                                    Text { text: "Exclude"; color: EtomoStyle.text; }
                                    Text { text: "File"; color: EtomoStyle.text; }
                                }
                                for label[i] in root.file-type-labels: Row {
                                    ActionCommandCheckBox { label: label + "#1"; }
                                    ActionCommandCheckBox { label: label + "#2"; }
                                    Text {
                                        text: root.include-labels[i];
                                        vertical-alignment: center;
                                        // `lInclude[i].setEnabled(false)` with its
                                        // check boxes, when the file does not exist.
                                        color: (EtomoBridge.wired
                                            ? EtomoBridge.enabled-value("acb", label + "#1", false, EtomoBridge.generation)
                                            : false) ? EtomoStyle.text : EtomoStyle.disabled-text;
                                    }
                                }
                            }
                        }

                        // `Box.createHorizontalGlue()`
                        Rectangle { }

                        // `pnlShow`, a Y-axis box.
                        VerticalLayout {
                            spacing: 0px;
                            alignment: start;
                            // `pnlShowCheckboxes`
                            EtchedBorder {
                                title: "Show Directives";
                                VerticalLayout {
                                    spacing: 0px;
                                    CheckBox { text: "Show unchanged"; }
                                    CheckBox { text: "Show hidden"; }
                                    // `Box.createRigidArea(FixedDim.x0_y10)`
                                    Rectangle { height: 10px; }
                                    CheckBox { text: "Show only included"; }
                                    // `Box.createRigidArea(FixedDim.x0_y2)`
                                    Rectangle { height: 2px; }
                                }
                            }
                            Rectangle { height: 2px; }
                            // `btnCloseAll`, a `SingleLineButton`.
                            MultiLineButton { text: "Close All Sections"; width: 150px; }
                            Rectangle { height: 2px; }
                        }

                        // `Box.createHorizontalGlue()`
                        Rectangle { }

                        // `pnlButtons`, a Y-axis box with glue above, between and
                        // below the two buttons.
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle { }
                            MultiLineButton { text: "Save"; width: 120px; }
                            Rectangle { }
                            MultiLineButton { text: "Cancel"; width: 120px; }
                            Rectangle { }
                        }
                    }
                }
            }
        }

        // ---- pnlSections ------------------------------------------------
        // An X-axis box of three columns separated by
        // `rigid 5 / JSeparator(VERTICAL) / rigid 5`.
        HorizontalLayout {
            spacing: 0px;
            alignment: start;
            SectionColumn { sections: root.column-1-sections; extra-row: root.column-1-extra-row; }
            Rectangle { width: 5px; }
            Rectangle { width: 1px; background: EtomoStyle.border; }
            Rectangle { width: 5px; }
            SectionColumn { sections: root.column-2-sections; extra-row: root.column-2-extra-row; }
            Rectangle { width: 5px; }
            Rectangle { width: 1px; background: EtomoStyle.border; }
            Rectangle { width: 5px; }
            // The last column adds no separator after it.
            SectionColumn { sections: root.column-3-sections; extra-row: root.column-3-extra-row; }
        }
        // `createPanel` also builds a `JScrollPane` around `pnlRoot`
        // (line 118) and never adds it to anything; the "Problems Building
        // Editor" message dialog is a popup.
    }
}

export component DirectiveEditorDialogWindow inherits Window {
    title: "eTomo Directive Editor";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: EtomoStyle.background;
    DirectiveEditorDialog { }
}
