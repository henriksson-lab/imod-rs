// Mirrors `IMOD/Etomo/src/etomo/ui/swing/DirectivePanel.java`.
//
// One row of a `DirectiveSectionPanel`: the include check box, then the value
// widget that matches the directive's value type, then horizontal glue.  Which
// value widget exists is decided in the constructor
// (`DirectivePanel.java:71-105`): a boolean or choice-list directive gets
// `cbValue` (a `ComboBox`, items "Yes"/"No" or the choice list's descriptions)
// and no text field; anything else gets `tfValue` (a `TextField`), plus
// `sbFileValue` (a `SimpleButton` carrying `ScaledImage.OPEN_FILE`) when the
// value type is FILE.
//
// Wired: the rows are the showing `DirectivePanel`s of the translated
// component tree (`slint_bridge::directive_editor_columns`), and every widget
// is bridged by the label the Java gives it - `cbInclude` by its text
// (" -  <title>: "), `cbValue` ("cbb") and `tfValue` ("tf") by the directive
// title, and the file button as the button beside `tfValue` ("fbn") - with
// "#N" when several showing widgets carry the same name.

import { EtomoStyle, CheckBox, BridgedComboBox, BridgedTextBox, BridgedButton } from "../../etomo-ui-common/ui/widgets.slint";

// One showing directive row, as `DirectiveSectionPanel.createPanel` built it
// from the `DirectiveMap`.  `value-kind` says which branch of the constructor
// built the panel: "combo" (`cbValue`), "text" (`tfValue`), "file" (`tfValue`
// plus `sbFileValue`).
export struct DirectivePanelData {
    // `cbInclude`'s text, " -  " + title + ": ".
    include-text: string,
    // "#N" for `cbInclude` when several showing check boxes share its name.
    include-occurrence: string,
    value-kind: string,
    // The value widget's bridge label: the directive title, plus "#N".
    value-label: string,
}

export component DirectivePanel inherits HorizontalLayout {
    in property <DirectivePanelData> data;
    in property <length> value-width: 160px;

    spacing: EtomoStyle.gap;
    alignment: start;

    // `cbInclude = new CheckBox(" -  " + title + ": ")` (`DirectivePanel.java:66`).
    CheckBox {
        text: root.data.include-text;
        occurrence: root.data.include-occurrence;
    }
    // `enableValue()` enables the value widget only while the include check
    // box is both selected and enabled; the bridge reads that state.
    if root.data.value-kind == "combo": BridgedComboBox {
        width: root.value-width;
        kind: "cbb";
        label: root.data.value-label;
    }
    if root.data.value-kind != "combo": BridgedTextBox {
        width: root.value-width;
        kind: "tf";
        label: root.data.value-label;
    }
    if root.data.value-kind == "file": Rectangle {
        // `sbFileValue`, `UIUtilities.getScaledFolderButtonDimension()`; the
        // `openFile` icon is drawn as a text glyph.
        width: 24px;
        height: EtomoStyle.field-height;
        background: EtomoStyle.panel;
        border-width: 1px;
        border-color: EtomoStyle.border;
        file-button := BridgedButton {
            kind: "fbn";
            label: root.data.value-label;
        }
        Text {
            text: "...";
            horizontal-alignment: center;
            vertical-alignment: center;
            color: file-button.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
    }
}

export component DirectivePanelWindow inherits Window {
    title: "eTomo Directive";
    preferred-width: 560px;
    preferred-height: 60px;
    background: EtomoStyle.background;
    VerticalLayout {
        padding: EtomoStyle.inset;
        alignment: start;
        DirectivePanel {
            data: { include-text: " -  Directive: ", value-kind: "text", value-label: "Directive" };
        }
    }
}
