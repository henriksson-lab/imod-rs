// Mirrors `IMOD/Etomo/src/etomo/ui/swing/JoinDialog.java`, together with the
// panels it embeds:
//   `SectionTablePanel.java`   - the "Section Table" on the Setup/Align/Join/Rejoin tabs
//   `BoundaryTable.java`       - the "Boundary Table" on the Model/Rejoin tabs
//   `AutoAlignmentPanel.java`  - the Align tab's "Auto Alignment Parameters"
//   `TransformChooserPanel.java`, `BinnedXY3dmodButton.java`, `CheckBoxSpinner.java`
//
// Wired through `EtomoBridge` (`ui/swing/slint_bridge.rs`): every widget is
// identified by the label the Java gives it, and the two tables are
// `BridgedTable`s read from the translated Swing tables (their rows, header
// cells and field cells come from the component tree, so they grow as
// sections are added).  Unwired (the standalone preview), the widgets show
// the Java's static defaults and the tables are empty.
//
// Swing shows one tab body at a time: `changeTab` removes the components from
// the old tab's panel and adds them to the new one.  Here the selected tab
// (`BridgedTabbedPane.shown-current`, read from the Swing `TabbedPane`)
// chooses the body that is drawn.

import { EtomoStyle, EtomoBridge, BeveledBorder, LabeledTextField, LabeledSpinner, CheckBox,
         RadioButton, MultiLineButton, SpacedPanel, BridgedTextBox, BridgedButton,
         BridgedTable, BridgedTabbedPane }
    from "../../etomo-ui-common/ui/widgets.slint";
import { PlainLabel } from "EtomoTables.slint";

// `FileTextField` (`FileTextField.java`): label, entry box and the folder
// button that opens a `JFileChooser` (bridged as "fbn", the button beside the
// field labelled `label`).
component JoinFileTextField inherits HorizontalLayout {
    in property <string> label;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        BridgedTextBox { kind: "tf"; label: root.label; width: 250px; }
        Rectangle {
            width: 26px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text { text: "..."; horizontal-alignment: center; vertical-alignment: center; }
            BridgedButton { kind: "fbn"; label: root.label; }
        }
    }
}

// `CheckBoxSpinner` (`CheckBoxSpinner.java`): a check box and a spinner, both
// named from the same text.
component JoinCheckBoxSpinner inherits HorizontalLayout {
    in property <string> text;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("sp", root.text, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        CheckBox { text: root.text; }
        BridgedTextBox { kind: "sp"; label: root.text; width: 60px; text: "1"; }
        VerticalLayout {
            Rectangle {
                width: 14px; height: EtomoStyle.field-height / 2;
                background: EtomoStyle.panel; border-width: 1px; border-color: EtomoStyle.border;
                Text { text: "^"; font-size: 8px; }
                TouchArea { clicked => { EtomoBridge.toggled("sp", root.text, true); } }
            }
            Rectangle {
                width: 14px; height: EtomoStyle.field-height / 2;
                background: EtomoStyle.panel; border-width: 1px; border-color: EtomoStyle.border;
                Text { text: "v"; font-size: 8px; }
                TouchArea { clicked => { EtomoBridge.toggled("sp", root.text, false); } }
            }
        }
    }
}

// `BinnedXY3dmodButton` (`BinnedXY3dmodButton.java:61-95`): the
// "Open binned by " spinner with " in X and Y" above the 3dmod button.  Every
// instance names its spinner the same, so `spinner-occurrence` says which
// showing one this is ("#N").
component JoinBinnedXY3dmodButton inherits BeveledBorder {
    in property <string> text;
    in property <string> occurrence;
    in property <string> spinner-occurrence;
    title: "";
    HorizontalLayout {
        alignment: center;
        spacing: EtomoStyle.gap;
        LabeledSpinner { label: "Open binned by "; occurrence: root.spinner-occurrence; text: "1"; }
        PlainLabel { text: " in X and Y"; }
    }
    MultiLineButton { text: root.text; occurrence: root.occurrence; }
}

// `SectionTablePanel` (`SectionTablePanel.java`): the "Section Table" border
// with the table (`pnlTable`) and, except on the Align tab, the button strip
// chosen by the tab (`addButtonsPanelComponents`, :415-425).
component SectionTablePanel inherits BeveledBorder {
    in property <int> tab;
    title: "Section Table";
    BridgedTable { table: "Section Table"; }
    if root.tab != 1: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        if root.tab == 0: VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Move Section Up"; width: 140px; }
            MultiLineButton { text: "Add Section"; width: 140px; }
        }
        if root.tab == 0: VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Move Section Down"; width: 140px; }
            MultiLineButton { text: "Delete Section"; width: 140px; }
        }
        JoinBinnedXY3dmodButton { text: "Open in 3dmod"; occurrence: "#1"; spinner-occurrence: "#1"; }
        if root.tab == 0: VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Get Angles from Slicer"; width: 160px; }
            MultiLineButton { text: "Invert Table"; width: 160px; }
        }
    }
}

// `BoundaryTable` (`BoundaryTable.java`): the "Boundary Table" border.
component BoundaryTablePanel inherits BeveledBorder {
    title: "Boundary Table";
    BridgedTable { table: "Boundary Table"; }
}

// `TransformChooserPanel` (`TransformChooserPanel.java:87-109`).  The join
// instances have no "Search For:" check box, so the Java adds a plain JLabel
// with that text; `allow-translation` selects between `getJoinModelInstance`
// (true) and `getJoinAlignInstance` (false).
component TransformChooserPanel inherits HorizontalLayout {
    in property <bool> allow-translation: false;
    alignment: start;
    VerticalLayout {
        PlainLabel { text: "Search For:"; }
        RadioButton { text: "Full linear transformation"; selected: true; }
        RadioButton { text: "Rotation/translation/magnification"; }
        RadioButton { text: "Rotation/translation"; }
        if root.allow-translation: RadioButton { text: "Translation"; }
    }
}

// `JoinDialog.createSetupPanel` / `addSetupPanelComponents`
// (JoinDialog.java:571-628).
export component JoinSetupTab inherits SpacedPanel {
    JoinFileTextField { label: "Working directory: "; }
    LabeledTextField { label: "Root name for output file: "; text: ""; }
    SectionTablePanel { tab: 0; }
    // pnlMidasLimit: ltfMidasLimit then the lblMidasLimit JLabel.
    HorizontalLayout {
        LabeledTextField { label: "Squeeze samples to "; text: ""; }
        PlainLabel { text: "pixels if bigger."; horizontal-stretch: 0; }
    }
    HorizontalLayout {
        LabeledSpinner { label: "Reference section for density matching: "; text: "1"; }
    }
    Rectangle { height: 5px; }
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        MultiLineButton { text: "Change Setup"; }
        MultiLineButton { text: "Revert to Last Setup"; }
    }
    HorizontalLayout {
        alignment: center;
        MultiLineButton { text: "Make Samples"; width: 200px; }
    }
}

// `JoinDialog.createAlignPanel` / `addAlignPanelComponents`
// (JoinDialog.java:630-651) plus `AutoAlignmentPanel.createPanel`
// (AutoAlignmentPanel.java:126-237) in its join configuration, where the
// serial-sections-only fields are hidden and the Sobel-filter and warping
// panels are null.
export component JoinAlignTab inherits SpacedPanel {
    SectionTablePanel { tab: 1; }
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        MultiLineButton { text: "Open Sample in 3dmod"; }
        MultiLineButton { text: "Open Sample Averages in 3dmod"; }
    }
    BeveledBorder {
        title: "Auto Alignment Parameters";
        LabeledTextField { label: "Sigma for low-frequency filter: "; text: "0.0"; }
        LabeledTextField { label: "Cutoff for high-frequency filter: "; text: "0.35"; }
        LabeledTextField { label: "Sigma for high-frequency filter: "; text: "0.05"; }
        TransformChooserPanel { allow-translation: false; }
    }
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Initial Auto Alignment"; }
            MultiLineButton { text: "Midas"; }
            MultiLineButton { text: "Refine with Auto Alignment"; }
        }
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Revert Auto Alignment to Midas"; }
            MultiLineButton { text: "Revert to No Transforms"; }
        }
    }
}

// `JoinDialog.createJoinPanel` / `createFinishJoinPanel` / `createTrialJoinPanel`
// (JoinDialog.java:812-901).  pnlJoinTab is an X_AXIS SpacedPanel: the section
// table sits beside the finish-join column.
export component JoinJoinTab inherits HorizontalLayout {
    spacing: EtomoStyle.gap;
    padding: EtomoStyle.inset;
    alignment: start;
    SectionTablePanel { tab: 2; }
    // pnlFinishJoin: BorderFactory.createEtchedBorder(), i.e. untitled.
    BeveledBorder {
        title: "";
        JoinCheckBoxSpinner { text: "Reference section for alignment: "; }
        MultiLineButton { text: "Get Max Size and Shift"; }
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            LabeledTextField { label: "Size in X: "; text: ""; }
            LabeledTextField { label: "Y: "; occurrence: "#1"; text: ""; }
        }
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            LabeledTextField { label: "Shift in X: "; text: ""; }
            LabeledTextField { label: "Y: "; occurrence: "#2"; text: ""; }
        }
        CheckBox { text: "Do local linear fits"; }
        BeveledBorder {
            title: "Trial Join";
            HorizontalLayout {
                spacing: EtomoStyle.gap;
                LabeledSpinner { label: "Use every "; text: "10"; }
                PlainLabel { text: "slices"; }
            }
            LabeledSpinner { label: "Binning in X and Y: "; text: "1"; }
            MultiLineButton { text: "Trial Join"; }
            JoinBinnedXY3dmodButton { text: "Open Trial in 3dmod"; spinner-occurrence: "#2"; }
            MultiLineButton { text: "Get Subarea Size And Shift"; }
        }
        MultiLineButton { text: "Finish Join"; }
        JoinBinnedXY3dmodButton { text: "Open in 3dmod"; occurrence: "#2"; spinner-occurrence: "#3"; }
        CheckBox { text: "Refine with trial"; }
        MultiLineButton { text: "Refine Join"; }
    }
}

// `JoinDialog.createModelPanel` / `addModelPanelComponents`
// (JoinDialog.java:653-733).
export component JoinModelTab inherits SpacedPanel {
    MultiLineButton { text: "Make Refining Model"; }
    BoundaryTablePanel { }
    BeveledBorder {
        title: "Transformations";
        TransformChooserPanel { allow-translation: true; }
        LabeledTextField { label: "Boundaries to analyze: "; text: ""; }
        LabeledTextField { label: "Objects to include: "; text: ""; }
        // pnlGapStartEndInc.  The three fields are disabled until cbGap is
        // selected (updateDisplay, JoinDialog.java:361-368).
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            CheckBox { text: "Try gaps: "; }
            LabeledTextField { label: "Start: "; text: ""; enabled: false; }
            LabeledTextField { label: "End: "; text: ""; enabled: false; }
            LabeledTextField { label: "Increment: "; text: ""; enabled: false; }
        }
        // pnlPointsToFit.
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            PlainLabel { text: "Points to fit: "; }
            LabeledTextField { label: "Min: "; text: ""; }
            LabeledTextField { label: "Max: "; text: ""; }
        }
        HorizontalLayout {
            alignment: center;
            MultiLineButton { text: "Find Transformations"; width: 200px; }
        }
        Rectangle { height: 5px; }
        HorizontalLayout {
            alignment: center;
            MultiLineButton { text: "Transform & View Model"; width: 200px; }
        }
    }
}

// `JoinDialog.createRejoinPanel` / `addRejoinPanelComponents`
// (JoinDialog.java:735-810).
export component JoinRejoinTab inherits VerticalLayout {
    spacing: EtomoStyle.row-gap;
    padding: EtomoStyle.inset;
    // pnlTables: the section table beside the boundary table.
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        SectionTablePanel { tab: 4; }
        BoundaryTablePanel { }
    }
    BeveledBorder {
        title: "Trial Rejoin";
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            // pnlTrialRejoinButton: BorderFactory.createEtchedBorder(), untitled.
            BeveledBorder {
                title: "";
                HorizontalLayout {
                    spacing: EtomoStyle.gap;
                    LabeledSpinner { label: "Use every "; text: "10"; }
                    PlainLabel { text: "slices"; }
                }
                LabeledSpinner { label: "Binning in X and Y: "; text: "1"; }
                MultiLineButton { text: "Trial Rejoin"; }
            }
            JoinBinnedXY3dmodButton { text: "Open Trial Rejoin in 3dmod"; spinner-occurrence: "#2"; }
        }
    }
    BeveledBorder {
        title: "Final Rejoin";
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            MultiLineButton { text: "Rejoin"; }
            JoinBinnedXY3dmodButton { text: "Open Rejoin in 3dmod"; spinner-occurrence: "#3"; }
        }
    }
    BeveledBorder {
        title: "Transform Model";
        JoinFileTextField { label: "Model file: "; }
        LabeledTextField { label: "Output file: "; text: ""; }
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            MultiLineButton { text: "Transform Model"; }
            JoinBinnedXY3dmodButton { text: "Open Rejoin with Transformed Model"; spinner-occurrence: "#4"; }
        }
    }
}

// `JoinDialog.createTabPane` (JoinDialog.java:318-334): the five tabs, in
// order; the Model and Rejoin tabs are disabled until a refine starts
// (`updateDisplay`), which the bridged tab strip shows.
export component JoinDialog inherits Rectangle {
    background: EtomoStyle.background;
    VerticalLayout {
        alignment: start;
        tabs := BridgedTabbedPane {
            tabs: ["Setup", "Align", "Join", "Model", "Rejoin"];
            current: 0;
        }
        if tabs.shown-current == 0: JoinSetupTab { }
        if tabs.shown-current == 1: JoinAlignTab { }
        if tabs.shown-current == 2: JoinJoinTab { }
        if tabs.shown-current == 3: JoinModelTab { }
        if tabs.shown-current == 4: JoinRejoinTab { }
    }
}

export component JoinDialogWindow inherits Window {
    title: "Join";
    background: EtomoStyle.background;
    preferred-width: 1100px;
    preferred-height: 900px;
    JoinDialog { }
}
