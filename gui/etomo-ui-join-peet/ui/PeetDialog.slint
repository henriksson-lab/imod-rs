// Mirrors `IMOD/Etomo/src/etomo/ui/swing/PeetDialog.java`, together with the
// panels it embeds:
//   `VolumeTable.java`, `IterationTable.java`      - the two tables
//   `FixPathsPanel.java`                           - "Fix File Paths"
//   `ReferencePanel.java`                          - "Reference"
//   `MissingWedgeCompensationPanel.java`           - "Volume Size" / "Missing Wedge Compensation"
//   `MaskingPanel.java`                            - "Masking"
//   `YAxisTypePanel.java`                          - "Particle Y Axis"
//   `SphericalSamplingForThetaAndPsiPanel.java`    - "Spherical Sampling for Theta and Psi"
// Label strings come from `etomo/ui/SharedStrings.java` and
// `etomo/storage/MatlabParam.java` where the Java reads them from there.
//
// Wired through `EtomoBridge` (`ui/swing/slint_bridge.rs`): every widget is
// identified by the label the Java gives it, and the volume and iteration
// tables are `BridgedTable`s read from the translated Swing tables (their
// rows, header cells and field cells come from the component tree).
// Unwired (the standalone preview), the widgets show the static defaults
// `setDefaults` installs (PeetDialog.java:1157-1164) and the tables are empty.

import { EtomoStyle, EtomoBridge, BeveledBorder, PanelHeader, LabeledTextField, LabeledSpinner,
         CheckBox, RadioButton, MultiLineButton, SpacedPanel, BridgedTabbedPane, BridgedTable,
         BridgedTextBox }
    from "../../etomo-ui-common/ui/widgets.slint";
import { HeaderCell, FieldCell, ExpandButton, SingleLineButton, FileTextField,
         RadioTextField, ComboBox, PlainLabel }
    from "EtomoTables.slint";

// `VolumeTable.display` (VolumeTable.java:470-511): ten grid columns of
// header cells and one `VolumeRow` per volume, read from the Swing table.
component VolumeTable inherits BeveledBorder {
    title: "Volume Table";
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            BridgedTable { table: "Volume Table"; }
            // pnlBottomButtons (VolumeTable.java:377-383).
            HorizontalLayout {
                spacing: EtomoStyle.gap;
                alignment: start;
                CheckBox { text: "File names are templates"; }
                SingleLineButton { text: "Open in 3dmod"; }
                SingleLineButton { text: "Read tilt file"; }
            }
        }
        // pnlSideButtons (VolumeTable.java:364-375).
        VerticalLayout {
            spacing: 5px;
            alignment: start;
            SingleLineButton { text: "Up"; }
            SingleLineButton { text: "Down"; }
            SingleLineButton { text: "Insert"; }
            SingleLineButton { text: "Delete"; }
            SingleLineButton { text: "Dup"; }
        }
    }
}

// `IterationTable.display` (IterationTable.java:484-541): sixteen grid columns
// of header cells and one `IterationRow` per iteration, read from the Swing
// table.
component IterationTable inherits BeveledBorder {
    title: "Iteration Table";
    HorizontalLayout {
        spacing: 3px;
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            BridgedTable { table: "Iteration Table"; }
            // pnlFlgRemoveDuplicates (IterationTable.java:451-457).
            HorizontalLayout {
                spacing: 40px;
                alignment: start;
                CheckBox { text: "Remove duplicates"; }
                CheckBox { text: "Bandpass filtering"; }
                CheckBox { text: "Strict search limit checking"; }
            }
        }
        // pnlButtons (IterationTable.java:432-446).
        VerticalLayout {
            spacing: 5px;
            alignment: start;
            SingleLineButton { text: "Up"; }
            SingleLineButton { text: "Down"; }
            SingleLineButton { text: "Insert"; }
            SingleLineButton { text: "Delete"; }
            SingleLineButton { text: "Dup"; }
        }
    }
}

// `FixPathsPanel` (FixPathsPanel.java:80-105).  The Java leaves pnlRoot
// `setVisible(false)` until a file cannot be found, so it is drawn but gated
// on its construction-time visibility, like the other hidden-at-construction
// widgets in this crate.
component FixPathsPanel inherits VerticalLayout {
    ph-body-8 := PanelHeader { title: "Fix File Paths"; open: true; }
    // The header's body: drawn while it is open (`PanelHeader`, `expand`).
    if ph-body-8.shown-open: VerticalLayout {
        spacing: EtomoStyle.row-gap;
        Rectangle {
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            VerticalLayout {
                padding: EtomoStyle.inset;
                spacing: EtomoStyle.row-gap;
                // lblwarning is painted ProcessControlPanel.colorNotStarted (red).
                Text {
                    text: "Files cannot be found.  PEET may not run.";
                    color: #ff0000;
                    font-size: EtomoStyle.font-size-pt * 1px;
                }
                CheckBox { text: "Files may be in separate directories"; }
                HorizontalLayout {
                    alignment: center;
                    MultiLineButton { text: "Fix Incorrect Paths"; width: 180px; }
                }
            }
        }
    }
}

// `ReferencePanel.createPanel` (ReferencePanel.java:93-146).
component ReferencePanel inherits BeveledBorder {
    // pnlParticle adds sVolume and then ltfVolume in adjacent slots
    // (ReferencePanel.java:132-133); `msgFlgVolNamesAreTemplates`
    // (ReferencePanel.java:302-308) shows exactly one of them.  updateDisplay
    // calls it at init with the volume table's check box clear
    // (ReferencePanel.java:349), so the spinner is the visible one.
    property <bool> file-names-are-templates: EtomoBridge.wired
        ? EtomoBridge.bool-value("cb", "File names are templates", false, EtomoBridge.generation)
        : false;
    title: "Reference";
    // pnlParticle.
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        RadioTextField { label: "Particle "; selected: true; text: ""; }
        Rectangle { width: 10px; }
        // sVolume: Spinner.getLabeledInstance("In Volume: ") (ReferencePanel.java:56).
        if !root.file-names-are-templates: LabeledSpinner { label: "In Volume: "; text: "1"; }
        // ltfVolume: the LabeledTextField carrying the same "In Volume: " label
        // (ReferencePanel.java:63-64).
        if root.file-names-are-templates: LabeledTextField { label: "In Volume: "; text: ""; }
    }
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        RadioButton { text: "User supplied file: "; }
        FileTextField { label: ""; bridge-label: "User supplied file: "; field-width: 225px; text: ""; }
    }
    HorizontalLayout {
        alignment: start;
        spacing: EtomoStyle.gap;
        RadioButton { text: "Multiparticle reference with"; }
        ComboBox { label: "Multiparticle reference with"; text: "50"; }
        PlainLabel { text: "particles"; }
    }
}

// `MissingWedgeCompensationPanel.createPanel`
// (MissingWedgeCompensationPanel.java:108-170).
component MissingWedgeCompensationPanel inherits VerticalLayout {
    // createPanel hides cbTiltRange and cbFlgWedgeWeight together
    // (MissingWedgeCompensationPanel.java:110-111); both are marked deprecated,
    // replaced by cbMissingWedgeCompensation
    // (MissingWedgeCompensationPanel.java:67-75).  One property gates the pair.
    in property <bool> show-deprecated-tilt-range: false;
    spacing: EtomoStyle.row-gap;
    BeveledBorder {
        title: "Volume Size (Voxels)";
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            LabeledTextField { label: "X: "; text: ""; }
            LabeledTextField { label: "Y: "; text: ""; }
            LabeledTextField { label: "Z: "; text: ""; }
        }
    }
    BeveledBorder {
        title: "Missing Wedge Compensation";
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            CheckBox { text: "Enabled"; }
            LabeledSpinner { label: "Edge shift: "; text: "1"; }
            LabeledSpinner { label: "Weight groups: "; text: "8"; }
        }
        HorizontalLayout {
            alignment: start;
            spacing: EtomoStyle.gap;
            PlainLabel { text: "Number of Tilt Axes: "; }
            RadioButton { text: "1"; selected: true; }
            Rectangle { width: 15px; }
            RadioButton { text: "2 or more"; }
        }
        // cbTiltRange and cbFlgWedgeWeight, added to
        // pnlMissingWedgeCompensation after pnlTiltRange
        // (MissingWedgeCompensationPanel.java:150-151); labels at
        // MissingWedgeCompensationPanel.java:71 and 75.
        if root.show-deprecated-tilt-range: CheckBox { text: "Use tilt range in averaging"; }
        if root.show-deprecated-tilt-range: CheckBox { text: "Use tilt range in alignment"; }
    }
}

// `MaskingPanel.createPanel` (MaskingPanel.java:107-234).
component MaskingPanel inherits BeveledBorder {
    title: "Masking";
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        // pnlMaskType
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            RadioButton { text: "None"; selected: true; }
            RadioButton { text: "Sphere"; }
            HorizontalLayout {
                spacing: EtomoStyle.gap;
                RadioButton { text: "Cylinder"; }
                Rectangle { width: 50px; }
                LabeledTextField { label: "Height: "; text: ""; width: 125px; }
            }
            HorizontalLayout {
                spacing: EtomoStyle.gap;
                RadioButton { text: "User supplied binary file:"; }
                FileTextField { label: ""; bridge-label: "User supplied binary file:"; field-width: 190px; text: ""; }
            }
        }
        // pnlSphereCylinder
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            HorizontalLayout {
                spacing: EtomoStyle.gap;
                LabeledTextField { label: "Inner radius: "; text: ""; width: 160px; }
                Rectangle { width: 40px; }
                LabeledTextField { label: "Outer radius: "; text: ""; width: 160px; }
            }
            HorizontalLayout {
                LabeledTextField { label: "Blur mask by: "; text: ""; width: 160px; }
            }
            // pnlCylinderOrientation: BorderFactory.createEtchedBorder(), untitled.
            BeveledBorder {
                title: "";
                CheckBox { text: "Manual Cylinder Orientation"; }
                HorizontalLayout {
                    spacing: EtomoStyle.gap;
                    LabeledTextField { label: "Z Rotation: "; text: ""; width: 150px; }
                    Rectangle { width: 40px; }
                    LabeledTextField { label: "Y Rotation: "; text: ""; width: 150px; }
                }
            }
        }
    }
}

// `YAxisTypePanel.createPanel` (YAxisTypePanel.java:74-96).  The radio labels
// are the `MatlabParam.YAxisType` enum labels (MatlabParam.java:2413-2420).
component YAxisTypePanel inherits BeveledBorder {
    title: "Particle Y Axis";
    // `new RadioButton(MatlabParam.YAxisType.Y_AXIS, bgYAxisType)`: the
    // enum-taking constructor selects itself when the enum is its own default
    // (RadioButton.java:114-116), and `YAxisType.DEFAULT = Y_AXIS`
    // (MatlabParam.java:2421).  Label from SharedStrings.java:28.
    RadioButton { text: "Tomogram Y axis"; selected: true; }
    RadioButton { text: "Particle model points"; }
    RadioButton { text: "End points of contour"; }
    RadioButton { text: "User supplied csv files"; }
}

// `SphericalSamplingForThetaAndPsiPanel.createPanel`
// (SphericalSamplingForThetaAndPsiPanel.java:82-100).
component SphericalSamplingForThetaAndPsiPanel inherits BeveledBorder {
    title: "Spherical Sampling for Theta and Psi";
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        Rectangle { width: 20px; }
        RadioButton { text: "None"; selected: true; }
        Rectangle { width: 10px; }
        RadioButton { text: "Full sphere"; }
        Rectangle { width: 10px; }
        RadioButton { text: "Half sphere"; }
        Rectangle { width: 70px; }
        LabeledTextField {
            label: "Sample interval (degrees) : ";
            
            text: "";
            width: 250px;
        }
    }
}

// `PeetDialog.createSetupPanel` (PeetDialog.java:790-845).  pnlSetup carries
// BorderFactory.createEtchedBorder(), i.e. an untitled group box.
export component PeetSetupTab inherits BeveledBorder {
    title: "";
    // pnlProject
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        LabeledTextField { label: "Directory: "; text: ""; width: 320px; }
        Rectangle { width: 10px; }
        LabeledTextField { label: "Root name for output: "; text: ""; width: 400px; }
        Rectangle { width: 20px; }
    }
    // `setVisible(false)` at construction (FixPathsPanel.java:80-105); shown
    // only once a file cannot be found.
    in property <bool> show-fix-paths: false;
    if root.show-fix-paths || (EtomoBridge.wired
        && EtomoBridge.enabled-value("bn", "Fix Incorrect Paths", false, EtomoBridge.generation)):
        FixPathsPanel { }
    VolumeTable { }
    // pnlReferenceAndMissingWedgeCompensation
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        ReferencePanel { }
        MissingWedgeCompensationPanel { }
    }
    MaskingPanel { }
    // pnlInitMotlAndYAxisType
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        YAxisTypePanel { }
        Rectangle { }
        // pnlInitMotlX / pnlInitMotl.  Radio labels are the
        // `MatlabParam.InitMotlCode` labels (MatlabParam.java:2205-2217).
        BeveledBorder {
            title: "Initial Motive List";
            RadioButton { text: "Set all angles to 0"; selected: true; }
            RadioButton { text: "Align particle Y axes"; }
            RadioButton { text: "User supplied csv files"; }
            RadioButton { text: "Uniform random rotations"; }
            RadioButton { text: "Random axial (Y) rotations"; }
        }
    }
}

// `PeetDialog.createRunPanel` (PeetDialog.java:846-914).
export component PeetRunTab inherits BeveledBorder {
    title: "";
    HorizontalLayout {
        LabeledSpinner { label: "Particles per CPU (core): "; hgap: 28px; text: "20"; }
    }
    IterationTable { }
    SphericalSamplingForThetaAndPsiPanel { }
    // pnlLstThresholds
    BeveledBorder {
        title: "Number of Particles to Average";
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            Rectangle { width: 20px; }
            LabeledTextField { label: "Start: "; text: ""; width: 115px; }
            Rectangle { width: 10px; }
            LabeledTextField { label: "Incr.: "; text: ""; width: 115px; }
            Rectangle { width: 10px; }
            LabeledTextField { label: "End: "; text: ""; width: 115px; }
            Rectangle { width: 20px; }
            LabeledTextField { label: " Additional numbers: "; text: ""; width: 265px; }
        }
    }
    // pnlEqualNumber
    BeveledBorder {
        title: "Use Equal Numbers of Particles from All Tomograms";
        HorizontalLayout {
            spacing: EtomoStyle.gap;
            CheckBox { text: "For average volumes"; }
            CheckBox { text: "For new references"; }
        }
    }
    Rectangle { height: 20px; }
    // pnlButton
    HorizontalLayout {
        alignment: start;
        spacing: 30px;
        Rectangle { width: 0px; }
        SingleLineButton { text: "Run"; }
        SingleLineButton { text: "Open averages in 3dmod"; }
        SingleLineButton { text: "Open references in 3dmod"; }
        SingleLineButton { text: "Remake Averages"; }
    }
}

// `PeetDialog.createMoreOptionsPanel` (PeetDialog.java:918-1054).
export component PeetMoreOptionsTab inherits SpacedPanel {
    BeveledBorder {
        title: "Particle Selection";
        Rectangle { height: 10px; }
        HorizontalLayout {
            Rectangle { width: 5px; }
            LabeledTextField { label: "Exclude particles "; text: ""; width: 400px; }
        }
        Rectangle { height: 10px; }
        HorizontalLayout {
            Rectangle { width: 5px; }
            LabeledTextField { label: "Include particles "; text: ""; width: 400px; }
        }
        Rectangle { height: 10px; }
        HorizontalLayout {
            Rectangle { width: 5px; }
            LabeledTextField { label: "Average only members of classes "; text: ""; width: 490px; }
        }
        Rectangle { height: 10px; }
        // pnlParticleSelectionFlags: GridLayout(1, 2, 20, 0).
        HorizontalLayout {
            spacing: 20px;
            CheckBox { text: "Elevation Compensation"; }
            CheckBox { text: "Randomized particle selection"; }
        }
        Rectangle { height: 5px; }
    }
    BeveledBorder {
        title: "Alignment";
        // pnlAlignment: GridLayout(3, 3, 20, 0) filled row-major with six
        // check boxes, so it renders as two rows of three.
        GridLayout {
            spacing: 20px;
            Row {
                CheckBox { text: "Fast rotational matching"; checked: true; }
                CheckBox { text: "Masked correlation computation"; }
                CheckBox { text: "Filter reference only"; }
            }
            Row {
                CheckBox { text: "Search along particle axes"; }
                CheckBox { text: "Floating point wedge mask"; }
                CheckBox { text: "Use absolute value of cross-correlation"; checked: true; }
            }
        }
        Rectangle { height: 10px; }
        HorizontalLayout {
            Rectangle { width: 5px; }
            LabeledTextField {
                label: "Per iteration c<N> axial search order ";
                
                text: "";
                width: 520px;
            }
        }
        Rectangle { height: 10px; }
    }
    BeveledBorder {
        title: "Processing";
        // pnlProcessing: GridLayout(3, 3, 20, 0) filled row-major with six
        // components.
        GridLayout {
            spacing: 20px;
            Row {
                CheckBox { text: "Align averages to have their Y axes vertical"; }
                CheckBox { text: "Use previously extracted particles"; }
                CheckBox { text: "No reference refinement (template matching)"; }
            }
            Row {
                CheckBox { text: "Save individual aligned particles"; }
                // pnlCNSymmetricAveraging: the check box, the "=" JLabel, then
                // the spinner.
                HorizontalLayout {
                    alignment: start;
                    spacing: EtomoStyle.gap;
                    CheckBox { text: "c<N> symmetric averaging with N"; }
                    PlainLabel { text: "="; }
                    // spCNSymmetricAveraging: an unlabeled spinner named by the
                    // check box's text.
                    HorizontalLayout {
                        BridgedTextBox { kind: "sp"; label: "c<N> symmetric averaging with N"; width: 50px; text: "2"; }
                        VerticalLayout {
                            Rectangle {
                                width: 14px; height: EtomoStyle.field-height / 2;
                                background: EtomoStyle.panel; border-width: 1px; border-color: EtomoStyle.border;
                                Text { text: "^"; font-size: 8px; }
                                TouchArea { clicked => { EtomoBridge.toggled("sp", "c<N> symmetric averaging with N", true); } }
                            }
                            Rectangle {
                                width: 14px; height: EtomoStyle.field-height / 2;
                                background: EtomoStyle.panel; border-width: 1px; border-color: EtomoStyle.border;
                                Text { text: "v"; font-size: 8px; }
                                TouchArea { clicked => { EtomoBridge.toggled("sp", "c<N> symmetric averaging with N", false); } }
                            }
                        }
                    }
                }
                CheckBox { text: "Masking during c<N> averaging"; checked: true; }
            }
        }
        Rectangle { height: 10px; }
        HorizontalLayout {
            Rectangle { width: 5px; }
            LabeledTextField { label: "User commands "; text: ""; width: 520px; }
        }
        Rectangle { height: 10px; }
        HorizontalLayout {
            LabeledSpinner { label: "Debug level: "; hgap: 59px; text: "3"; }
        }
        Rectangle { height: 5px; }
    }
}

// `PeetDialog`'s root panel: `new BeveledBorder("PEET")` around the tab pane
// (PeetDialog.java:210-217).
//
// Swing shows one tab body at a time (`changeTab`, PeetDialog.java:1184-1200):
// the selected tab (`BridgedTabbedPane.shown-current`, read from the Swing
// tabbed pane) chooses the body that is drawn.
export component PeetDialog inherits BeveledBorder {
    title: "PEET";
    tabs := BridgedTabbedPane {
        tabs: ["Setup", "Run", "More Options"];
        current: 0;
    }
    if tabs.shown-current == 0: PeetSetupTab { }
    if tabs.shown-current == 1: PeetRunTab { }
    if tabs.shown-current == 2: PeetMoreOptionsTab { }
}

export component PeetDialogWindow inherits Window {
    title: "PEET";
    background: EtomoStyle.background;
    preferred-width: 1200px;
    preferred-height: 900px;
    PeetDialog { }
}
