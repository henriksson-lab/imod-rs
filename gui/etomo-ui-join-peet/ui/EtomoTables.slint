// Widgets used by JoinDialog.java, PeetDialog.java and PeetStartupDialog.java
// that the shared vocabulary in `gui/etomo-ui-common/ui/widgets.slint` does not
// carry.  Each one is named after the Swing class in
// `IMOD/Etomo/src/etomo/ui/swing` that it stands for, and is defined here
// rather than in the common crate so that crate stays untouched.

import { EtomoStyle, EtomoBridge, BridgedTextBox, BridgedButton, BridgedToggle, BridgedComboBox }
    from "../../etomo-ui-common/ui/widgets.slint";

// `HeaderCell` (`HeaderCell.java`): a table header cell.  Its background is
// `new ColorUIResource(204, 204, 204)` (HeaderCell.java:40) and the cell is an
// `AbstractButton`, so the text is centred and bevelled.
export component HeaderCell inherits Rectangle {
    in property <string> text;
    background: #cccccc;
    border-width: 1px;
    border-color: EtomoStyle.border;
    min-height: EtomoStyle.field-height;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        Text {
            text: root.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: 700;
            font-size: EtomoStyle.font-size-pt * 1px;
            color: EtomoStyle.text;
        }
    }
}

// `FieldCell` (`FieldCell.java`): an editable table body cell.
export component FieldCell inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    background: root.enabled ? EtomoStyle.field-background : EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    min-height: EtomoStyle.field-height;
    HorizontalLayout {
        padding-left: 3px;
        padding-right: 3px;
        Text {
            text: root.text;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: EtomoStyle.font-size-pt * 1px;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
    }
}

// `ExpandButton` (`ExpandButton.java`) of `Type.MORE`: the one-character
// "&gt"/"&lt" button that widens a file-name column (ExpandButton.java:423-433).
export component ExpandButton inherits Rectangle {
    in property <bool> expanded: false;
    width: 16px;
    min-height: EtomoStyle.field-height;
    background: #cccccc;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        text: root.expanded ? "<" : ">";
        horizontal-alignment: center;
        vertical-alignment: center;
        font-weight: 700;
        color: EtomoStyle.text;
    }
}

// `SingleLineButton` (`SingleLineButton.java`): the compact button eTomo uses
// for table side buttons ("Up", "Down", "Insert", "Delete", "Dup") and for the
// PEET tab's action buttons.  Unlike `MultiLineButton` it never wraps.
export component SingleLineButton inherits Rectangle {
    in property <string> text;
    in property <string> occurrence;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows; it then takes no room.
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("bn", root.text + root.occurrence, true, EtomoBridge.generation);
    height: root.shown-visible ? EtomoStyle.field-height : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 2px : 0px;
    border-color: EtomoStyle.border;
    HorizontalLayout {
        visible: root.shown-visible;
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-weight: 700;
            color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
    }
    // Wired through `EtomoBridge` by its label, as `MultiLineButton` is.
    area := BridgedButton { kind: "bn"; label: root.text + root.occurrence; default-enabled: root.enabled; }
}

// `FileTextField` / `FileTextField2` (`FileTextField.java`,
// `FileTextField2.java`): an optional label, an entry box, and the folder
// button that opens a `JFileChooser`.  `getUnlabeledPeetInstance` builds the
// same widget with an empty label, which is what `label: ""` here stands for.
export component FileTextField inherits HorizontalLayout {
    in property <string> label;
    // The name the field is found by (`getUnlabeledPeetInstance(manager, name)`
    // names an unlabeled field); defaults to the label.
    in property <string> bridge-label: root.label;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> field-width: 225px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.bridge-label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        if root.label != "": Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: field.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        field := BridgedTextBox {
            kind: "tf";
            label: root.bridge-label;
            width: root.field-width;
            text: root.text;
            enabled: root.enabled;
        }
        // The Swing button carries the folder `ImageIcon`; Slint has no icon here,
        // so the conventional file-chooser ellipsis stands in for it.  Bridged as
        // "fbn", the button beside the field.
        Rectangle {
            width: 24px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text {
                text: "...";
                horizontal-alignment: center;
                vertical-alignment: center;
                color: button.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            }
            button := BridgedButton { kind: "fbn"; label: root.bridge-label; default-enabled: root.enabled; }
        }
    }
}

// `RadioTextField` (`RadioTextField.java`): a radio button followed by the
// entry box it enables.
export component RadioTextField inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <length> field-width: 60px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("rb", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        Rectangle {
            width: 13px;
            height: 13px;
            y: (parent.height - 13px) / 2;
            border-radius: 6px;
            background: EtomoStyle.field-background;
            border-width: 1px;
            border-color: EtomoStyle.border;
            if toggle.checked: Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3px;
                background: EtomoStyle.text;
            }
            toggle := BridgedToggle {
                kind: "rb";
                label: root.label;
                radio: true;
                default-checked: root.selected;
                default-enabled: root.enabled;
            }
        }
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: toggle.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        BridgedTextBox { kind: "tf"; label: root.label; width: root.field-width; text: root.text; enabled: root.enabled; }
    }
}

// `CheckBoxSpinner` (`CheckBoxSpinner.java`): a check box whose label is
// followed by the spinner it enables.
export component CheckBoxSpinner inherits HorizontalLayout {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> value: "1";
    spacing: EtomoStyle.gap;
    alignment: start;
    Rectangle {
        width: 13px;
        height: 13px;
        y: (parent.height - 13px) / 2;
        background: EtomoStyle.field-background;
        border-width: 1px;
        border-color: EtomoStyle.border;
        if root.checked: Text { text: "x"; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text {
        text: root.text;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
    Rectangle {
        width: 50px;
        height: EtomoStyle.field-height;
        background: EtomoStyle.field-background;
        border-width: 1px;
        border-color: EtomoStyle.border;
        Text { x: 3px; text: root.value; vertical-alignment: center; }
    }
    Rectangle {
        width: 14px;
        height: EtomoStyle.field-height;
        background: EtomoStyle.panel;
        border-width: 1px;
        border-color: EtomoStyle.border;
        VerticalLayout {
            Text { text: "^"; horizontal-alignment: center; }
            Text { text: "v"; horizontal-alignment: center; }
        }
    }
}

// `ComboBox` (`ComboBox.java`): the unlabeled drop-down used for the PEET
// multiparticle reference particle count.
export component ComboBox inherits BridgedComboBox {
    // `kind: "cbb"`; `label` is the name the Java gives the combo box.
    width: 80px;
}

// `JLabel` used as a plain caption inside a laid-out row.
export component PlainLabel inherits Text {
    vertical-alignment: center;
    font-size: EtomoStyle.font-size-pt * 1px;
    color: EtomoStyle.text;
}

// `BinnedXY3dmodButton` (`BinnedXY3dmodButton.java:61-95`): an etched-border
// panel holding the "Open binned by " spinner with the " in X and Y" label
// above the 3dmod button itself.
export component BinnedXY3dmodButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> binning: "1";
    background: EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    VerticalLayout {
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;
        HorizontalLayout {
            alignment: center;
            spacing: EtomoStyle.gap;
            Text {
                text: "Open binned by ";
                vertical-alignment: center;
                color: EtomoStyle.text;
            }
            Rectangle {
                width: 44px;
                height: EtomoStyle.field-height;
                background: EtomoStyle.field-background;
                border-width: 1px;
                border-color: EtomoStyle.border;
                Text { x: 3px; text: root.binning; vertical-alignment: center; }
            }
            Rectangle {
                width: 14px;
                height: EtomoStyle.field-height;
                background: EtomoStyle.panel;
                border-width: 1px;
                border-color: EtomoStyle.border;
                VerticalLayout {
                    Text { text: "^"; horizontal-alignment: center; }
                    Text { text: "v"; horizontal-alignment: center; }
                }
            }
            Text { text: " in X and Y"; vertical-alignment: center; color: EtomoStyle.text; }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                background: EtomoStyle.panel;
                border-width: 2px;
                border-color: EtomoStyle.border;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: root.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-weight: 700;
                        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
                    }
                }
            }
        }
    }
}
