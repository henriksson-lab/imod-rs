// Widgets these three dialogs need that the shared vocabulary in
// `gui/etomo-ui-common/ui/widgets.slint` does not carry.  Same convention as
// the common crate: one component per Swing widget class in
// `IMOD/Etomo/src/etomo/ui/swing`, named after that class.

import {
    EtomoStyle, EtomoBridge, ContextArea, BridgedTextBox, BridgedButton, BridgedToggle, BridgedComboBox,
} from "../../etomo-ui-common/ui/widgets.slint";

// `EtchedBorder` (`EtchedBorder.java`): a titled etched group box.  A distinct
// Swing class from `BeveledBorder`, which is all the common crate carries;
// Swing draws it with a thin two-tone etch rather than a raised bevel.
export component EtchedBorder inherits Rectangle {
    in property <string> title;
    // Wired: false while the titled panel is not showing (`visible-value`
    // "brd"); the box then takes no room.
    out property <bool> shown-visible: !EtomoBridge.wired || root.title == ""
        || EtomoBridge.visible-value("brd", root.title, true, EtomoBridge.generation);
    height: root.shown-visible ? etched-layout.preferred-height : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    // Swing's etched border is a dark line with a light line inside it.  Slint
    // has one border colour per rectangle, so the etch is approximated by the
    // dark line only.
    border-color: EtomoStyle.border;
    ContextArea { kind: "brd"; label: root.title; visible: root.shown-visible; }
    etched-layout := VerticalLayout {
        visible: root.shown-visible;
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;
        if root.title != "": Text {
            text: root.title;
            font-size: EtomoStyle.font-size-pt * 1px;
            color: EtomoStyle.text;
        }
        @children
    }
}

// `TextField` (`TextField.java`): an entry box with no label of its own.
// `label` is the Java `reference` the field is named from (`TextField.setName`,
// "tf." + the converted reference); it is not drawn.
export component TextField inherits BridgedTextBox {
    kind: "tf";
}

// The folder button beside a file text field: `ScaledImage.OPEN_FILE` in the
// Java; Slint has no image to point at here, so the glyph stands in for it.
// Wired, it presses the button in the Swing panel of the field labelled
// `label` (bridge kind "fbn").
component FileButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    width: EtomoStyle.field-height;
    height: EtomoStyle.field-height;
    background: EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        text: "[]";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
    area := BridgedButton {
        kind: "fbn";
        label: root.label;
        default-enabled: root.enabled;
    }
}

// `FileTextField` (`FileTextField.java`): label, entry box, folder button.
// The field is `new TextField(FIELD_TYPE, label, null)`, so it is named from
// the label.
export component FileTextField inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: field.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        field := BridgedTextBox {
            kind: "tf";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        FileButton { label: root.label; enabled: root.enabled; }
    }
}

// `ButtonControlTextEfield` (`ButtonControlTextEfield.java`), as built by
// `getLabeledFileInstance`: a labelled `TextEfield` plus an `Ebutton` file
// chooser (and no clear button for that instance).  Appearance-wise the same
// shape as `FileTextField`; kept separate because the Java classes are.
export component ButtonControlTextEfield inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: field.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        field := BridgedTextBox {
            kind: "tf";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        FileButton { label: root.label; enabled: root.enabled; }
    }
}

// `ComboBox` (`ComboBox.java`): label then a drop-down, named "cbb." + the
// label.
export component ComboBox inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("cbb", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        // `ComboBox.createPanel` (`ComboBox.java:119-124`): rigid 2px, the
        // label, rigid 3px, the combo box, rigid 2px.
        padding-left: 2px;
        padding-right: 2px;
        spacing: 3px;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: box.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        box := BridgedComboBox {
            kind: "cbb";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
    }
}

// `CheckTextField` (`CheckTextField.java`): a check box that enables the entry
// box beside it.  `setLabel` gives the check box the label as its text and
// the text field the label as its name, so both are found from `text`.
export component CheckTextField inherits HorizontalLayout {
    in property <string> text;
    in property <bool> checked;
    in property <string> field-text;
    in property <bool> enabled: true;
    in property <length> field-width: 120px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("cb", root.text, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        Rectangle {
            width: 13px;
            height: EtomoStyle.field-height;
            Rectangle {
                width: 13px;
                height: 13px;
                background: EtomoStyle.field-background;
                border-width: 1px;
                border-color: EtomoStyle.border;
                if toggle.checked: Text { text: "x"; horizontal-alignment: center; vertical-alignment: center; }
            }
            toggle := BridgedToggle {
                kind: "cb";
                label: root.text;
                default-checked: root.checked;
                default-enabled: root.enabled;
            }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: toggle.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        TextField {
            width: root.field-width;
            label: root.text;
            text: root.field-text;
            enabled: toggle.checked;
        }
    }
}

// `ProgressPanel` (`ProgressPanel.java`): the task label above a `JProgressBar`
// (named `the-progress-bar-label` and `the-progress-bar`).
export component ProgressPanel inherits VerticalLayout {
    in property <string> label: "No process";
    property <string> shown-label: EtomoBridge.wired
        ? EtomoBridge.text-value("raw", "the-progress-bar-label", root.label, EtomoBridge.generation)
        : root.label;
    property <float> shown-fraction: EtomoBridge.wired
        ? EtomoBridge.text-value("pbf", "the-progress-bar", "0", EtomoBridge.generation).to-float()
        : 0;
    spacing: 5px;
    Text {
        text: root.shown-label;
        color: EtomoStyle.text;
        font-size: EtomoStyle.font-size-pt * 1px;
    }
    Rectangle {
        height: 16px;
        background: EtomoStyle.field-background;
        border-width: 1px;
        border-color: EtomoStyle.border;
        Rectangle {
            x: 1px;
            y: 1px;
            width: (parent.width - 2px) * (root.shown-fraction < 0 ? 0.33 : root.shown-fraction);
            height: parent.height - 2px;
            background: #6c8ebf;
        }
    }
}

// `AxisProgressPanel` (`AxisProgressPanel.java`): the progress panel and its
// `Kill Process` button (a `SimpleButton`, named "bn." + its text).
// `SetupDialog` starts it hidden.
export component AxisProgressPanel inherits HorizontalLayout {
    in property <string> label: "No process";
    spacing: 5px;
    ProgressPanel { label: root.label; }
    Rectangle {
        width: 110px;
        height: 28px;
        background: EtomoStyle.panel;
        border-width: 2px;
        border-color: EtomoStyle.border;
        // `buttonKillProcess.setEnabled(false)` in `createPanel`.
        Text {
            text: "Kill Process";
            horizontal-alignment: center;
            vertical-alignment: center;
            color: kill.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-weight: 700;
        }
        kill := BridgedButton {
            kind: "bn";
            label: "Kill Process";
            default-enabled: false;
        }
    }
}
