// Widgets these shell dialogs need that
// `gui/etomo-ui-common/ui/widgets.slint` does not carry.  One component per
// Swing widget class in `IMOD/Etomo/src/etomo/ui/swing`, named after the Java
// class it stands for, in the same style as the common vocabulary.  Defined
// here rather than in the common crate so nothing shared is disturbed.

import {
    EtomoStyle, EtomoBridge, ContextArea, BridgedTextBox, BridgedButton, BridgedComboBox,
} from "../../etomo-ui-common/ui/widgets.slint";

// `ComboBox` (`ComboBox.java`): `pnlRoot` is BoxLayout.X_AXIS holding a rigid
// 2px gap, the JLabel, a rigid 3px gap, the JComboBox and a rigid 2px gap.
export component ComboBox inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> box-width: 200px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("cbb", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        alignment: start;
        Rectangle { width: 2px; }
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        Rectangle { width: 3px; }
        // Wired: "cbb." + the label (`ComboBox.setName`).
        BridgedComboBox {
            width: root.box-width;
            kind: "cbb";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        Rectangle { width: 2px; }
    }
}

// `FileTextField` / `FileTextField2` (`FileTextField.java`,
// `FileTextField2.java`): JLabel, text field, then the `SimpleButton` carrying
// `ScaledImage.OPEN_FILE` (a folder icon).  No icon asset is vendored for this
// crate, so the button shows the folder glyph as text.
export component FileTextField inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        // Wired: the field is named "tf." + the label; the folder button is the
        // button in the field's panel (bridge kind "fbn").
        BridgedTextBox {
            kind: "tf";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        Rectangle {
            width: EtomoStyle.field-height;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            Text { text: "📁"; horizontal-alignment: center; vertical-alignment: center; }
            BridgedButton { kind: "fbn"; label: root.label; default-enabled: root.enabled; }
        }
    }
}

// `javax.swing.JButton` as used directly by `SettingsDialog` for Cancel /
// Apply / Done -- a plain single-line button, not eTomo's `MultiLineButton`.
export component PlainButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows; it then takes no room.
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("bn", root.text, true, EtomoBridge.generation);
    height: root.shown-visible ? EtomoStyle.field-height + 4px : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    border-color: EtomoStyle.border;
    HorizontalLayout {
        visible: root.shown-visible;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
    }
    // Wired: "bn." + the label.
    area := BridgedButton { kind: "bn"; label: root.text; default-enabled: root.enabled; }
}

// `Spinner` (`Spinner.java`) laid out horizontally with its label, as
// `ParallelDialog` and `FilterFullVolumePanel` place it in an X_AXIS row.
// Same shape as the common `LabeledSpinner`, but sized to its label instead of
// a fixed 180px column.
export component InlineSpinner inherits HorizontalLayout {
    in property <string> label;
    // Wired: "#N" when the dialog draws N showing spinners with this label;
    // appended to the bridge label.
    in property <string> occurrence;
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("sp", root.label + root.occurrence, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        // Wired: "sp." + the label.
        BridgedTextBox {
            width: 60px;
            kind: "sp";
            label: root.label + root.occurrence;
            text: root.text;
            enabled: root.enabled;
        }
        Rectangle {
            width: 14px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            VerticalLayout {
                Text {
                    text: "^";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.label + root.occurrence, true); } }
                }
                Text {
                    text: "v";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.label + root.occurrence, false); } }
                }
            }
        }
    }
}

// A `LabeledTextField` sized to its label rather than to the common widget's
// fixed 180px label column, for the X_AXIS rows where Swing packs two or three
// labelled fields side by side.
export component InlineTextField inherits HorizontalLayout {
    in property <string> label;
    // Wired: "#N" when the dialog draws N showing fields with this label;
    // appended to the bridge label.
    in property <string> occurrence;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> field-width: 120px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label + root.occurrence, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        // Wired: "tf." + the label.
        BridgedTextBox {
            width: root.field-width;
            kind: "tf";
            label: root.label + root.occurrence;
            text: root.text;
            enabled: root.enabled;
        }
    }
}

// `Label` (`Label.java`): eTomo's JLabel wrapper, with the enabled state its
// `setEnabled` drives.
export component Label inherits Text {
    in property <bool> enabled: true;
    color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    vertical-alignment: center;
    font-size: EtomoStyle.font-size-pt * 1px;
}

// `Spinner` (`Spinner.java`) as built by `Spinner.getInstance(text, ...)`:
// that factory passes `labeled = false` (`Spinner.java:165-177`) and the
// constructor only creates the JLabel when `labeled` is true
// (`Spinner.java:125-129`), so the text is a name for tooltips and UI tests,
// not a drawn label.  The widget is the JSpinner alone.
export component Spinner inherits HorizontalLayout {
    // Wired: the text the Java names the spinner from ("sp." + it); not drawn.
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> box-width: 50px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("sp", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        alignment: start;
        BridgedTextBox {
            width: root.box-width;
            kind: "sp";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        Rectangle {
            width: 14px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            VerticalLayout {
                Text {
                    text: "^";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.label, true); } }
                }
                Text {
                    text: "v";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.label, false); } }
                }
            }
        }
    }
}

// `TextField` (`TextField.java`): an unlabeled entry box.  Its owner sets the
// drawn width with `setPreferredWidth`.
export component TextField inherits BridgedTextBox {
    // Wired: `label` is the Java `reference` the field is named from ("tf." +
    // it); not drawn.
    in property <bool> editable: true;
    kind: "tf";
    // A `JTextField`'s maximum width is unbounded: it keeps this preferred
    // width only where its row does not stretch it.
    preferred-width: root.shown-visible ? 100px : 0px;
}

// `TextArea` (`TextArea.java`) inside a `JScrollPane`.  `rows` and `columns`
// are the JTextArea constructor arguments; the vertical scroll bar is drawn
// beside it, as `ScrollPaneConstants.VERTICAL_SCROLLBAR_ALWAYS` asks for.
export component TextArea inherits Rectangle {
    in property <string> text;
    in property <int> rows: 5;
    in property <int> columns: 15;
    in property <bool> editable: true;
    height: EtomoStyle.field-height * root.rows;
    width: root.columns * 8px + 14px;
    background: EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    HorizontalLayout {
        padding: 1px;
        Rectangle {
            background: root.editable ? EtomoStyle.field-background : EtomoStyle.panel;
            Text {
                x: 3px;
                y: 3px;
                text: root.text;
                wrap: word-wrap;
                color: EtomoStyle.text;
            }
        }
        Rectangle {
            width: 14px;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
        }
    }
}

// `EtchedBorder` (`EtchedBorder.java`) and the untitled
// `BorderFactory.createEtchedBorder()` group box.  Slint has no titled border,
// so -- as elsewhere in this translation -- the title is the first row inside
// the box, and an empty title draws no row at all.
export component EtchedBorder inherits Rectangle {
    in property <string> title;
    // Wired: false while the titled panel is not showing (`visible-value`
    // "brd"); the box then takes no room.
    out property <bool> shown-visible: !EtomoBridge.wired || root.title == ""
        || EtomoBridge.visible-value("brd", root.title, true, EtomoBridge.generation);
    height: root.shown-visible ? etched-layout.preferred-height : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    border-color: EtomoStyle.border;
    ContextArea { kind: "brd"; label: root.title; visible: root.shown-visible; }
    etched-layout := VerticalLayout {
        visible: root.shown-visible;
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;
        if root.title != "": Text {
            text: root.title;
            font-size: EtomoStyle.font-size-pt * 1px;
            font-weight: 700;
            color: EtomoStyle.text;
        }
        @children
    }
}

// `Ebutton` (`Ebutton.java`) in its icon-only forms.  The select-file
// factories build the button with a null label (`Ebutton.java:185-224`) and
// hand it `FileOpenButtonStyleExtension`, whose icon is
// `ScaledImage.OPEN_FILE`, a folder; `getClearInstance` uses
// `ClearButtonStyleExtension`, an eraser.  `ButtonStyleExtension.setup` sets
// only the icon and the size, never the text, so these buttons carry no
// caption.  No icon asset is vendored for this crate, so the glyph stands in
// for the image, the same substitution `FileTextField` above makes.
// `FixedDim.INLINE_SQUARE_SIZE` is 22 x 22.
export component Ebutton inherits Rectangle {
    in property <string> glyph: "📁";
    in property <bool> enabled: true;
    // Wired: the label of the text field this button belongs to (bridge kind
    // "fbn": the first button in that field's panel).
    in property <string> field-label;
    width: 22px;
    height: 22px;
    background: EtomoStyle.panel;
    border-width: 1px;
    border-color: EtomoStyle.border;
    Text {
        text: root.glyph;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
    if root.field-label != "": BridgedButton {
        kind: "fbn";
        label: root.field-label;
        default-enabled: root.enabled;
    }
}

// `SingleLineButton` (`SingleLineButton.java`): a one-line JButton, as
// `GlobalExpandButton` uses for the dialog-level Advanced/Basic button.
export component SingleLineButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // Wired: "bn." + the label; `labels` lists every label the button can
    // carry ("Advanced|Basic"), and the shown text is the Swing button's.
    in property <string> labels: root.text;
    property <string> shown-text: EtomoBridge.wired
        ? EtomoBridge.text-value("bn", root.labels, root.text, EtomoBridge.generation)
        : root.text;
    // Wired: drawn only while the Swing component shows; it then takes no room.
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("bn", root.labels, true, EtomoBridge.generation);
    height: root.shown-visible ? EtomoStyle.field-height + 2px : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 2px : 0px;
    border-color: EtomoStyle.border;
    HorizontalLayout {
        visible: root.shown-visible;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.shown-text;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-weight: 700;
        }
    }
    area := BridgedButton { kind: "bn"; label: root.labels; default-enabled: root.enabled; }
}

// `ButtonControlTextEfield` (`ButtonControlTextEfield.java`), which extends
// `TextEfield`: the container holds the optional JLabel and the text field
// (`TextEfield.java:73-98`), then the constructor appends the select-file
// `Ebutton` and, when `includeClearButton` is set, the clear `Ebutton`
// (`ButtonControlTextEfield.java:46-65`).  `getFileInstance` passes
// `useLabelComponent = false`, so those instances draw no label;
// `getLabeledFileInstance` passes true.
export component ButtonControlTextEfield inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> clear-button: true;
    in property <length> field-width: 200px;
    // Wired: drawn only while the Swing component shows (`visible-value`).
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 2px;
        alignment: start;
        if root.label != "": Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: root.enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
            font-size: EtomoStyle.font-size-pt * 1px;
        }
        // Wired: `TextEfield.setName`, "tf." + the label.
        BridgedTextBox {
            width: root.field-width;
            kind: "tf";
            label: root.label;
            text: root.text;
            enabled: root.enabled;
        }
        Ebutton { glyph: "📁"; enabled: root.enabled; field-label: root.label; }
        if root.clear-button: Ebutton { glyph: "🧽"; enabled: root.enabled; }
    }
}
