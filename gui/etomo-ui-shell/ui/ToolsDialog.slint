// Mirrors `IMOD/Etomo/src/etomo/ui/swing/ToolsDialog.java`.
//
// `createPanel()` (`:188-201`) builds `pnlRoot` as BoxLayout.Y_AXIS holding,
// in order:
//   1. `toolPanel.getComponent()` -- when a tool panel exists, and
//   2. `scrTaskLog`, a JScrollPane over the non-editable, word-wrapping
//      `taTaskLog` JTextArea of 5 rows.
// The tool panel itself is chosen in the constructor from `ToolType`
// (`:64-80`): FLATTEN_VOLUME -> FlattenVolumePanel.getToolsInstance,
// GPU_TILT_TEST -> GpuTiltTestPanel.getInstance,
// ALIGN_FRAMES -> AlignFramesPanel.getToolsInstance, else null.
//
// Each of those three panels is translated in its own file beside this one --
// `FlattenVolumePanel.slint`, `GpuTiltTestPanel.slint`,
// `AlignFramesPanel.slint` -- and `tool-type` selects between them with the
// same three-way branch, indexed in the order the Java tests them.
// `has-tool-panel` reproduces the `toolPanel != null` test.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { FlattenVolumePanel } from "FlattenVolumePanel.slint";
import { GpuTiltTestPanel } from "GpuTiltTestPanel.slint";
import { AlignFramesPanel } from "AlignFramesPanel.slint";

export component ToolsDialog inherits Rectangle {
    // `toolType`, as the constructor branches on it: 0 =
    // `ToolType.FLATTEN_VOLUME`, 1 = `ToolType.GPU_TILT_TEST`,
    // 2 = `ToolType.ALIGN_FRAMES` (`etomo/type/ToolType.java:21-24`).  The
    // FLATTEN_VOLUME branch is the first one the constructor tests, so it is
    // the default here.
    in property <int> tool-type: 0;
    // `toolPanel != null` (`:190`).
    in property <bool> has-tool-panel: true;
    // Wired: the text of `taTaskLog` (`slint_bridge.rs`).
    in property <string> task-log;
    background: EtomoStyle.background;

    VerticalLayout {
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;

        // `pnlRoot.add(toolPanel.getComponent())`, only when non-null.
        if root.has-tool-panel && root.tool-type == 0: FlattenVolumePanel {
            // `ToolsDialog` uses `FlattenVolumePanel.getToolsInstance`.
            post-instance: false;
        }
        if root.has-tool-panel && root.tool-type == 1: GpuTiltTestPanel { }
        if root.has-tool-panel && root.tool-type == 2: AlignFramesPanel { }

        // `scrTaskLog` = new JScrollPane(taTaskLog); taTaskLog.setRows(5),
        // setEditable(false), setLineWrap(true), setWrapStyleWord(true).
        // Wired, `task-log` is the text `append` (the `EtomoLogger` of this
        // `LogInterface`) has put in the Swing `JTextArea`; an append on the
        // event dispatch thread moves the caret to the end, so the scroll
        // pane follows the last line.
        Rectangle {
            height: EtomoStyle.field-height * 5;
            background: EtomoStyle.field-background;
            border-width: 1px;
            border-color: EtomoStyle.border;
            HorizontalLayout {
                padding: 1px;
                task-log-view := Flickable {
                    viewport-width: self.width;
                    viewport-height: max(self.height, task-log-text.preferred-height + 6px);
                    task-log-text := Text {
                        x: 3px;
                        y: 3px;
                        width: task-log-view.width - 6px;
                        text: root.task-log;
                        wrap: word-wrap;
                        color: EtomoStyle.text;
                        font-size: EtomoStyle.font-size-pt * 1px;
                    }
                }
                Rectangle {
                    width: 14px;
                    background: EtomoStyle.panel;
                    border-width: 1px;
                    border-color: EtomoStyle.border;
                }
            }
        }
    }
    changed task-log => {
        task-log-view.viewport-y = min(0px, task-log-view.height - task-log-view.viewport-height);
    }
}

export component ToolsDialogWindow inherits Window {
    title: "Tools";
    background: EtomoStyle.background;
    preferred-width: 560px;
    preferred-height: 360px;
    ToolsDialog { }
}
