// Mirrors `IMOD/Etomo/src/etomo/ui/swing/SerialSectionsDialog.java`.
//
// The Align tab's body is `AutoAlignmentPanel.getSerialSectionsInstance(...)`
// (`AutoAlignmentPanel.java`), which in turn embeds
// `TransformChooserPanel.getSerialSectionsInstance()`; both are drawn inline
// below, with `CheckTextField.java`, `RadioTextField.java`,
// `CheckBoxSpinner.java` and `ButtonControlTextEfield.java` for the fields.
//
// Wired through `EtomoBridge` (`ui/swing/slint_bridge.rs`): every widget is
// identified by the label the Java gives it ("#N" picks the N-th showing
// widget of that name: the two "None" radio buttons, the two "Y: " fields).
// Swing shows one tab body at a time: `changeTab` removes the body from the
// old tab's panel and adds it to the new one.  The selected tab
// (`BridgedTabbedPane.shown-current`, read from the Swing `TabbedPane`)
// chooses the body that is drawn; the "Initial Blend" tab is disabled for a
// single-frame dataset (`createPanel`, :163-164).  Unwired, the widgets show
// the Java's construction-time state.

import { EtomoStyle, EtomoBridge, BeveledBorder, CheckBox, RadioButton, MultiLineButton,
         LabeledTextField, LabeledSpinner, BridgedTextBox, BridgedButton, BridgedTabbedPane }
    from "../../etomo-ui-common/ui/widgets.slint";
import { EtchedBorder } from "LocalWidgets.slint";

// `CheckTextField.getInstance(FieldType, label)`: a check box and a text field,
// both named from the label.
component SsCheckTextField inherits HorizontalLayout {
    in property <string> label;
    in property <length> field-width: 90px;
    spacing: EtomoStyle.gap;
    alignment: start;
    CheckBox { text: root.label; }
    BridgedTextBox { kind: "tf"; label: root.label; width: root.field-width; }
}

// `RadioTextField.getInstanceWithAlternateLabel(FieldType, "", group, label)`:
// a radio button with no text and a text field, both named from the alternate
// label.
component SsRadioTextField inherits HorizontalLayout {
    in property <string> label;
    in property <length> field-width: 60px;
    spacing: EtomoStyle.gap;
    alignment: start;
    Rectangle {
        width: 13px;
        height: 13px;
        y: (parent.height - 13px) / 2;
        border-radius: 6px;
        background: EtomoStyle.field-background;
        border-width: 1px;
        border-color: EtomoStyle.border;
        property <bool> selected: EtomoBridge.wired
            ? EtomoBridge.bool-value("rb", root.label, false, EtomoBridge.generation) : false;
        if self.selected: Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 3px;
            background: EtomoStyle.text;
        }
        TouchArea { clicked => { EtomoBridge.toggled("rb", root.label, true); } }
    }
    BridgedTextBox { kind: "tf"; label: root.label; width: root.field-width; }
}

// `CheckBoxSpinner.getInstance(label)`: a check box and a spinner, both named
// from the label.
component SsCheckBoxSpinner inherits HorizontalLayout {
    in property <string> label;
    spacing: EtomoStyle.gap;
    alignment: start;
    CheckBox { text: root.label; }
    BridgedTextBox { kind: "sp"; label: root.label; width: 60px; text: "1"; }
    VerticalLayout {
        Rectangle {
            width: 14px; height: EtomoStyle.field-height / 2;
            background: EtomoStyle.panel; border-width: 1px; border-color: EtomoStyle.border;
            Text { text: "^"; font-size: 8px; }
            TouchArea { clicked => { EtomoBridge.toggled("sp", root.label, true); } }
        }
        Rectangle {
            width: 14px; height: EtomoStyle.field-height / 2;
            background: EtomoStyle.panel; border-width: 1px; border-color: EtomoStyle.border;
            Text { text: "v"; font-size: 8px; }
            TouchArea { clicked => { EtomoBridge.toggled("sp", root.label, false); } }
        }
    }
}

// `ButtonControlTextEfield.getFileInstance("Gradient file", ...)`: an
// unlabelled text field and its file-chooser button ("fbn", the button in the
// field's panel).
component SsFileEfield inherits HorizontalLayout {
    in property <string> label;
    spacing: EtomoStyle.gap;
    alignment: start;
    BridgedTextBox { kind: "tf"; label: root.label; width: 250px; }
    Rectangle {
        width: 26px;
        height: EtomoStyle.field-height;
        background: EtomoStyle.panel;
        border-width: 1px;
        border-color: EtomoStyle.border;
        Text { text: "..."; horizontal-alignment: center; vertical-alignment: center; }
        BridgedButton { kind: "fbn"; label: root.label; }
    }
}

// Tab.INITIAL_BLEND, "Initial Blend" (`createPanel`, :206-365).
component InitialBlendTab inherits VerticalLayout {
    spacing: 0px;
    padding: EtomoStyle.inset;
    alignment: start;

    // pnlPreblendReadInXcorrs
    HorizontalLayout {
        alignment: start;
        CheckBox { text: "Use existing edge displacement file (.ecd)"; }
    }
    // pnlPreblendVerySloppyBlend
    HorizontalLayout {
        alignment: start;
        CheckBox { text: "Treat as very sloppy montage"; }
    }
    // pnlPreblendRobustFitCriterion
    SsCheckTextField { label: "Robust fitting with criterion: "; }

    Rectangle { height: 10px; }

    // pnlMultipleCorrelation
    HorizontalLayout {
        alignment: start;
        EtchedBorder {
            title: "Analysis of Multiple Correlation Peaks";
            // pnlPreblendEMGridMapFilter
            HorizontalLayout {
                alignment: start;
                CheckBox { text: "Treat as low-magnification EM grid map and use peak weighting"; }
            }
            // pnlPreblendHighFrequencyFilterCutoff: 20px indent
            HorizontalLayout {
                padding-left: 20px;
                alignment: start;
                LabeledTextField {
                    label: "High-frequency filter cutoff in 1/microns ";
                    text: "0.25";
                    width: 340px;
                }
            }
            // pnlPreblendWeightForExpectedShifts
            HorizontalLayout {
                alignment: start;
                CheckBox { text: "Just weight correlation peaks by deviations from expected shift"; }
            }
            // pnlPreblendWeightForExpectedShifts2: 5px indent, then the
            // strDistanceInPixels JLabel, the "default" radio, the alternate-label
            // RadioTextField, and the strPixels JLabel.
            HorizontalLayout {
                padding-left: 5px;
                spacing: EtomoStyle.gap;
                alignment: start;
                Text {
                    text: "Distance at which weighting falls to 0.5: ";
                    vertical-alignment: center;
                }
                RadioButton { text: "default"; selected: true; }
                SsRadioTextField { label: "Distance at which weighting falls to 0.5"; }
                Text { text: " pixels"; vertical-alignment: center; }
            }
        }
    }

    Rectangle { height: 10px; }

    // pnlIntensityCorrection
    HorizontalLayout {
        alignment: start;
        EtchedBorder {
            title: "Intensity Correction from Differences in Edges";
            RadioButton { text: "None"; occurrence: "#1"; selected: true; }
            RadioButton { text: "Piece-to-piece differences only"; }
            RadioButton { text: "Gradient within pieces also"; }
        }
    }

    Rectangle { height: 10px; }

    // pnlInitialGradientCorrection
    HorizontalLayout {
        alignment: start;
        EtchedBorder {
            title: "Initial Gradient Correction from Summed Images";
            RadioButton { text: "None"; occurrence: "#2"; selected: true; }
            RadioButton { text: "Planar fit to sum of pieces in this input file"; }
            RadioButton { text: "Gradient file from other summed images:"; }
            // pnlGradientFileChooser: 20px indent, then bctfGradientFile,
            // disabled until "Gradient file from other summed images" is picked.
            HorizontalLayout {
                padding-left: 20px;
                alignment: start;
                SsFileEfield { label: "Gradient file"; }
            }
        }
    }

    Rectangle { height: 10px; }

    // pnlInitialBlendButtons
    HorizontalLayout {
        spacing: 10px;
        alignment: center;
        MultiLineButton { text: "Open Raw Stack"; width: 150px; }
        MultiLineButton { text: "Make Blended Stack"; width: 150px; }
        MultiLineButton { text: "Open Blended Stack"; width: 150px; }
    }

    Rectangle { height: 10px; }

    // pnlMidasX / pnlMidas
    HorizontalLayout {
        alignment: center;
        EtchedBorder {
            title: "Fix Shifts Between Pieces";
            HorizontalLayout {
                alignment: center;
                LabeledSpinner { label: "Binning: "; text: "1"; }
            }
            Rectangle { height: 5px; }
            HorizontalLayout {
                alignment: center;
                MultiLineButton { text: "Fix Edges With Midas"; width: 180px; }
            }
            Rectangle { height: 5px; }
            Text { text: "Replaces the edge displacement file (.ecd)."; }
        }
    }

    Rectangle { height: 5px; }
}

// `TransformChooserPanel.getSerialSectionsInstance()`
// (`TransformChooserPanel.java:78`): the optional-search variant, so the
// "Search For:" line is a check box rather than a JLabel.
component TransformChooserPanel inherits HorizontalLayout {
    alignment: start;
    VerticalLayout {
        alignment: start;
        // setTransform(null) selects Transform.DEFAULT ==
        // FULL_LINEAR_TRANSFORMATION and checks the search box.
        CheckBox { text: "Search For:"; checked: true; }
        RadioButton { text: "Full linear transformation"; selected: true; }
        RadioButton { text: "Rotation/translation/magnification"; }
        RadioButton { text: "Rotation/translation"; }
    }
}

// `AutoAlignmentPanel.getSerialSectionsInstance()` (`AutoAlignmentPanel.java`),
// the body of Tab.ALIGN.
component AutoAlignmentPanel inherits VerticalLayout {
    spacing: EtomoStyle.row-gap;
    padding: EtomoStyle.inset;
    alignment: start;

    EtchedBorder {
        title: "Auto Alignment Parameters";
        LabeledTextField { label: "Sigma for low-frequency filter: "; text: "0.0"; }
        LabeledTextField { label: "Cutoff for high-frequency filter: "; text: "0.35"; }
        LabeledTextField { label: "Sigma for high-frequency filter: "; text: "0.05"; }
        // pnlSobelFilter
        HorizontalLayout {
            alignment: start;
            CheckBox { text: "Apply Sobel filter"; }
        }
        // pnlPreCrossCorrelation
        HorizontalLayout {
            alignment: start;
            CheckBox { text: "Find initial shifts with cross-correlation"; }
        }
        TransformChooserPanel { }
        // pnlWarping
        EtchedBorder {
            title: "Warping";
            HorizontalLayout {
                alignment: start;
                CheckBox { text: "Find warping transformations"; }
            }
            Rectangle { height: 3px; }
            HorizontalLayout {
                alignment: start;
                LabeledTextField { label: "Correlation patch size in X: "; width: 280px; }
                LabeledTextField { label: " Y: "; occurrence: "#1"; width: 110px; }
            }
            Rectangle { height: 3px; }
            HorizontalLayout {
                spacing: EtomoStyle.gap;
                alignment: start;
                CheckBox { text: "Use boundary model:"; }
                MultiLineButton { text: "Create/View Boundary Model"; width: 200px; }
            }
            Rectangle { height: 3px; }
            HorizontalLayout {
                alignment: start;
                LabeledTextField { label: "Limits to shifts in X: "; width: 280px; }
                LabeledTextField { label: " Y: "; occurrence: "#2"; width: 110px; }
            }
        }
        LabeledTextField { label: "Sections to skip: "; }
        LabeledTextField { label: "Fraction to ignore on edges: "; text: "0.05"; }
        LabeledSpinner { label: "Binning in search: "; text: "2"; }
    }

    LabeledSpinner { label: "Binning in Midas: "; text: "1"; }

    // pnlButtons: pnlLeftButtons then pnlRightButtons, each a column.
    HorizontalLayout {
        spacing: EtomoStyle.gap;
        alignment: start;
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Initial Auto Alignment"; width: 200px; }
            MultiLineButton { text: "Midas"; width: 200px; }
            MultiLineButton { text: "Refine with Auto Alignment"; width: 200px; }
        }
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            MultiLineButton { text: "Revert Auto Alignment to Midas"; width: 220px; }
            MultiLineButton { text: "Revert to No Transforms"; width: 220px; }
        }
    }
}

// Tab.ALIGN, "Align" (`createPanel`, :367-378).
component AlignTab inherits VerticalLayout {
    padding: EtomoStyle.inset;
    alignment: start;
    Rectangle { height: 3px; }
    // pnlOpenAlignedStack
    HorizontalLayout {
        alignment: center;
        MultiLineButton { text: "Open Stack"; width: 150px; }
    }
    Rectangle { height: 5px; }
    AutoAlignmentPanel { }
}

// Tab.MAKE_ALIGNED_STACK, "Make Stack" (`createPanel`, :380-428).
component MakeStackTab inherits VerticalLayout {
    spacing: 0px;
    padding: EtomoStyle.inset;
    alignment: start;

    // pnlXftoxgAlignmentX / pnlXftoxgAlignment
    HorizontalLayout {
        alignment: start;
        EtchedBorder {
            title: "Stack alignment transforms";
            RadioButton { text: "Local fitting (retain trends)"; }
            RadioButton { text: "Remove trends in rotation"; }
            RadioButton { text: "Remove trends in translation"; }
            RadioButton { text: "Remove trends in translation & rotation"; }
            RadioButton { text: "Global alignments (remove all trends)"; }
        }
    }

    Rectangle { height: 3px; }

    SsCheckBoxSpinner { label: "Reference section for global alignment: "; }

    Rectangle { height: 10px; }

    // pnlSize
    HorizontalLayout {
        spacing: 5px;
        alignment: start;
        LabeledTextField { label: "Size in X: "; width: 190px; }
        LabeledTextField { label: "Y: "; occurrence: "#1"; width: 120px; }
    }

    Rectangle { height: 5px; }

    // pnlShift
    HorizontalLayout {
        spacing: 5px;
        alignment: start;
        LabeledTextField { label: "Shift in X: "; width: 190px; }
        LabeledTextField { label: "Y: "; occurrence: "#2"; width: 120px; }
    }

    Rectangle { height: 5px; }

    // pnlMakeStackA
    HorizontalLayout {
        spacing: 20px;
        alignment: start;
        LabeledSpinner { label: "Binning: "; text: "1"; }
        CheckBox { text: "Fill empty areas with 0"; }
    }

    Rectangle { height: 15px; }

    // pnlMakeStackButtons
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        MultiLineButton { text: "Make Aligned Stack"; width: 160px; }
        MultiLineButton { text: "Open Aligned Stack"; width: 160px; }
    }

    Rectangle { height: 5px; }
}

export component SerialSectionsDialog inherits Rectangle {
    // Unwired: the tab the Java shows first (Tab.INITIAL_BLEND for a montage).
    in property <int> current-tab: 0;
    background: EtomoStyle.background;
    VerticalLayout {
        alignment: start;
        BeveledBorder {
            title: "Serial Sections";
            tabs := BridgedTabbedPane {
                tabs: ["Initial Blend", "Align", "Make Stack"];
                current: root.current-tab;
            }
            Rectangle {
                background: EtomoStyle.panel;
                border-width: 1px;
                border-color: EtomoStyle.border;
                VerticalLayout {
                    if tabs.shown-current == 0: InitialBlendTab { }
                    if tabs.shown-current == 1: AlignTab { }
                    if tabs.shown-current == 2: MakeStackTab { }
                }
            }
        }
    }
}

export component SerialSectionsDialogWindow inherits Window {
    in property <int> current-tab: 0;
    title: "Serial Sections";
    background: EtomoStyle.background;
    preferred-width: 720px;
    preferred-height: 760px;
    SerialSectionsDialog { current-tab: root.current-tab; }
}
