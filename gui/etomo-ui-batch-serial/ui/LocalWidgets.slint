// Widgets the dialogs of this crate use that the shared vocabulary in
// `gui/etomo-ui-common/ui/widgets.slint` does not carry.  Each one is named
// after the Swing class in `IMOD/Etomo/src/etomo/ui/swing` it stands for.
// The batch dialogs' widgets are bridged to the translated Swing tree through
// `EtomoBridge` by `(kind, label)`, the label being the one the Java passes to
// the widget; `EtchedBorder` (unbridged) is kept for the serial-sections files.

import { EtomoStyle, EtomoBridge, ContextArea, BridgedTextBox, BridgedButton,
         BridgedComboBox, CheckBox, RadioButton }
    from "../../etomo-ui-common/ui/widgets.slint";

// `EtchedBorder` (`EtchedBorder.java`): a titled etched group box.  Swing
// paints the title *into* the top border line; Slint has no border-title, so
// the title is the first row inside the box, the same compromise the shared
// `BeveledBorder` makes.
export component EtchedBorder inherits Rectangle {
    in property <string> title;
    background: EtomoStyle.panel;
    border-width: 2px;
    border-color: EtomoStyle.border;
    VerticalLayout {
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.gap;
        if root.title != "": Text {
            text: root.title;
            font-size: EtomoStyle.font-size-pt * 1px;
            font-weight: 700;
            color: EtomoStyle.text;
        }
        @children
    }
}

// `JSeparator`: the horizontal rule eTomo drops between field groups.
export component Separator inherits Rectangle {
    height: 2px;
    background: EtomoStyle.border;
}

// `EtchedBorder` (`EtchedBorder.java`) on a panel, bridged: drawn only while
// the Swing panel with that border title shows (`visible-value` "brd").  An
// untitled `BorderFactory.createEtchedBorder()` has `title` "" and always shows.
export component BridgedEtchedBorder inherits Rectangle {
    in property <string> title;
    out property <bool> shown-visible: !EtomoBridge.wired || root.title == ""
        || EtomoBridge.visible-value("brd", root.title, true, EtomoBridge.generation);
    height: root.shown-visible ? etched-layout.preferred-height : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    border-color: EtomoStyle.border;
    ContextArea { kind: "brd"; label: root.title; visible: root.shown-visible; }
    etched-layout := VerticalLayout {
        visible: root.shown-visible;
        padding: EtomoStyle.inset;
        spacing: EtomoStyle.row-gap;
        if root.title != "": Text {
            text: root.title;
            font-size: EtomoStyle.font-size-pt * 1px;
            color: EtomoStyle.text;
        }
        @children
    }
}

// `SingleLineButton` (`SingleLineButton.java`) and `Ebutton.getSingleLineInstance`:
// a one-line button named "bn." + its label.
export component SingleLineButton inherits Rectangle {
    in property <string> text;
    in property <string> occurrence;
    in property <bool> enabled: true;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("bn", root.text + root.occurrence, true, EtomoBridge.generation);
    height: root.shown-visible ? EtomoStyle.field-height + 4px : 0px;
    width: root.shown-visible ? label.preferred-width + 20px : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    border-color: EtomoStyle.border;
    label := Text {
        visible: root.shown-visible;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
    area := BridgedButton {
        kind: "bn";
        label: root.text + root.occurrence;
        default-enabled: root.enabled;
    }
}

// The folder button of a file field (`ScaledImage.OPEN_FILE`; no icon is
// vendored, a glyph stands in), named "bn." + the field's label
// (`FileTextField2`: `button.setName(label)`; `FileTextField`: the same).
export component FolderButton inherits Rectangle {
    in property <string> label;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("bn", root.label, true, EtomoBridge.generation);
    width: root.shown-visible ? EtomoStyle.field-height + 4px : 0px;
    height: root.shown-visible ? EtomoStyle.field-height : 0px;
    background: EtomoStyle.panel;
    border-width: root.shown-visible ? 1px : 0px;
    border-color: EtomoStyle.border;
    Text {
        visible: root.shown-visible;
        text: "[]";
        horizontal-alignment: center;
        vertical-alignment: center;
        color: area.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
    }
    area := BridgedButton { kind: "bn"; label: root.label; }
}

// `FileTextField2` (`FileTextField2.java`): label (when `labeled`), text field
// and folder button, all named from the label.  `labeled` false for
// `getUnlabeledInstance`, whose label is only the name.
export component FileTextField2 inherits HorizontalLayout {
    in property <string> label;
    in property <bool> labeled: true;
    in property <length> field-width: 250px;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        if root.labeled: Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: field.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        field := BridgedTextBox {
            kind: "tf";
            label: root.label;
            preferred-width: root.field-width;
        }
        FolderButton { label: root.label; }
    }
}

// `CheckTextField` (`CheckTextField.java`): a check box carrying the label
// and a text field named from the same label.
export component CheckTextField inherits HorizontalLayout {
    in property <string> label;
    in property <length> field-width: 100px;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("cb", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        CheckBox { text: root.label; }
        BridgedTextBox { kind: "tf"; label: root.label; preferred-width: root.field-width; }
    }
}

// `RadioTextField` (`RadioTextField.java`): a radio button carrying the label
// and a text field named from the same label.  `occurrence` "#N" when the
// Java builds several with names that convert alike.
export component RadioTextField inherits HorizontalLayout {
    in property <string> label;
    in property <string> occurrence;
    in property <length> field-width: 60px;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("rb", root.label + root.occurrence, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        RadioButton { text: root.label; occurrence: root.occurrence; }
        BridgedTextBox {
            kind: "tf";
            label: root.label + root.occurrence;
            preferred-width: root.field-width;
        }
    }
}

// `SpinnerEfield` (`SpinnerEfield.java`): label then a spinner named
// "sp." + the label.
export component SpinnerEfield inherits HorizontalLayout {
    in property <string> label;
    in property <string> occurrence;
    in property <length> field-width: 50px;
    property <string> name: root.label + root.occurrence;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("sp", root.name, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        spacing: 0px;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: box.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        box := BridgedTextBox {
            kind: "sp";
            label: root.name;
            preferred-width: root.field-width;
        }
        Rectangle {
            width: 14px;
            height: EtomoStyle.field-height;
            background: EtomoStyle.panel;
            border-width: 1px;
            border-color: EtomoStyle.border;
            VerticalLayout {
                Text {
                    text: "^";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.name, true); } }
                }
                Text {
                    text: "v";
                    horizontal-alignment: center;
                    TouchArea { clicked => { EtomoBridge.toggled("sp", root.name, false); } }
                }
            }
        }
    }
}

// `ComboBox` (`ComboBox.java`): rigid 2px, the label, rigid 3px, the combo
// box, rigid 2px (`ComboBox.createPanel`), named "cbb." + the label.
export component ComboBox inherits HorizontalLayout {
    in property <string> label;
    property <bool> shown-visible: !EtomoBridge.wired
        || EtomoBridge.visible-value("cbb", root.label, true, EtomoBridge.generation);
    if root.shown-visible: HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 3px;
        Text {
            text: root.label;
            horizontal-stretch: 0;
            vertical-alignment: center;
            color: box.shown-enabled ? EtomoStyle.text : EtomoStyle.disabled-text;
        }
        box := BridgedComboBox { kind: "cbb"; label: root.label; preferred-width: 250px; }
    }
}

// A `JSeparator` the Java adds to a column, drawn while `shown`.
export component OptionalSeparator inherits Rectangle {
    in property <bool> shown: true;
    height: root.shown ? 2px : 0px;
    background: root.shown ? EtomoStyle.border : transparent;
}
