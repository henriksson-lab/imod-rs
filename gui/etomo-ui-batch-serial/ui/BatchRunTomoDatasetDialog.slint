// Mirrors `IMOD/Etomo/src/etomo/ui/swing/BatchRunTomoDatasetDialog.java`
// (`createPanel`, :334-711).
//
// The Java class is one panel used two ways: `getGlobalInstance` embeds it in
// the batchruntomo "Dataset Values" tab with the header "Global Dataset
// Values" and no buttons; `getRowInstance` puts it in its own frame (the
// translation's non-modal `JDialog`, drawn over the main window by
// `MainFrame.slint`) with the header text " Dataset Values" (`phRoot.setText`,
// :264; the header keeps its name) and an OK / Revert to Global row.  Both are
// drawn here, selected by `global`.
//
// In advanced mode (`updateAdvanced`) pnlRootBody holds the
// `DirectivesDialog` (`DirectivesDialog.slint`) instead of pnlBasic.
//
// Wired through `EtomoBridge`: every widget by the label the Java gives it.
// Labels that convert to the same uitest name carry "#N" in tree order:
// "Bead size (nm): " (#1 alignment, #2 positioning), "Tomogram thickness" (#1
// positioning, #2 gold erasing), "Thickness total" (#1 unbinned, #2 binned).

import { EtomoStyle, EtomoBridge, PanelHeader, CheckBox, RadioButton, LabeledTextField,
         LabeledSpinner }
    from "../../etomo-ui-common/ui/widgets.slint";
import { BridgedEtchedBorder, Separator, SingleLineButton, FileTextField2,
         CheckTextField, RadioTextField }
    from "LocalWidgets.slint";
import { DirectivesDialog } from "DirectivesDialog.slint";

export component BatchRunTomoDatasetDialog inherits Rectangle {
    // getGlobalInstance vs getRowInstance / getSavedRowInstance.
    in property <bool> global: true;
    // Wired: the distortion fields exist (a distortion directory exists,
    // :228-239); without them btnAdvanced sits on the Remove X-rays row.
    property <bool> has-distort: !EtomoBridge.wired
        || EtomoBridge.visible-value("tf", "Image distortion file: ", false, EtomoBridge.generation);
    // pnlBasic is in pnlRootBody (basic mode).
    property <bool> basic-shown: !EtomoBridge.wired
        || EtomoBridge.visible-value("cb", "Remove X-rays", true, EtomoBridge.generation);

    background: EtomoStyle.panel;
    // pnlRoot.setBorder(BorderFactory.createEtchedBorder())
    border-width: 1px;
    border-color: EtomoStyle.border;

    VerticalLayout {
        padding: 2px;
        alignment: start;
        spacing: EtomoStyle.row-gap;

        ph-root := PanelHeader {
            name-label: "Global Dataset Values";
            title: root.global ? "Global Dataset Values" : " Dataset Values";
        }
        Rectangle { height: 2px; }

        // pnlRootBody
        if ph-root.shown-open && root.basic-shown: VerticalLayout {
            spacing: EtomoStyle.row-gap;
            alignment: start;
            // pnlDistort: ftfDistort, btnAdvanced.
            if root.has-distort: HorizontalLayout {
                alignment: start;
                FileTextField2 { label: "Image distortion file: "; }
                SingleLineButton { text: "Advanced"; }
            }
            if root.has-distort: HorizontalLayout {
                alignment: start;
                FileTextField2 { label: "Mag gradient file: "; field-width: 272px; }
            }
            Rectangle { height: 3px; }
            // sDistortion
            Separator { }
            // pnlRemoveXrays: cbRemoveXrays, glue, (btnAdvanced).
            HorizontalLayout {
                CheckBox { text: "Remove X-rays"; }
                Rectangle { horizontal-stretch: 1; }
                if !root.has-distort: SingleLineButton { text: "Advanced"; }
            }
            // pnlModelFile: ftfModelFile, a 5-pixel spacer, btnModelFile, glue.
            HorizontalLayout {
                alignment: start;
                FileTextField2 { label: "Manual replacement model: "; }
                Rectangle { width: 5px; }
                SingleLineButton { text: "Make in 3dmod"; }
            }
            Rectangle { height: 3px; }
            Separator { }
            Rectangle { height: 5px; }
            // pnlPreBinByFactor: lsPrenewstBinByFactor, 15 pixels, lsPreblendBinByFactor.
            HorizontalLayout {
                alignment: start;
                LabeledSpinner { label: "Coarse aligned stack binning - single frame: "; }
                Rectangle { width: 15px; }
                LabeledSpinner { label: "Montage: "; }
            }
            Rectangle { height: 10px; }
            // pnlTrackingMethod: GridLayout(2, 2), EtchedBorder("Alignment Method").
            BridgedEtchedBorder {
                title: "Alignment Method";
                GridLayout {
                    Row {
                        RadioButton { text: "Autoseed and track"; }
                        RadioButton { text: "Patch tracking"; }
                    }
                    Row {
                        RadioButton { text: "Raptor and track"; }
                        RadioButton { text: "Coarse alignment only"; }
                    }
                }
            }
            Rectangle { height: 3px; }
            // pnlGold: GridLayout(1, 2, 15, 1): ltfGold and, by tracking method,
            // ltfTargetNumberOfBeads or ltfNumberOfMarkers (same label).
            GridLayout {
                spacing: 15px;
                Row {
                    LabeledTextField { label: "Bead size (nm): "; occurrence: "#1"; }
                    LabeledTextField { label: "Target number of beads: "; }
                }
            }
            // pnlSizeOfPatchesXandY: GridLayout(1, 2, 15, 0).
            GridLayout {
                spacing: 15px;
                Row {
                    LabeledTextField { label: "Patch tracking size: "; }
                    CheckBox { text: "Break contours into pieces"; }
                }
            }
            Rectangle { height: 10px; }
            HorizontalLayout { alignment: start; CheckBox { text: "Enable distortion (stretching) in alignment"; } }
            HorizontalLayout { alignment: start; CheckBox { text: "Use local alignments"; } }
            Rectangle { height: 1px; }
            Separator { }
            Rectangle { height: 3px; }
            // pnlSampleType: pnlSampleTypeChooser, 3 pixels, pnlSampleTypeData.
            HorizontalLayout {
                alignment: start;
                CheckBox { text: "Do positioning for:"; }
                Rectangle { width: 5px; }
                RadioButton { text: "Plastic section"; }
                Rectangle { width: 5px; }
                RadioButton { text: "Cryo sample"; }
            }
            Rectangle { height: 3px; }
            // pnlSampleTypeData: GridLayout(1, 3, 15, 5).
            GridLayout {
                spacing: 15px;
                Row {
                    LabeledTextField { label: "Tomogram thickness: "; occurrence: "#1"; }
                    CheckBox { text: "Sample has gold beads"; }
                    LabeledTextField { label: "Bead size (nm): "; occurrence: "#2"; }
                }
            }
            Rectangle { height: 3px; }
            Separator { }
            Rectangle { height: 3px; }
            // pnlBinByFactor
            HorizontalLayout { alignment: start; LabeledSpinner { label: "Aligned stack binning: "; } }
            Rectangle { height: 5px; }
            // pnlAlignedStack: GridLayout(5, 2, 15, 0).
            GridLayout {
                spacing-horizontal: 15px;
                Row {
                    CheckBox { text: "Correct CTF"; }
                    CheckBox { text: "Erase gold"; }
                }
                Row {
                    // pnlDefocus: ltfDefocus, cbTuneFittingAndSampling.
                    HorizontalLayout {
                        LabeledTextField { label: "Defocus: "; }
                        CheckBox { text: "Autotune"; }
                    }
                    RadioButton { text: "Use fiducial model"; }
                }
                Row {
                    LabeledTextField { label: "Defocus range to scan: "; }
                    RadioButton { text: "Find beads in 3D"; }
                }
                Row {
                    // pnlAutoFitRangeAndStep: rtfAutoFitRangeAndStep, ltfAutoFitStep.
                    HorizontalLayout {
                        RadioTextField { label: "Autofit range "; }
                        LabeledTextField { label: " and step "; }
                    }
                    LabeledTextField { label: "Tomogram thickness (pixels): "; occurrence: "#2"; }
                }
                Row {
                    RadioButton { text: "Fit every image"; }
                }
            }
            Rectangle { height: 5px; }
            // pnlReconstruction: EtchedBorder("Reconstruction"), X_AXIS:
            // pnlReconstructionType, 12 pixels, pnlThickness.
            BridgedEtchedBorder {
                title: "Reconstruction";
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        alignment: start;
                        CheckBox { text: "R-weighted backprojection"; }
                        CheckBox { text: "SIRT-like filter"; }
                        CheckBox { text: "SIRT"; }
                        Rectangle { height: 6px; }
                        LabeledTextField { label: "Equivalent iterations: "; }
                        LabeledTextField { label: "Leave iterations: "; }
                        CheckBox { text: "Scale to integers"; }
                    }
                    Rectangle { width: 12px; }
                    VerticalLayout {
                        alignment: start;
                        RadioTextField { label: "Thickness total (unbinned pixels): "; occurrence: "#1"; }
                        Rectangle { height: 2px; }
                        RadioTextField { label: "Thickness total (binned pixels): "; occurrence: "#2"; }
                        Rectangle { height: 2px; }
                        RadioButton { text: "Calculated thickness (unbinned pixels):"; }
                        LabeledTextField { label: "          With fallback: "; }
                        LabeledTextField { label: "          Plus (optional): "; }
                    }
                }
            }
            // pnlPostprocessing (etched): phPostprocessing, pnlPostprocessingBody.
            BridgedEtchedBorder {
                title: "";
                ph-post := PanelHeader { title: "Postprocessing"; open: false; }
                if ph-post.shown-open: VerticalLayout {
                    HorizontalLayout { alignment: start; CheckBox { text: "Postprocess with trimvol"; } }
                    HorizontalLayout {
                        alignment: start;
                        CheckTextField { label: "Find plastic section limits and add: "; }
                        Rectangle { width: 3px; }
                        CheckTextField { label: "Fraction of Z slices to analyze:"; }
                    }
                }
            }
            // pnlButtons (row instance): glue, OK, 20 pixels, Revert to Global.
            if !root.global: HorizontalLayout {
                alignment: end;
                SingleLineButton { text: "OK"; }
                Rectangle { width: 20px; }
                SingleLineButton { text: "Revert to Global"; }
            }
        }
        // Advanced: pnlRootBody holds the DirectivesDialog.
        if ph-root.shown-open && !root.basic-shown: DirectivesDialog { }
    }
}

export component BatchRunTomoDatasetDialogWindow inherits Window {
    in property <bool> global: true;
    title: root.global ? "Batchruntomo Dataset Values" : "Dataset Values";
    background: EtomoStyle.background;
    preferred-width: 900px;
    preferred-height: 900px;
    BatchRunTomoDatasetDialog { global: root.global; }
}
