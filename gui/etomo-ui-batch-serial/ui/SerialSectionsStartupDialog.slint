// Mirrors `IMOD/Etomo/src/etomo/ui/swing/SerialSectionsStartupDialog.java`
// (the modal "Starting Serial Sections" JDialog, `createPanel`, :124-209).
//
// Wired through `EtomoBridge` (`ui/swing/slint_bridge.rs`): every widget is
// identified by the label the Java gives it.  The main frame draws this over
// its content while the translated `JDialog` shows (`MainFrame.slint`,
// `startup-dialog`).  Unwired, the widgets show the Java's construction-time
// state.

import { EtomoStyle, CheckBox, RadioButton, MultiLineButton, LabeledSpinner,
         BridgedTextBox, BridgedButton }
    from "../../etomo-ui-common/ui/widgets.slint";
import { EtchedBorder } from "LocalWidgets.slint";

// `FileTextField2.getInstance(manager, label)` (`FileTextField2.java`): the
// label, the entry box and the folder button (bridged as "fbn", the button
// beside the field labelled `label`).
component StartupFileTextField inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 50px;
    in property <length> field-width: 250px;
    spacing: EtomoStyle.gap;
    alignment: start;
    Text {
        text: root.label;
        width: root.label-width;
        vertical-alignment: center;
        font-size: EtomoStyle.font-size-pt * 1px;
    }
    BridgedTextBox { kind: "tf"; label: root.label; width: root.field-width; }
    Rectangle {
        width: 26px;
        height: EtomoStyle.field-height;
        background: EtomoStyle.panel;
        border-width: 1px;
        border-color: EtomoStyle.border;
        Text { text: "..."; horizontal-alignment: center; vertical-alignment: center; }
        BridgedButton { kind: "fbn"; label: root.label; }
    }
}

export component SerialSectionsStartupDialog inherits Rectangle {
    background: EtomoStyle.panel;
    VerticalLayout {
        padding: EtomoStyle.inset;
        alignment: start;

        // pnlRoot.add(Box.createRigidArea(FixedDim.x0_y10))
        Rectangle { height: 10px; }

        // ftfStack = FileTextField2.getInstance(manager, "Stack: ")
        StartupFileTextField { label: "Stack: "; label-width: 50px; field-width: 320px; }

        Rectangle { height: 30px; }

        // pnlViewTypeX: 5px indent, then the "Frame Type" group box.
        // `RadioButton(String, EnumeratedType, ButtonGroup)` selects the
        // enum's default (`ViewType.DEFAULT` is SINGLE_VIEW).
        HorizontalLayout {
            padding-left: 5px;
            alignment: start;
            EtchedBorder {
                title: "Frame Type";
                RadioButton { text: "Single frame"; selected: true; }
                RadioButton { text: "Montage"; }
            }
        }

        Rectangle { height: 10px; }

        // pnlMdocMetadata: cbMdocMetadataFile starts disabled
        // (createPanel: cbMdocMetadataFile.setEnabled(false)).
        HorizontalLayout {
            padding-left: 5px;
            alignment: start;
            CheckBox {
                text: "Extract montage piece list from .mdoc file";
                enabled: false;
            }
        }

        Rectangle { height: 10px; }

        // pnlImage: distortion field file then the binning spinner.
        HorizontalLayout {
            padding-left: 5px;
            spacing: 5px;
            alignment: start;
            StartupFileTextField {
                label: "Image distortion field file: ";
                label-width: 170px;
                field-width: 175px;
            }
            LabeledSpinner {
                label: "Binning: ";
                text: "1";
            }
        }

        Rectangle { height: 30px; }

        // pnlButtons
        HorizontalLayout {
            spacing: 15px;
            alignment: start;
            MultiLineButton { text: "OK"; width: 80px; }
            MultiLineButton { text: "Cancel"; width: 80px; }
        }

        // pnlStatus: BorderLayout with busyStatusPanel at EAST.  BusyStatusPanel
        // is a JLabel carrying an animated icon (`BusyStatusPanel.java:31`);
        // no icon is vendored, so the strip is drawn empty and right-aligned.
        HorizontalLayout {
            alignment: end;
            Rectangle { width: 20px; height: 20px; }
        }
    }
}

export component SerialSectionsStartupDialogWindow inherits Window {
    title: "Starting Serial Sections";
    background: EtomoStyle.background;
    preferred-width: 620px;
    preferred-height: 380px;
    SerialSectionsStartupDialog { }
}
