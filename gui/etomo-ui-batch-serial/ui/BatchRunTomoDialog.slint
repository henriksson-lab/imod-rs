// Mirrors `IMOD/Etomo/src/etomo/ui/swing/BatchRunTomoDialog.java`, the
// batchruntomo interface: a BeveledBorder("Batchruntomo Interface") around a
// `TabbedPane` with the four `etomo.ui.BatchRunTomoTab` tabs -- "Batch Setup",
// "Stacks", "Dataset Values" and "Run" (`createPanel`, :343-700).
//
// Panels the dialog builds from neighbouring Swing classes and that are drawn
// inline here: `TemplatePanel.getBorderlessInstance` (Batch Setup),
// `BatchRunTomoTable` (Stacks / Dataset Values / Run) and
// `BatchRunTomoStepPanel` (Run).  The Dataset Values tab embeds the global
// `BatchRunTomoDatasetDialog` (`BatchRunTomoDatasetDialog.slint`), the Run tab
// the `SeriesWatcherPanel` (`SeriesWatcherPanel.slint`) and the
// `parallelStatusPanel` the manager's `MainPanel` made (`ParallelPanel.slint`,
// non-runnable title "Resources").
//
// Wired through `EtomoBridge` (`ui/swing/slint_bridge.rs`): every widget is
// identified by the label the Java gives it.  Swing shows one tab body at a
// time (`changeTab` moves the table between the tab panels); the selected tab
// of the Swing `TabbedPane` (`BridgedTabbedPane.shown-current`) chooses the
// body drawn.  A widget the Java has not built, or has hidden, takes no room
// (`visible-value`).  The table is the `BatchRunTomoTable` grid, found as the
// panel holding the "#" header cell ("child:hc.#"), drawn by `BridgedTable`
// from the real rows.

import { EtomoStyle, EtomoBridge, BeveledBorder, PanelHeader, CheckBox, RadioButton,
         LabeledTextField, BridgedTabbedPane, BridgedTable, BridgedLabel }
    from "../../etomo-ui-common/ui/widgets.slint";
import { BridgedEtchedBorder, SingleLineButton, FileTextField2, CheckTextField,
         SpinnerEfield, ComboBox, FolderButton }
    from "LocalWidgets.slint";
import { BatchRunTomoDatasetDialog } from "BatchRunTomoDatasetDialog.slint";
import { SeriesWatcherPanel } from "SeriesWatcherPanel.slint";
import { ParallelPanel, ParallelPanelRow }
    from "../../etomo-ui-main-window/ui/ParallelPanel.slint";
import { BridgedTextBox } from "../../etomo-ui-common/ui/widgets.slint";

// `BatchRunTomoTable`'s root panel (`BatchRunTomoTable.java:208-283`): pnlView
// (the viewport's paging panel and pnlTable, the grid), a 5-pixel rigid area and
// pnlStackButtons (glue, Add Stack(s), glue, Copy Down, glue, Delete, glue).
// The paging buttons (`Viewport.getPagingPanel`, six unnamed buttons) are
// hidden while the table fits.
component BatchTable inherits VerticalLayout {
    spacing: 0px;
    alignment: start;
    BridgedTable { table: "child:hc.#"; cell-width: 64px; }
    Rectangle { height: 5px; }
    HorizontalLayout {
        alignment: space-around;
        SingleLineButton { text: "Add Stack(s)"; }
        SingleLineButton { text: "Copy Down"; }
        SingleLineButton { text: "Delete"; }
    }
}

// BatchRunTomoTab.BATCH, "Batch Setup": pnlBatch (:430-438, :597-625).
component BatchSetupTab inherits VerticalLayout {
    alignment: start;
    BridgedEtchedBorder {
        title: "Batch Setup Parameters";
        // pnlDeliver
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            alignment: start;
            HorizontalLayout { alignment: start; RadioButton { text: "Stacks are already in dataset directories"; } }
            // pnlDeliverToDirectory: rbDeliverToDirectory, then the unlabeled
            // ftfDeliverToDirectory named from the same label.
            HorizontalLayout {
                RadioButton { text: "Move all stacks to dataset directories under: "; }
                FileTextField2 { label: "Move all stacks to dataset directories under: "; labeled: false; }
            }
            HorizontalLayout { alignment: start; RadioButton { text: "Move stacks to dataset directories under their current locations"; } }
        }
        Rectangle { height: 20px; }
        // pnlInputDirectiveFile: ftfInputDirectiveFile, btnClearInputDirectiveFile,
        // a 100-pixel rigid area, glue.
        HorizontalLayout {
            FileTextField2 { label: "Starting directive file: "; }
            SingleLineButton { text: "Clear"; }
            Rectangle { width: 100px; }
        }
        Rectangle { height: 6px; }
        // pnlTemplates: TemplatePanel.getBorderlessInstance (`TemplatePanel.createPanel`).
        HorizontalLayout {
            alignment: start;
            VerticalLayout {
                spacing: EtomoStyle.row-gap;
                Rectangle { height: 2px; }
                ComboBox { label: "Scope template:"; }
                Rectangle { height: 3px; }
                ComboBox { label: "System template:"; }
                Rectangle { height: 3px; }
                ComboBox { label: "User template:"; }
                Rectangle { height: 2px; }
            }
        }
        Rectangle { height: 15px; }
        // pnlRootName
        BridgedEtchedBorder {
            title: "Batchruntomo Project Files";
            LabeledTextField { label: "Batchruntomo root name: "; }
            Rectangle { height: 2px; }
            FileTextField2 { label: "Location: "; }
        }
    }
}

// BatchRunTomoTab.STACKS, "Stacks": pnlStacks (etched) holding pnlStacksTable,
// EtchedBorder(TABLE_LABEL), which holds the table (`changeTab`).
component StacksTab inherits VerticalLayout {
    alignment: start;
    BridgedEtchedBorder {
        title: "";
        BridgedEtchedBorder {
            title: "Datasets";
            BatchTable { }
        }
    }
}

// BatchRunTomoTab.DATASET, "Dataset Values": pnlDataset (etched): the global
// datasetDialog, then pnlDatasetTable (etched): phDatasetTable, a 2-pixel rigid
// area and pnlDatasetTableBody (the table while it is open).
component DatasetValuesTab inherits VerticalLayout {
    alignment: start;
    BridgedEtchedBorder {
        title: "";
        BatchRunTomoDatasetDialog { global: true; }
        // `setDatasetTableVisible(!advanced)`: hidden with the header.
        ph-dataset := PanelHeader { title: "Datasets"; }
        if ph-dataset.shown-visible: VerticalLayout {
            spacing: 0px;
            Rectangle { height: 2px; }
            if ph-dataset.shown-open: BatchTable { }
        }
    }
}

// `BatchRunTomoStepPanel` (`BatchRunTomoStepPanel.java:73-130`): a vertical
// strut of 8, pnlBody (EtchedBorder "Subset of Steps to Run": pnlStep, a strut
// of 5, pnlEnableStartingStep), glue.  pnlStep: pnlEndingStep, a strut of 5,
// pnlStartingStep; the radio labels come from `EndingStep`/`StartingStep`
// (`Step.java:20-28`).  "Fine alignment" and "Positioning" are in both groups:
// "#1" is the ending step's, "#2" the starting step's (tree order).
component StepPanel inherits VerticalLayout {
    alignment: start;
    Rectangle { height: 8px; }
    BridgedEtchedBorder {
        title: "Subset of Steps to Run";
        HorizontalLayout {
            spacing: 5px;
            alignment: start;
            VerticalLayout {
                alignment: start;
                CheckBox { text: "Stop after"; }
                RadioButton { text: "Tracking"; }
                RadioButton { text: "Fine alignment"; occurrence: "#1"; }
                RadioButton { text: "Positioning"; occurrence: "#1"; }
                RadioButton { text: "CTF/gold detection"; }
                RadioButton { text: "Finished stack"; }
            }
            VerticalLayout {
                alignment: start;
                CheckBox { text: "Start from"; }
                RadioButton { text: "Fine alignment"; occurrence: "#2"; }
                RadioButton { text: "Positioning"; occurrence: "#2"; }
                RadioButton { text: "Aligned stack"; }
                RadioButton { text: "Finish CTF/gold"; }
                RadioButton { text: "Reconstruction"; }
            }
        }
        Rectangle { height: 5px; }
        HorizontalLayout { alignment: start; CheckBox { text: "Enable starting from any step"; } }
    }
}

// BatchRunTomoTab.RUN, "Run": pnlRun (etched, :454-473).
component RunTab inherits VerticalLayout {
    in property <bool> show-parallel-panel: false;
    in property <[ParallelPanelRow]> parallel-rows: [];
    callback parallel-row-toggled(int);
    alignment: start;
    BridgedEtchedBorder {
        title: "";
        // parallelStatusPanel: the MainPanel's ParallelPanel ("Resources").
        if root.show-parallel-panel: HorizontalLayout {
            alignment: start;
            ParallelPanel {
                title: "Resources";
                pause-resume-here: false;
                rows: root.parallel-rows;
                row-toggled(row) => { root.parallel-row-toggled(row); }
            }
        }
        Rectangle { height: 2px; }
        // pnlResources: glue, pnlParallelSettings, glue, pnlSplitBatchOuter,
        // glue, pnlQueueModeOuter (only with queues).
        HorizontalLayout {
            alignment: space-around;
            VerticalLayout {
                alignment: start;
                BridgedEtchedBorder {
                    title: "Resources to Use";
                    CheckBox { text: "Use multiple cores"; }
                    RadioButton { text: "No GPU"; }
                    RadioButton { text: "Local GPU"; }
                    RadioButton { text: "Parallel GPUs"; }
                }
            }
            VerticalLayout {
                alignment: start;
                BridgedEtchedBorder {
                    title: "Multiple Jobs";
                    HorizontalLayout { alignment: start; CheckBox { text: "Run multiple batch jobs in parallel"; } }
                    // pnlNumberOfJobsToMake: spNumberOfJobsToMake, then
                    // spQueueNumberOfJobsToMake (with queues; same label), a
                    // 1-pixel rigid area and the " jobs" JLabel, glue.
                    HorizontalLayout {
                        alignment: start;
                        SpinnerEfield { label: "Run up to "; occurrence: "#1"; }
                        SpinnerEfield { label: "Run up to "; occurrence: "#2"; }
                        Rectangle { width: 1px; }
                        Text { text: " jobs"; vertical-alignment: center; color: EtomoStyle.text; }
                    }
                    // pnlMaxGPUsForOneJob
                    HorizontalLayout { alignment: start; SpinnerEfield { label: "Max # of GPUs to use by one job: "; } }
                    // pnlMaxGPUsForOneJobOne: lMaxGPUsForOneJobOne (hidden
                    // unless one GPU is the limit).
                    HorizontalLayout { alignment: start; BridgedLabel { prefix: "Max # of GPUs to use by one job: 1"; } }
                }
            }
            VerticalLayout {
                alignment: start;
                BridgedEtchedBorder {
                    title: "How a Batch Job Should Run Processes";
                    RadioButton { text: "Job submits processes to single-core queue"; }
                    RadioButton { text: "Job and its processes run directly on one node"; }
                    CheckBox { text: "Use one GPU on secondary queue"; }
                }
            }
        }
        Rectangle { height: 20px; }
        // pnlUseSeriesWatcher: cbUseSeriesWatcher, ftfWatchDirectory (an
        // unlabeled FileTextField named "Watch for stacks to run in: "), glue.
        HorizontalLayout {
            alignment: start;
            CheckBox { text: "Watch for stacks to run"; }
            BridgedTextBox { kind: "tf"; label: "Watch for stacks to run in: "; preferred-width: 595px; }
            FolderButton { label: "Watch for stacks to run in: "; }
        }
        Rectangle { height: 5px; }
        // pnlRunSettings (`buildRunSettingsPanel`): the series watcher panel
        // and a 2-pixel strut while "Watch for stacks to run" is selected,
        // glue, (a strut), stepPanel, glue.
        HorizontalLayout {
            alignment: center;
            spacing: 2px;
            SeriesWatcherPanel { }
            StepPanel { }
        }
        Rectangle { height: 15px; }
        // pnlEmail
        HorizontalLayout { alignment: start; CheckTextField { label: "Email notification: "; field-width: 300px; } }
        Rectangle { height: 25px; }
        // pnlRunButtons: Run, Pause (btnPause, or the parallel panel's), Resume
        // (likewise), Reset, separated by glue.  One of each pause/resume
        // pair shows at a time; the label finds the showing one.
        if !EtomoBridge.wired || EtomoBridge.visible-value("bn", "Run", true, EtomoBridge.generation): HorizontalLayout {
            alignment: space-around;
            SingleLineButton { text: "Run"; }
            SingleLineButton { text: "Pause"; }
            SingleLineButton { text: "Resume"; }
            SingleLineButton { text: "Reset"; }
        }
        // pnlSeriesWatcherRunButtons
        if !EtomoBridge.wired || EtomoBridge.visible-value("bn", "Start Watching", true, EtomoBridge.generation): HorizontalLayout {
            alignment: space-around;
            SingleLineButton { text: "Start Watching"; }
            SingleLineButton { text: "Finish"; }
            SingleLineButton { text: "Reset"; }
        }
        Rectangle { height: 10px; }
        // pnlRunTable (etched): phRunTable, a 2-pixel rigid area, pnlRunTableBody.
        BridgedEtchedBorder {
            title: "";
            ph-run := PanelHeader { title: "Datasets"; }
            Rectangle { height: 2px; }
            if ph-run.shown-open: BatchTable { }
        }
    }
}

export component BatchRunTomoDialog inherits Rectangle {
    in property <bool> show-parallel-panel: false;
    in property <[ParallelPanelRow]> parallel-rows: [];
    callback parallel-row-toggled(int);
    background: EtomoStyle.background;
    VerticalLayout {
        alignment: start;
        BeveledBorder {
            title: "Batchruntomo Interface";
            tabs := BridgedTabbedPane {
                tabs: ["Batch Setup", "Stacks", "Dataset Values", "Run"];
                current: 0;
                if tabs.shown-current == 0: BatchSetupTab { }
                if tabs.shown-current == 1: StacksTab { }
                if tabs.shown-current == 2: DatasetValuesTab { }
                if tabs.shown-current == 3: RunTab {
                    show-parallel-panel: root.show-parallel-panel;
                    parallel-rows: root.parallel-rows;
                    parallel-row-toggled(row) => { root.parallel-row-toggled(row); }
                }
            }
        }
    }
}

export component BatchRunTomoDialogWindow inherits Window {
    title: "Batchruntomo Interface";
    background: EtomoStyle.background;
    preferred-width: 1060px;
    preferred-height: 860px;
    BatchRunTomoDialog { }
}
