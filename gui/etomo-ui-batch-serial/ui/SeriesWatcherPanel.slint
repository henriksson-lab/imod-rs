// Mirrors `IMOD/Etomo/src/etomo/ui/swing/SeriesWatcherPanel.java`
// (`createPanel`, :128-195), the serieswatcher parameter panel
// `BatchRunTomoDialog` builds in its constructor and adds to pnlRunSettings
// ahead of the step panel while "Watch for stacks to run" is selected
// (`buildRunSettingsPanel`).
//
// pnlRoot: a 15-pixel rigid area, pnlHeader (etched: the advanced/basic-only
// `PanelHeader` "Series Watching Mode", pnlBody), glue.  pnlBody: 5 pixels,
// pnlSettings (Dual axis, 3 pixels, Fiducials on 2 surfaces), 15 pixels,
// pnlMatchPatternOrExt (root name field, 10 pixels, extension field), the three
// pairing radio buttons (Separate B first, as `createPanel` adds them), 10
// pixels, pnlMatchString ("File name match string: " and the run-time
// `lMatchString`), 15 pixels, the three minimum fields (advanced only).
//
// Wired through `EtomoBridge`: the panel is drawn while its "Dual axis" check box shows (the
// panel is in pnlRunSettings); `lMatchString`, an unnamed `JLabel` whose text
// `buildMatchPatternOrExt` sets, is read as the label after "File name match
// string: " (kind "lnx").

import { EtomoStyle, EtomoBridge, PanelHeader, CheckBox, RadioButton, LabeledTextField,
         BridgedLabel }
    from "../../etomo-ui-common/ui/widgets.slint";
import { BridgedEtchedBorder } from "LocalWidgets.slint";

export component SeriesWatcherPanel inherits VerticalLayout {
    property <bool> shown: !EtomoBridge.wired
        || EtomoBridge.visible-value("cb", "Dual axis", true, EtomoBridge.generation);
    spacing: 0px;
    alignment: start;
    if root.shown: Rectangle { height: 15px; }
    if root.shown: BridgedEtchedBorder {
        title: "";
        PanelHeader { title: "Series Watching Mode"; }
        VerticalLayout {
            spacing: EtomoStyle.row-gap;
            alignment: start;
            Rectangle { height: 5px; }
            HorizontalLayout {
                alignment: start;
                CheckBox { text: "Dual axis"; }
                Rectangle { width: 3px; }
                CheckBox { text: "Fiducials on 2 surfaces"; }
            }
            Rectangle { height: 15px; }
            HorizontalLayout {
                alignment: start;
                LabeledTextField { label: "Do stacks with root names matching "; width: 330px; }
                Rectangle { width: 10px; }
                LabeledTextField { label: "Extension: "; width: 120px; }
            }
            HorizontalLayout { alignment: start; RadioButton { text: "Do two runs: A axis first; then B axis and combine"; } }
            HorizontalLayout { alignment: start; RadioButton { text: "Do both axes in one run OR Do B axis and finish combine"; } }
            HorizontalLayout { alignment: start; RadioButton { text: "Do A axis only"; } }
            Rectangle { height: 10px; }
            // pnlMatchString: lMatchStringLabel, lMatchString (font 2 points
            // larger), glue.
            HorizontalLayout {
                alignment: start;
                Text { text: "File name match string: "; vertical-alignment: center; color: EtomoStyle.text; }
                BridgedLabel { kind: "lnx"; prefix: "File name match string: "; }
            }
            Rectangle { height: 15px; }
            LabeledTextField { label: "Minimum range of tilt angles (degrees): "; }
            LabeledTextField { label: "Minimum number of views: "; }
            LabeledTextField { label: "Minimum time to wait if no .openTS (sec): "; }
        }
    }
}
