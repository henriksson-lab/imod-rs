// Mirrors `IMOD/Etomo/src/etomo/ui/swing/MainJoinPanel.java`, a `MainPanel`
// subclass.  It instantiates the base component from `MainPanel.slint` and
// puts its one axis column in the base's `panelCenter` slot:
//
// `MainJoinPanel(JoinManager)` (`:110-112`) only forwards to `super(manager)`;
// `createAxisPanelA` (`:124-127`) builds a `JoinProcessPanel` for the axis it is
// handed, and `addAxisPanelA` (`:172-175`) puts its container in `scrollA`.
//
// `createAxisPanelB` is an empty body (`:130`) and `getAxisPanelB()`
// returns null (`:137-140`), so `axisPanelB` is never constructed even though
// `addAxisPanelB`/`hideAxisPanelB`/`showAxisPanelB` exist — the B column is
// genuinely absent, not omitted.  `getDataFileFilter()` returns a
// `JoinFileFilter` and `setStatusBarText` (`:154-164`) blanks the status bar
// when the metadata is null or invalid, both of which are run-time text.
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { MainPanel } from "MainPanel.slint";
import { JoinProcessPanel } from "JoinProcessPanel.slint";

export component MainJoinPanel inherits Rectangle {
    in property <string> status-bar-text: "No data set loaded";
    in property <color> panel-background: Colors.violet;
    background: EtomoStyle.background;
    MainPanel {
        width: 100%;
        height: 100%;
        status-bar-text: root.status-bar-text;
        panel-background: root.panel-background;
        // `addAxisPanelA()`: `getScrollA().add(axisPanelA.getContainer())`.
        JoinProcessPanel {
            panel-background: root.panel-background;
        }
        // `createAxisPanelB` has an empty body and `getAxisPanelB()` returns
        // null, so there is no B column to draw.
    }
}

export component MainJoinPanelWindow inherits Window {
    title: "eTomo MainJoinPanel";
    preferred-width: 800px;
    preferred-height: 600px;
    background: EtomoStyle.background;
    MainJoinPanel { }
}
