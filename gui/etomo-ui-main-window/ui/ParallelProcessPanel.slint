// Mirrors `IMOD/Etomo/src/etomo/ui/swing/ParallelProcessPanel.java`, an `AxisProcessPanel`
// subclass.  It instantiates the base component from
// `AxisProcessPanel.slint` with the flags its constructor passes to
// `super`, and adds nothing to `panelProcessSelect`:
//
// `super(AxisID.ONLY, manager, true, true, InterfaceType.PP, false,
//  axisProgressPanel)` then `createProcessControlPanel()`, `showBothAxis()`
//  and `initializePanels()` (`:17-23`).
//
// Overrides `showBothAxis()` (`:25-28`) to
// `setBackground(Colors.getBackgroundParallel())` — `new Color(186, 224, 173)`
// "lime" (`Colors.java:181-191`).  Not in the original task list, but
// `MainParallelPanel.createAxisPanelA` (`MainParallelPanel.java:41-44`)
// constructs it, so it is drawn rather than stubbed.
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { AxisProcessPanel } from "AxisProcessPanel.slint";

export component ParallelProcessPanel inherits Rectangle {
    in property <color> panel-background: Colors.background-parallel;
    background: root.panel-background;
    AxisProcessPanel {
        width: 100%;
        height: 100%;
        axis-id: "ONLY";
        panel-background: root.panel-background;
        alt-parallel-loc: false;
    }
}

export component ParallelProcessPanelWindow inherits Window {
    title: "eTomo ParallelProcessPanel";
    preferred-width: 700px;
    preferred-height: 500px;
    background: EtomoStyle.background;
    ParallelProcessPanel { }
}
