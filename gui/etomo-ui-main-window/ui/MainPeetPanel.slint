// Mirrors `IMOD/Etomo/src/etomo/ui/swing/MainPeetPanel.java`, a `MainPanel`
// subclass.  It instantiates the base component from `MainPanel.slint` and
// puts its one axis column in the base's `panelCenter` slot:
//
// `MainPeetPanel(BaseManager)` (`:39-41`) forwards to `super(manager)`;
// `createAxisPanelA` (`:61-64`) builds a `PeetProcessPanel`, and
// `addAxisPanelA` (`:43-46`) puts its container in `scrollA`.
//
// `createAxisPanelB` is empty (`:67`) and `getAxisPanelB()` returns null,
// so there is no B column.  `getDataFileFilter()` returns a `PeetFileFilter`.
//

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { MainPanel } from "MainPanel.slint";
import { PeetProcessPanel } from "PeetProcessPanel.slint";

export component MainPeetPanel inherits Rectangle {
    in property <string> status-bar-text: "No data set loaded";
    in property <color> panel-background: Colors.default-panel;
    // Rust-only wiring: false when the main window draws the progress panel
    // in the dialog column (`MainFrameWindow`).
    in property <bool> show-status-panel: true;
    background: EtomoStyle.background;
    MainPanel {
        width: 100%;
        height: 100%;
        status-bar-text: root.status-bar-text;
        panel-background: root.panel-background;
        // `addAxisPanelA()`: `getScrollA().add(axisPanelA.getContainer())`.
        PeetProcessPanel {
            panel-background: root.panel-background;
            show-status-panel: root.show-status-panel;
        }
        // `createAxisPanelB` has an empty body and `getAxisPanelB()` returns
        // null, so there is no B column to draw.
    }
}

export component MainPeetPanelWindow inherits Window {
    title: "eTomo MainPeetPanel";
    preferred-width: 800px;
    preferred-height: 600px;
    background: EtomoStyle.background;
    MainPeetPanel { }
}
