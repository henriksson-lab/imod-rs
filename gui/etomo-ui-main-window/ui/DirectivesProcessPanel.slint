// Mirrors `IMOD/Etomo/src/etomo/ui/swing/DirectivesProcessPanel.java`, an `AxisProcessPanel`
// subclass.  It instantiates the base component from
// `AxisProcessPanel.slint` with the flags its constructor passes to
// `super`, and adds nothing to `panelProcessSelect`:
//
// `super(AxisID.ONLY, manager, true, true, interfaceType, false,
//  axisProgressPanel)` then `createProcessControlPanel()`, `showBothAxis()`
//  and `initializePanels()` (`:16-22`).
//
// Overrides nothing: it calls `showBothAxis()` but does not override it, and
// the base implementation is empty (`AxisProcessPanel.java:336`), so no
// background is ever set and the panel keeps the Metal default grey.  Nothing
// in the vendored tree constructs this class — it is a dead class upstream,
// translated because it is a source unit in this family.
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { AxisProcessPanel } from "AxisProcessPanel.slint";

export component DirectivesProcessPanel inherits Rectangle {
    in property <color> panel-background: Colors.default-panel;
    background: root.panel-background;
    AxisProcessPanel {
        width: 100%;
        height: 100%;
        axis-id: "ONLY";
        panel-background: root.panel-background;
        alt-parallel-loc: false;
    }
}

export component DirectivesProcessPanelWindow inherits Window {
    title: "eTomo DirectivesProcessPanel";
    preferred-width: 700px;
    preferred-height: 500px;
    background: EtomoStyle.background;
    DirectivesProcessPanel { }
}
