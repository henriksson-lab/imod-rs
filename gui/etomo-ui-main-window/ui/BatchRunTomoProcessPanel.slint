// Mirrors `IMOD/Etomo/src/etomo/ui/swing/BatchRunTomoProcessPanel.java`, an `AxisProcessPanel`
// subclass.  It instantiates the base component from
// `AxisProcessPanel.slint` with the flags its constructor passes to
// `super`, and adds nothing to `panelProcessSelect`:
//
// `super(AxisID.ONLY, manager, true, false, interfaceType, true,
//  axisProgressPanel)` then `createProcessControlPanel()`, `showBothAxis()`
//  and `initializePanels()` (`:19-25`).  It is the only subclass in this
//  family that passes `altParallelLoc` = true, so the base constructor does
//  not add `parallelStatusPanel` to `outerStatusPanel`
//  (`AxisProcessPanel.java:330-332`).
//
// Overrides `showBothAxis()` (`:27-30`) to
// `setBackground(Colors.getBackgroundBatchruntomo())`, which is
// `Colors.VIOLET` (`Colors.java:193-203`) — the same violet as the join
// interface.  `runnableParallel` is false here.
//

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { AxisProcessPanel } from "AxisProcessPanel.slint";

export component BatchRunTomoProcessPanel inherits Rectangle {
    in property <color> panel-background: Colors.violet;
    // Rust-only wiring: false when the main window draws the progress panel
    // in the dialog column (`MainFrameWindow`).
    in property <bool> show-status-panel: true;
    background: root.panel-background;
    AxisProcessPanel {
        width: 100%;
        height: 100%;
        axis-id: "ONLY";
        panel-background: root.panel-background;
        alt-parallel-loc: true;
        show-status-panel: root.show-status-panel;
    }
}

export component BatchRunTomoProcessPanelWindow inherits Window {
    title: "eTomo BatchRunTomoProcessPanel";
    preferred-width: 700px;
    preferred-height: 500px;
    background: EtomoStyle.background;
    BatchRunTomoProcessPanel { }
}
