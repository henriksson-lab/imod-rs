// Mirrors `IMOD/Etomo/src/etomo/ui/swing/MainBatchRunTomoPanel.java`, a `MainPanel`
// subclass.  It instantiates the base component from `MainPanel.slint` and
// puts its one axis column in the base's `panelCenter` slot:
//
// `MainBatchRunTomoPanel(BaseManager)` (`:25-28`) forwards to
// `super(manager)`; `createAxisPanelA` (`:38-42`) builds a
// `BatchRunTomoProcessPanel` with `InterfaceType.BATCH_RUN_TOMO`, and
// `addAxisPanelA` (`:30-33`) puts its container in `scrollA`.
//
// `createAxisPanelB` is empty (`:49`) and `getAxisPanelB()` returns null,
// so there is no B column.  `getDataFileFilter()` returns null.
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { MainPanel } from "MainPanel.slint";
import { BatchRunTomoProcessPanel } from "BatchRunTomoProcessPanel.slint";

export component MainBatchRunTomoPanel inherits Rectangle {
    in property <string> status-bar-text: "No data set loaded";
    in property <color> panel-background: Colors.violet;
    background: EtomoStyle.background;
    MainPanel {
        width: 100%;
        height: 100%;
        status-bar-text: root.status-bar-text;
        panel-background: root.panel-background;
        // `addAxisPanelA()`: `getScrollA().add(axisPanelA.getContainer())`.
        BatchRunTomoProcessPanel {
            panel-background: root.panel-background;
        }
        // `createAxisPanelB` has an empty body and `getAxisPanelB()` returns
        // null, so there is no B column to draw.
    }
}

export component MainBatchRunTomoPanelWindow inherits Window {
    title: "eTomo MainBatchRunTomoPanel";
    preferred-width: 800px;
    preferred-height: 600px;
    background: EtomoStyle.background;
    MainBatchRunTomoPanel { }
}
