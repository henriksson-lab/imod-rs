// Mirrors `IMOD/Etomo/src/etomo/ui/swing/FrontPageProcessPanel.java`, an `AxisProcessPanel`
// subclass.  It instantiates the base component from
// `AxisProcessPanel.slint` with the flags its constructor passes to
// `super`, and adds nothing to `panelProcessSelect`:
//
// `super(AxisID.ONLY, manager, true, true, InterfaceType.FRONT_PAGE, false,
//  axisProgressPanel)` then `initializePanels()` alone (`:28-33`).
//
// Overrides `createProcessControlPanel()` with an empty body (`:35-36`) and
// never calls it either, so `panelProcessSelect` stays empty — which for
// `AxisID.ONLY` is what the base would have produced anyway — and the panel
// keeps the Metal default grey.
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { AxisProcessPanel } from "AxisProcessPanel.slint";

export component FrontPageProcessPanel inherits Rectangle {
    in property <color> panel-background: Colors.default-panel;
    background: root.panel-background;
    AxisProcessPanel {
        width: 100%;
        height: 100%;
        axis-id: "ONLY";
        panel-background: root.panel-background;
        alt-parallel-loc: false;
    }
}

export component FrontPageProcessPanelWindow inherits Window {
    title: "eTomo FrontPageProcessPanel";
    preferred-width: 700px;
    preferred-height: 500px;
    background: EtomoStyle.background;
    FrontPageProcessPanel { }
}
