// Mirrors `IMOD/Etomo/src/etomo/ui/swing/DirectiveEditorProcessPanel.java`, an `AxisProcessPanel`
// subclass.  It instantiates the base component from
// `AxisProcessPanel.slint` with the flags its constructor passes to
// `super`, and adds nothing to `panelProcessSelect`:
//
// `super(AxisID.ONLY, manager, true, true, interfaceType, false,
//  axisProgressPanel)` then `createProcessControlPanel()`, `showBothAxis()`
//  and `initializePanels()` (`:19-25`).
//
// Overrides `showBothAxis()` (`:27-30`) to
// `setBackground(Colors.getBackgroundTools())` — the same azure the tools
// interface uses (`Colors.java:217-227`).
//
// Wired as part of the main window's "directive-editor" view (the
// `ManagerFrame` overlay in `MainFrame.slint`).

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { AxisProcessPanel } from "AxisProcessPanel.slint";

export component DirectiveEditorProcessPanel inherits Rectangle {
    in property <color> panel-background: Colors.background-tools;
    // Rust-only wiring: false when the main window draws the progress panel
    // in the dialog column (`MainFrameWindow`).
    in property <bool> show-status-panel: true;
    background: root.panel-background;
    AxisProcessPanel {
        width: 100%;
        height: 100%;
        axis-id: "ONLY";
        panel-background: root.panel-background;
        alt-parallel-loc: false;
        show-status-panel: root.show-status-panel;
    }
}

export component DirectiveEditorProcessPanelWindow inherits Window {
    title: "eTomo DirectiveEditorProcessPanel";
    preferred-width: 700px;
    preferred-height: 500px;
    background: EtomoStyle.background;
    DirectiveEditorProcessPanel { }
}
