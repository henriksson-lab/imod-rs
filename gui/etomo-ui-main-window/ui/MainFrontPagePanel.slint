// Mirrors `IMOD/Etomo/src/etomo/ui/swing/MainFrontPagePanel.java`, a `MainPanel`
// subclass.  It instantiates the base component from `MainPanel.slint` and
// puts its one axis column in the base's `panelCenter` slot:
//
// `MainFrontPagePanel(FrontPageManager)` (`:37-40`) forwards to
// `super(manager)`; `createAxisPanelA` (`:60-63`) builds a
// `FrontPageProcessPanel`, and `addAxisPanelA` (`:42-45`) puts its container
// in `scrollA`.
//
// `createAxisPanelB` is empty (`:66`) and `getAxisPanelB()` returns null,
// so there is no B column.  `setStatusBarText` (`:129-132`) overrides the base
// to show `metaData.getName()` alone, which is run-time text; the
// construction-time status bar is still the base "No data set loaded".
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { MainPanel } from "MainPanel.slint";
import { FrontPageProcessPanel } from "FrontPageProcessPanel.slint";

export component MainFrontPagePanel inherits Rectangle {
    in property <string> status-bar-text: "No data set loaded";
    in property <color> panel-background: Colors.default-panel;
    background: EtomoStyle.background;
    MainPanel {
        width: 100%;
        height: 100%;
        status-bar-text: root.status-bar-text;
        panel-background: root.panel-background;
        // `addAxisPanelA()`: `getScrollA().add(axisPanelA.getContainer())`.
        FrontPageProcessPanel {
            panel-background: root.panel-background;
        }
        // `createAxisPanelB` has an empty body and `getAxisPanelB()` returns
        // null, so there is no B column to draw.
    }
}

export component MainFrontPagePanelWindow inherits Window {
    title: "eTomo MainFrontPagePanel";
    preferred-width: 800px;
    preferred-height: 600px;
    background: EtomoStyle.background;
    MainFrontPagePanel { }
}
