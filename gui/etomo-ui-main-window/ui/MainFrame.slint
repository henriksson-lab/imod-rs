// Mirrors `IMOD/Etomo/src/etomo/ui/swing/MainFrame.java`, the eTomo
// application window.
//
// The constructor (`:505-531`) makes the content pane `rootPanel` a
// `BorderLayout` and caps it at twice the screen width less
// `FixedDim.frameBorder` (10 x 48, `:486`, `:509-512`, `FixedDim.java:116`), then
// calls `EtomoFrame.initialize()` (`EtomoFrame.java:54-59`), which builds
// `EtomoMenu.getInstance(this)` and hands its `JMenuBar` to `setJMenuBar`
// (`EtomoFrame.java:519-522`).  `setCurrentManager` (`:553-604`) empties
// `rootPanel` and adds `windowSwitch.getPanel(managerKey)`, which is the
// current manager's `MainPanel` when one window is open and a `TabbedPane`
// carrying it when several are (`WindowSwitch.java:174-187`).
//
// The menu bar structure below is `EtomoMenu.createPanel()`
// (`EtomoMenu.java:154-266`) taken along the `dataset = true, savable = true`
// path, which is the branch `EtomoMenu.getInstance(AbstractFrame)`
// (`:137-144`) uses — the one `MainFrame` gets.  Item labels, mnemonics and
// accelerators are verbatim.
//
// `WindowSwitch` also builds a `Menu("Window")` (`WindowSwitch.java:58`) and
// keeps a `CheckBoxMenuItem` per open window in it, but nothing adds that menu
// to the bar (upstream revision 3.19: "Removing the Window menu, since it is
// redundant"), so it is drawn under the tab strip it belongs with rather than
// on the bar.
//
// Deviations, all of them Swing constructs Slint has no equivalent for:
//   * A Swing drop-down is invisible until its menu is opened, so the bodies
//     are gated on `open-menu`, the same shape as the accepted `JTabbedPane`
//     `current-tab` deviation.  Every label is in this file regardless.
//   * A nested `JMenu` cascades into its own popup; here a submenu's body is
//     drawn indented under its row.
//   * A mnemonic underlines one letter of a label; it is shown in parentheses.
//   * `setIconImage(images/etomo.png)` (`EtomoFrame.java:56-58`) sets the
//     window-manager icon, which is not part of the drawn page.
//
// Menu activation is routed as a named action to `UIHarness`, matching the
// Java `EtomoMenu.addListeners` boundary.  It deliberately stops there: the
// Java `AbstractFrame`/manager methods are not yet translated, so this file
// must not pretend to save, open a manager, or launch a process itself.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import {
    Colors, MenuBar, Menu, MenuItem, CheckBoxMenuItem, MenuSeparator,
    TabCloseButton, AxisProgressPanel,
} from "MainWindowWidgets.slint";
// The wired window composes the translated panels and dialogs of the other
// gui crates (Slint imports by path, so they compile here with one shared
// `EtomoBridge` global).
import { EtomoBridge, BridgedTableRow, BridgedTableCell, BridgedPopupItem, BridgedPopupMenu, ContextArea } from "../../etomo-ui-common/ui/widgets.slint";
import { MainTomogramPanel } from "MainTomogramPanel.slint";
import { ReconDialogColumn } from "ReconDialogColumn.slint";
import { MainFrame_AboutBox } from "../../etomo-ui-windows/ui/MainFrame_AboutBox.slint";
import { SettingsDialog } from "../../etomo-ui-shell/ui/SettingsDialog.slint";
import { FrontPageDialog } from "../../etomo-ui-shell/ui/FrontPageDialog.slint";
import { SetupDialog } from "../../etomo-ui-recon-setup/ui/SetupDialog.slint";
import { MainToolsPanel } from "MainToolsPanel.slint";
import { MainJoinPanel } from "MainJoinPanel.slint";
import { JoinDialog } from "../../etomo-ui-join-peet/ui/JoinDialog.slint";
import { ToolsDialog } from "../../etomo-ui-shell/ui/ToolsDialog.slint";
import { MainParallelPanel } from "MainParallelPanel.slint";
import { MainPeetPanel } from "MainPeetPanel.slint";
import { PeetDialog } from "../../etomo-ui-join-peet/ui/PeetDialog.slint";
import { PeetStartupDialog } from "../../etomo-ui-join-peet/ui/PeetStartupDialog.slint";
import { ParallelPanel, ParallelPanelRow } from "ParallelPanel.slint";
import { ParallelDialog } from "../../etomo-ui-shell/ui/ParallelDialog.slint";
import { AnisotropicDiffusionDialog } from "../../etomo-ui-shell/ui/AnisotropicDiffusionDialog.slint";
import { ParallelChooser } from "../../etomo-ui-common/ui/fields.slint";
import { SerialSectionsStartupDialog } from "../../etomo-ui-batch-serial/ui/SerialSectionsStartupDialog.slint";
import { SerialSectionsDialog } from "../../etomo-ui-batch-serial/ui/SerialSectionsDialog.slint";
import { MainSerialSectionsPanel } from "MainSerialSectionsPanel.slint";
import { MainBatchRunTomoPanel } from "MainBatchRunTomoPanel.slint";
import { BatchRunTomoDialog } from "../../etomo-ui-batch-serial/ui/BatchRunTomoDialog.slint";
import { BatchRunTomoDatasetDialog } from "../../etomo-ui-batch-serial/ui/BatchRunTomoDatasetDialog.slint";
import { MainDirectiveEditorPanel } from "MainDirectiveEditorPanel.slint";
import { DirectiveEditorDialog } from "../../etomo-ui-directives/ui/DirectiveEditorDialog.slint";
import { DirectiveSectionData } from "../../etomo-ui-directives/ui/DirectiveSectionPanel.slint";
import { DirectivePanelData } from "../../etomo-ui-directives/ui/DirectivePanel.slint";
export { DirectiveSectionData, DirectivePanelData }
export { ParallelPanelRow }
export { TextPageWindowWindow } from "../../etomo-ui-windows/ui/TextPageWindow.slint";
export { TabbedTextWindowWindow } from "../../etomo-ui-windows/ui/TabbedTextWindow.slint";
export { EtomoBridge, BridgedTableRow, BridgedTableCell, BridgedPopupItem }

export component MainFrame inherits Rectangle {
    // Which menu's drop-down is open; -1 (none) is the state a freshly built
    // `JMenuBar` is in.  0 File, 1 Tools, 2 View, 3 Options, 4 Help.
    // Choosing an item closes the open menus, as Swing's `MenuSelectionManager`
    // does.
    in-out property <int> open-menu: -1;
    // `menuNew` / `menuRecentProjects` / `menuTemplate` are nested `JMenu`s;
    // Swing opens them on hover.
    in-out property <bool> open-new-submenu: false;
    in-out property <bool> open-recent-projects-submenu: false;
    in-out property <bool> open-templates-submenu: false;
    // `EtomoMenu` listeners call an `AbstractFrame` method.  This is the
    // direct Rust replacement for that listener hand-off.
    callback menu-command(string);
    callback menu-toggled(string, bool);
    // `peetAvailable` (`EtomoMenu.java:127-129`):
    // `EnvironmentVariable.INSTANCE.exists(null, originalUserDir,
    // EnvironmentVariable.PARTICLE_DIR, AxisID.ONLY)`, evaluated once when the
    // menu is constructed.  It gates the two PEET help items (`:260-263`).
    in property <bool> peet-available: true;
    // `menuCancel` (`:60`) is constructed unconditionally but added to the
    // File menu only on the `!dataset` path (`:228-232`) — the
    // `EtomoMenu.getInstance(ManagerFrame, boolean)` branch, not `MainFrame`'s.
    in property <bool> show-cancel-item: false;
    // `WindowSwitch.getPanel` (`:174-187`) returns the bare `MainPanel` while
    // `tabList.size() == 1` and the `TabbedPane` once a second window is
    // opened; a fresh `MainFrame` has at most one.
    in property <bool> show-window-tabs: false;
    in property <[string]> window-tab-titles: ["dataset"];
    in property <int> current-window-tab: 0;

    background: EtomoStyle.background;
    VerticalLayout {
        spacing: 0px;

        // The menu bar is drawn over the content (it follows the layout
        // below), so its drop-downs are not covered; this keeps its row.
        Rectangle { height: 24px; }

        // ================= rootPanel (BorderLayout) =======================
        // `rootPanel.add(windowSwitch.getPanel(managerKey))` (`:583`).
        Rectangle {
            vertical-stretch: 1;
            background: EtomoStyle.background;
            // With no manager panel yet (an empty layout) the frame must still
            // be free to take the window's size.
            max-width: 100000px;
            max-height: 100000px;
            VerticalLayout {
                spacing: 0px;
                // `WindowSwitch.setTabs` (`:237-286`): one tab per open
                // window, each tab component a `GridBagLayout` panel of the
                // window name, a `FixedDim.x25_y0` rigid area and the close
                // button (`addCloseButtonToTab`, `:301-320`).  Only the
                // selected tab carries the `MainPanel`; the rest get an
                // invisible `JLabel` placeholder (`:272-274`).
                if root.show-window-tabs: HorizontalLayout {
                    alignment: start;
                    spacing: 2px;
                    padding: 2px;
                    for tab[index] in root.window-tab-titles: Rectangle {
                        height: 24px;
                        background: index == root.current-window-tab
                            ? EtomoStyle.panel : EtomoStyle.background.darker(10%);
                        border-width: 1px;
                        border-color: EtomoStyle.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 6px;
                            spacing: 0px;
                            Text {
                                text: tab;
                                vertical-alignment: center;
                                font-size: EtomoStyle.font-size-pt * 1px;
                            }
                            // `Box.createRigidArea(FixedDim.x25_y0)` (`:313`).
                            Rectangle { width: 25px; }
                            TabCloseButton { y: (parent.height - 16px) / 2; }
                        }
                    }
                }
                // The current manager's `MainPanel` — one of the
                // `Main*Panel.slint` components in this crate.
                @children
            }
        }
    }
    // ================= menuBar (EtomoMenu.createPanel) =================
    // `menuBar.add(menuFile)` (`:192`), then `menuTools`, `menuView`,
    // `menuOptions`, `menuHelp` (`:244-247`).
    MenuBar {
        x: 0;
        y: 0;
        width: root.width;
        // ---- menuFile, "File", mnemonic F (`:54`, `:173`) -------------
        Menu {
            title: "File";
            mnemonic: "F";
            open: root.open-menu == 0;
            activated => {
                root.open-menu = root.open-menu == 0 ? -1 : 0;
                root.menu-toggled("menu.file", root.open-menu == 0);
            }

            // `menuFile.add(menuNew)` (`:218`).  "New", mnemonic N (`:69`, `:164`).
            Menu {
                title: "New";
                mnemonic: "N";
                submenu: true;
                open: root.open-new-submenu;
                activated => {
                    root.open-new-submenu = !root.open-new-submenu;
                    root.menu-toggled("menu.file.new", root.open-new-submenu);
                }
                // `menuNew.add(...)` in this order (`:199-205`).  The
                // labels are `EtomoMenu`'s own constants (`:38-47`).
                MenuItem { text: "Build Tomogram"; mnemonic: "T"; command: "file.new.tomogram"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Join Serial Tomograms"; mnemonic: "J"; command: "file.new.join"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Subvolume Averaging (PEET)"; mnemonic: "P"; command: "file.new.peet"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Align Serial Sections / Blend Montages"; mnemonic: "R"; command: "file.new.serial-sections"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Nonlinear Anisotropic Diffusion"; mnemonic: "D"; command: "file.new.anisotropic-diffusion"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Generic Parallel Process"; mnemonic: "G"; command: "file.new.generic-parallel"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Batch Tomograms"; mnemonic: "H"; command: "file.new.batch-runtomo"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            }
            MenuItem { text: "Open..."; mnemonic: "O"; command: "file.open"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            // `menuFile.add(menuRecentProjects)` appears twice (`:220` and
            // `:222`) with a separator between.  Swing's `add` moves an
            // already-added component rather than duplicating it, so the
            // menu ends up with the separator first and one "Recent
            // Projects" row after it; that quirk is reproduced here.
            MenuSeparator { }
            Menu {
                title: "Recent Projects";
                submenu: true;
                open: root.open-recent-projects-submenu;
                activated => {
                    root.open-recent-projects-submenu = !root.open-recent-projects-submenu;
                    root.menu-toggled("menu.file.recent-projects", root.open-recent-projects-submenu);
                }
                // `menuMRUList` (`:64`): ten `MenuItem`s created with no
                // text and `setVisible(false)` (`:328-332`), filled in by
                // `setMRUFileLabels` at run time.  Drawn as ten hidden
                // rows so the slot and the count stay in the translation.
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
                MenuItem { text: ""; visible-item: false; }
            }
            MenuSeparator { }
            // `:225-227`.
            MenuItem { text: "Close"; mnemonic: "C"; command: "file.close"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Save"; mnemonic: "S"; command: "file.save"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Save As..."; mnemonic: "A"; command: "file.save-as"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            // The `!dataset` branch (`:228-232`).
            if root.show-cancel-item: MenuSeparator { }
            if root.show-cancel-item: MenuItem { text: "Cancel"; command: "file.cancel"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            // The `dataset` branch (`:233-240`).
            MenuSeparator { }
            MenuItem { text: "Run Tomosnapshot"; mnemonic: "T"; command: "file.tomosnapshot"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Export Batch Directive File"; mnemonic: "B"; command: "file.export-batch"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuSeparator { }
            // `menuTemplate`, "Templates", mnemonic M (`:67`, `:175`).
            Menu {
                title: "Templates";
                mnemonic: "M";
                submenu: true;
                open: root.open-templates-submenu;
                activated => {
                    root.open-templates-submenu = !root.open-templates-submenu;
                    root.menu-toggled("menu.file.templates", root.open-templates-submenu);
                }
                // `:207-209`.
                MenuItem { text: "Save Scope Template"; mnemonic: "C"; command: "file.save-scope-template"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Save System Template"; mnemonic: "Y"; command: "file.save-system-template"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
                MenuItem { text: "Save User Template"; mnemonic: "U"; command: "file.save-user-template"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            }
            MenuSeparator { }
            MenuItem { text: "Exit"; mnemonic: "X"; command: "file.exit"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
        }

        // ---- menuTools, "Tools", mnemonic T (`:89`, `:158`) ----------
        Menu {
            title: "Tools";
            mnemonic: "T";
            open: root.open-menu == 1;
            activated => {
                root.open-menu = root.open-menu == 1 ? -1 : 1;
                root.menu-toggled("menu.tools", root.open-menu == 1);
            }
            // `:251-253`; labels from `FLATTEN_VOLUME_LABEL`,
            // `GPU_TILT_TEST_LABEL`, `ALIGN_FRAMES_LABEL` (`:44-46`).
            MenuItem { text: "Flatten Volume"; mnemonic: "F"; command: "tools.flatten-volume"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Test GPU"; mnemonic: "U"; command: "tools.gpu-tilt-test"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Align Frames"; mnemonic: "A"; command: "tools.align-frames"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
        }

        // ---- menuView, "View", mnemonic V (`:97`, `:159`) ------------
        Menu {
            title: "View";
            mnemonic: "V";
            open: root.open-menu == 2;
            activated => {
                root.open-menu = root.open-menu == 2 ? -1 : 2;
                root.menu-toggled("menu.view", root.open-menu == 2);
            }
            // `:211-214`, all four accelerated in the `dataset` branch
            // (`:176-185`).  "Axis B" is `TomogramProcessPanel.AXIS_B_LABEL`
            // (`TomogramProcessPanel.java:168`).
            MenuItem { text: "Show/Hide Log Window"; mnemonic: "L"; accelerator: "Ctrl+L"; command: "view.log-window"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Axis A"; mnemonic: "A"; accelerator: "Ctrl+A"; command: "view.axis-a"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Axis B"; mnemonic: "B"; accelerator: "Ctrl+B"; command: "view.axis-b"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Both Axes"; mnemonic: "2"; accelerator: "Ctrl+2"; command: "view.both-axes"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            // `menuView.add(menuFitWindow)` comes after the menu-bar adds
            // (`:249`), so it is last.
            MenuItem { text: "Fit Window"; mnemonic: "F"; accelerator: "Ctrl+F"; command: "view.fit-window"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
        }

        // ---- menuOptions, "Options", mnemonic O (`:106`, `:160`) -----
        Menu {
            title: "Options";
            mnemonic: "O";
            open: root.open-menu == 3;
            activated => {
                root.open-menu = root.open-menu == 3 ? -1 : 3;
                root.menu-toggled("menu.options", root.open-menu == 3);
            }
            // `menuOptions.add(menuSettings)` (`:188`) runs before the
            // `dataset` block, so Settings is first.
            MenuItem { text: "Settings"; mnemonic: "S"; accelerator: "Ctrl+S"; command: "options.settings"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            // `:196-197`.  Both are `CheckBoxMenuItem`s and start
            // unchecked; `setMenu3dmodStartupWindow` /
            // `setMenu3dmodBinBy2` (`EtomoFrame.java:94-101`) set them
            // from the user configuration at run time.
            CheckBoxMenuItem { text: "Open 3dmod with Startup Window"; command: "options.3dmod-startup-window"; activated(command, checked) => { root.open-menu = -1; root.menu-toggled(command, checked); } }
            CheckBoxMenuItem { text: "Open 3dmod Binned by 2"; command: "options.3dmod-bin-by-2"; activated(command, checked) => { root.open-menu = -1; root.menu-toggled(command, checked); } }
        }

        // ---- menuHelp, "Help", mnemonic H (`:113`, `:161`) -----------
        Menu {
            title: "Help";
            mnemonic: "H";
            open: root.open-menu == 4;
            activated => {
                root.open-menu = root.open-menu == 4 ? -1 : 4;
                root.menu-toggled("menu.help", root.open-menu == 4);
            }
            // `:255-265`.
            MenuItem { text: "Tomography Guide"; mnemonic: "T"; command: "help.tomography-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Imod Users Guide"; mnemonic: "I"; command: "help.imod-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "3dmod Users Guide"; mnemonic: "3"; command: "help.3dmod-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Etomo Users Guide"; mnemonic: "E"; command: "help.etomo-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Join Users Guide"; mnemonic: "J"; command: "help.join-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            if root.peet-available: MenuItem { text: "PEET Users Guide"; mnemonic: "P"; command: "help.peet-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            if root.peet-available: MenuItem { text: "PEET Help"; command: "help.peet-help"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "Batch Interface Guide"; mnemonic: "B"; command: "help.batch-guide"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
            MenuItem { text: "About"; mnemonic: "A"; command: "help.about"; activated(command) => { root.open-menu = -1; root.open-new-submenu = false; root.menu-command(command); } }
        }
    }
}

export component MainFrameWindow inherits Window {
    // `MainFrame.setTitle(AxisID)` (`:678-694`): `ETOMO_TITLE` "Etomo"
    // (`:487`) alone with no manager, `"<manager name> - Etomo"` with one
    // (`:581`), and for a dual axis prefixed with `aAxisTitle` "A Axis - " or
    // `bAxisTitle` "B Axis - " (`:490-491`).
    // Wired: the translated `MainFrame`'s title (`slint_bridge.rs`).
    in property <string> frame-title: "Etomo";
    title: root.frame-title;
    preferred-width: 1000px;
    preferred-height: 820px;
    background: EtomoStyle.background;
    // Expose the MainFrame listener boundary through the actual top-level
    // component, which is what `UIHarness.createMainFrame` owns.
    callback menu-command(string);
    callback menu-toggled(string, bool);
    // Rust-only wiring (`ui/swing/slint_bridge.rs`): which manager's
    // `MainPanel` `MainFrame.setCurrentManager` put in `rootPanel` ("" none,
    // "front-page", "recon", "tools", "parallel", "join"), the axis type, whether `openSetupPanel`
    // is showing, and the current dialog of the shown axis (the
    // `DialogType` name, "" none) - the panel `AxisProcessPanel.panelDialog`
    // holds.  For "tools", `tool-type` is the `ToolsManager`'s `ToolType`
    // (0 flatten volume, 1 GPU test, 2 align frames).
    in property <string> view: "";
    // For "peet" (`PeetManager`): whether `panelDialog` holds the `PeetDialog`.
    in property <bool> peet-dialog-shown: false;
    in property <string> axis-type: "SINGLE_AXIS";
    // For "recon": the axis `MainPanel` shows in `panelCenter` ("A", or "B"
    // after `showAxisB`); `dialog` is that axis's current dialog.
    in property <string> showing-axis: "A";
    in property <bool> showing-setup: false;
    in property <string> dialog: "";
    in property <int> tool-type: 0;
    // For "tools": the text of `ToolsDialog.taTaskLog` (the task log).
    in property <string> tools-task-log: "";
    in property <string> status-bar-text: "No data set loaded";
    // For "parallel" (`ParallelManager`): the process `panelDialog` shows
    // ("chooser" `ParallelChooser`, "PARALLEL" `ParallelDialog`,
    // "ANISOTROPIC_DIFFUSION" `AnisotropicDiffusionDialog`), whether
    // `AxisProcessPanel.parallelStatusPanel` shows the `ParallelPanel`, and the
    // rows of its processor table.
    in property <string> parallel-dialog: "";
    in property <bool> show-parallel-panel: false;
    in property <[ParallelPanelRow]> parallel-rows: [];
    callback parallel-row-toggled(int);
    // A showing modal `JDialog` (a project's startup dialog): its title ("" when
    // none shows), drawn over the frame as Swing's modal dialog sits over it;
    // `startup-dialog-closing` is the dialog's close button (`WINDOW_CLOSING`).
    in property <string> startup-dialog: "";
    // For "serial-sections" (`SerialSectionsManager`): whether `panelDialog`
    // holds the `SerialSectionsDialog` (after the startup dialog).
    in property <bool> serial-sections-dialog-shown: false;
    // For "batch" (`BatchRunTomoManager`): whether `panelDialog` holds the
    // `BatchRunTomoDialog`, and whether the showing `JDialog` is a dataset's
    // own `BatchRunTomoDatasetDialog` frame (`getRowInstance`).
    in property <bool> batch-dialog-shown: false;
    in property <bool> startup-dialog-batch-dataset: false;
    callback startup-dialog-closing();
    // The About box's labels, read from its `JDialog` (`slint_bridge.rs`), and
    // its OK button.
    in property <string> about-version-text;
    in property <string> about-imod-version;
    in property <string> about-imod-info-1;
    in property <string> about-imod-info-2;
    in property <bool> about-show-imod-info;
    in property <bool> about-show-imod-version;
    in property <bool> about-show-peet-version;
    in property <string> about-peet-version;
    callback about-ok();
    // A showing `ManagerFrame` (`UIHarness.addFrame`: the directive editor,
    // `DirectiveEditorManager`): its title ("" when none shows), drawn over the
    // main frame as the separate Swing frame sits over it, with its own menu
    // bar (`EtomoMenu.getInstance(ManagerFrame, savable)`, the `!dataset`
    // path), the `MainDirectiveEditorPanel` status bar, the progress panel and
    // the `DirectiveEditorDialog`.  `manager-frame-closing` is the frame's close
    // button (`WINDOW_CLOSING`, `ManagerFrame.processWindowEvent`).
    in property <string> manager-frame: "";
    in property <string> manager-frame-status-bar-text: "";
    in property <[DirectiveSectionData]> directive-column-1: [];
    in property <[DirectiveSectionData]> directive-column-2: [];
    in property <[DirectiveSectionData]> directive-column-3: [];
    in property <bool> directive-column-1-extra-row: false;
    in property <bool> directive-column-2-extra-row: false;
    in property <bool> directive-column-3-extra-row: false;
    in-out property <int> manager-frame-open-menu: -1;
    callback manager-frame-closing();
    // `PeetManager.isInterfaceAvailable()`: whether `EtomoMenu` added the PEET
    // Help menu items (`slint_bridge.rs`).
    in property <bool> peet-available: true;
    MainFrame {
        peet-available: root.peet-available;
        menu-command(command) => { root.menu-command(command); }
        menu-toggled(command, checked) => { root.menu-toggled(command, checked); }
        if root.view == "front-page": FrontPageDialog { }
        // `openSetupPanel`: packed at its preferred height, as `pack()` sizes it.
        if root.view == "recon" && root.showing-setup: VerticalLayout {
            alignment: start;
            SetupDialog { }
        }
        // `AxisProcessPanel`: the process buttons on the left; on the right
        // the progress panel above `panelDialog`, which scrolls when the
        // dialog is taller than the window.
        if root.view == "recon" && !root.showing-setup: HorizontalLayout {
            alignment: start;
            // `MainPanel.panelCenter` holds the axis `MainPanel` shows: A (or
            // the only axis), or B after `showAxisB` (`showing-axis`).  When both
            // axes are shown, B is in the `SubFrame` window (`SubFrame.slint`).
            MainTomogramPanel {
                // `TomogramProcessPanel`'s column: the 200-pixel process
                // buttons and the two axis buttons with their 40-pixel gap.
                width: 215px;
                status-bar-text: root.status-bar-text;
                axis-type: root.axis-type;
                showing-axis: root.showing-axis;
                show-status-panel: false;
            }
            ReconDialogColumn {
                dialog: root.dialog;
                panel-background: root.showing-axis == "B" ? Colors.background-b : Colors.background-a;
                show-parallel-panel: root.show-parallel-panel;
                parallel-rows: root.parallel-rows;
                parallel-row-toggled(row) => { root.parallel-row-toggled(row); }
            }
        }
        if root.view == "tools": HorizontalLayout {
            alignment: start;
            MainToolsPanel {
                width: 160px;
                status-bar-text: root.status-bar-text;
                show-status-panel: false;
            }
            Rectangle {
                background: Colors.background-tools;
                VerticalLayout {
                    AxisProgressPanel { }
                    Flickable {
                        viewport-height: tools-dialog.preferred-height;
                        viewport-width: max(self.width, tools-dialog.preferred-width);
                        // A right press on the dialog's background goes to the
                        // dialog's outermost context-menu panel (`slint_bridge.rs`).
                        ContextArea {
                            x: 0;
                            y: 0;
                            width: max(parent.width, tools-dialog.preferred-width);
                            height: max(tools-dialog.preferred-height, 0px);
                        }
                        tools-dialog := VerticalLayout {
                            alignment: start;
                            ToolsDialog { tool-type: root.tool-type; task-log: root.tools-task-log; }
                        }
                    }
                }
            }
        }
        // `MainJoinPanel` / `JoinProcessPanel`: no process buttons; the
        // progress panel above `panelDialog`, which holds the `JoinDialog`.
        if root.view == "join": HorizontalLayout {
            MainJoinPanel {
                width: 160px;
                status-bar-text: root.status-bar-text;
                show-status-panel: false;
            }
            // `scrollA` (`MainPanel`): takes the rest of the window's width and
            // scrolls the dialog when it is wider (the Section Table's 13
            // columns), as the Java JScrollPane does.
            Rectangle {
                horizontal-stretch: 1;
                background: Colors.violet;
                VerticalLayout {
                    AxisProgressPanel { }
                    Flickable {
                        viewport-height: join-dialog.preferred-height;
                        viewport-width: max(self.width, join-dialog.preferred-width);
                        // A right press on the dialog's background goes to the
                        // dialog's outermost context-menu panel (`slint_bridge.rs`).
                        ContextArea {
                            x: 0;
                            y: 0;
                            width: max(parent.width, join-dialog.preferred-width);
                            height: max(join-dialog.preferred-height, 0px);
                        }
                        join-dialog := VerticalLayout {
                            alignment: start;
                            JoinDialog { }
                        }
                    }
                }
            }
        }
        // `MainSerialSectionsPanel` / `SerialSectionsProcessPanel`: no process
        // buttons; the progress panel above `panelDialog`, which holds the
        // `SerialSectionsDialog` once the startup dialog is done.
        if root.view == "serial-sections": HorizontalLayout {
            alignment: start;
            MainSerialSectionsPanel {
                width: 160px;
                status-bar-text: root.status-bar-text;
                show-status-panel: false;
            }
            Rectangle {
                background: Colors.background-serial-sections;
                VerticalLayout {
                    AxisProgressPanel { }
                    Flickable {
                        viewport-height: serial-sections-dialog.preferred-height;
                        viewport-width: max(self.width, serial-sections-dialog.preferred-width);
                        // A right press on the dialog's background goes to the
                        // dialog's outermost context-menu panel (`slint_bridge.rs`).
                        ContextArea {
                            x: 0;
                            y: 0;
                            width: max(parent.width, serial-sections-dialog.preferred-width);
                            height: max(serial-sections-dialog.preferred-height, 0px);
                        }
                        serial-sections-dialog := VerticalLayout {
                            alignment: start;
                            if root.serial-sections-dialog-shown: SerialSectionsDialog { }
                        }
                    }
                }
            }
        }
        // `MainBatchRunTomoPanel` / `BatchRunTomoProcessPanel`: no process
        // buttons and `altParallelLoc` (the dialog's Run tab shows the parallel
        // panel); the progress panel above `panelDialog`, which holds the
        // `BatchRunTomoDialog`.
        if root.view == "batch": HorizontalLayout {
            alignment: start;
            MainBatchRunTomoPanel {
                width: 160px;
                status-bar-text: root.status-bar-text;
                show-status-panel: false;
            }
            Rectangle {
                background: Colors.violet;
                VerticalLayout {
                    AxisProgressPanel { }
                    Flickable {
                        viewport-height: batch-dialog.preferred-height;
                        viewport-width: max(self.width, batch-dialog.preferred-width);
                        ContextArea {
                            x: 0;
                            y: 0;
                            width: max(parent.width, batch-dialog.preferred-width);
                            height: max(batch-dialog.preferred-height, 0px);
                        }
                        batch-dialog := VerticalLayout {
                            alignment: start;
                            if root.batch-dialog-shown: BatchRunTomoDialog {
                                show-parallel-panel: root.show-parallel-panel;
                                parallel-rows: root.parallel-rows;
                                parallel-row-toggled(row) => { root.parallel-row-toggled(row); }
                            }
                        }
                    }
                }
            }
        }
        // `MainParallelPanel` / `ParallelProcessPanel`: no process buttons; the
        // progress panel, the `ParallelPanel` when parallel processing is shown
        // (`AxisProcessPanel.showParallelPanel`), then `panelDialog`.
        // `MainPeetPanel` / `PeetProcessPanel`: no process buttons; the progress
        // panel, the `ParallelPanel` when parallel processing is shown (the Run
        // tab), then `panelDialog`, which holds the `PeetDialog` once the
        // startup dialog has set up the project.
        if root.view == "peet": HorizontalLayout {
            MainPeetPanel {
                width: 160px;
                status-bar-text: root.status-bar-text;
                show-status-panel: false;
            }
            // Takes the rest of the window's width, so the dialog's wide tables
            // (iteration table: 16 columns) can be shown or scrolled to.
            Rectangle {
                horizontal-stretch: 1;
                background: EtomoStyle.background;
                VerticalLayout {
                    AxisProgressPanel { }
                    // In its own row, so its fixed width does not cap the dialog's.
                    if root.show-parallel-panel: HorizontalLayout {
                        alignment: start;
                        ParallelPanel {
                            rows: root.parallel-rows;
                            row-toggled(row) => { root.parallel-row-toggled(row); }
                        }
                    }
                    Flickable {
                        viewport-height: peet-dialog.preferred-height;
                        viewport-width: max(self.width, peet-dialog.preferred-width);
                        // A right press on the dialog's background goes to the
                        // dialog's outermost context-menu panel (`slint_bridge.rs`).
                        ContextArea {
                            x: 0;
                            y: 0;
                            width: max(parent.width, peet-dialog.preferred-width);
                            height: max(peet-dialog.preferred-height, 0px);
                        }
                        peet-dialog := VerticalLayout {
                            alignment: start;
                            if root.peet-dialog-shown: PeetDialog { }
                        }
                    }
                }
            }
        }
        if root.view == "parallel": HorizontalLayout {
            alignment: start;
            MainParallelPanel {
                width: 160px;
                status-bar-text: root.status-bar-text;
                show-status-panel: false;
            }
            Rectangle {
                background: Colors.background-parallel;
                VerticalLayout {
                    AxisProgressPanel { }
                    if root.show-parallel-panel: ParallelPanel {
                        rows: root.parallel-rows;
                        row-toggled(row) => { root.parallel-row-toggled(row); }
                    }
                    Flickable {
                        viewport-height: parallel-dialog.preferred-height;
                        viewport-width: max(self.width, parallel-dialog.preferred-width);
                        // A right press on the dialog's background goes to the
                        // dialog's outermost context-menu panel (`slint_bridge.rs`).
                        ContextArea {
                            x: 0;
                            y: 0;
                            width: max(parent.width, parallel-dialog.preferred-width);
                            height: max(parallel-dialog.preferred-height, 0px);
                        }
                        parallel-dialog := VerticalLayout {
                            alignment: start;
                            if root.parallel-dialog == "chooser": ParallelChooser { }
                            if root.parallel-dialog == "PARALLEL": ParallelDialog { }
                            if root.parallel-dialog == "ANISOTROPIC_DIFFUSION": AnisotropicDiffusionDialog { }
                        }
                    }
                }
            }
        }
    }
    if root.startup-dialog != "": Rectangle {
        background: #00000040;
        TouchArea { }
        startup-frame := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 3;
            width: startup-layout.preferred-width;
            height: startup-layout.preferred-height;
            background: EtomoStyle.background;
            border-width: 1px;
            border-color: EtomoStyle.border;
            startup-layout := VerticalLayout {
                // The dialog's title bar, with the window system's close button.
                Rectangle {
                    height: 24px;
                    background: EtomoStyle.panel.darker(10%);
                    HorizontalLayout {
                        padding-left: 6px;
                        Text { text: root.startup-dialog; vertical-alignment: center; font-weight: 700; }
                        Rectangle {
                            width: 24px;
                            Text { text: "x"; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.startup-dialog-closing(); } }
                        }
                    }
                }
                if root.startup-dialog == "Starting Serial Sections": SerialSectionsStartupDialog { }
                if root.startup-dialog == "Starting PEET": PeetStartupDialog { }
                // A dataset's `BatchRunTomoDatasetDialog` frame (title "dir/name").
                if root.startup-dialog-batch-dataset: Flickable {
                    min-height: min(batch-dataset.preferred-height, 760px);
                    preferred-height: min(batch-dataset.preferred-height, 760px);
                    preferred-width: batch-dataset.preferred-width;
                    viewport-height: batch-dataset.preferred-height;
                    viewport-width: batch-dataset.preferred-width;
                    batch-dataset := BatchRunTomoDatasetDialog { global: false; }
                }
                // `SettingsDialog` (Options > Settings), a `JDialog` the Java makes
                // non-modal; drawn over the frame like the modal ones.
                if root.startup-dialog == "Etomo Settings": SettingsDialog { }
                // `MainFrame_AboutBox` (Help > About), a modal `JDialog`.
                if root.startup-dialog == "About": MainFrame_AboutBox {
                    version-text: root.about-version-text;
                    imod-version: root.about-imod-version;
                    imod-info-1: root.about-imod-info-1;
                    imod-info-2: root.about-imod-info-2;
                    show-imod-info: root.about-show-imod-info;
                    show-imod-version: root.about-show-imod-version;
                    show-peet-version: root.about-show-peet-version;
                    peet-version: root.about-peet-version;
                    ok-pressed => { root.about-ok(); }
                }
            }
        }
    }
    // ---- the directive editor's `ManagerFrame` ("directive-editor" view) ----
    if root.manager-frame != "": Rectangle {
        background: #00000040;
        TouchArea { }
        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: parent.height - 24px;
            background: EtomoStyle.background;
            border-width: 1px;
            border-color: EtomoStyle.border;
            VerticalLayout {
                // The frame's title bar, with the window system's close button.
                Rectangle {
                    height: 24px;
                    background: EtomoStyle.panel.darker(10%);
                    HorizontalLayout {
                        padding-left: 6px;
                        Text { text: root.manager-frame; vertical-alignment: center; font-weight: 700; }
                        Rectangle {
                            width: 24px;
                            Text { text: "x"; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.manager-frame-closing(); } }
                        }
                    }
                }
                // Room for the frame's menu bar, drawn last (over the content).
                Rectangle { height: 24px; }
                // `MainDirectiveEditorPanel` / `DirectiveEditorProcessPanel`: no
                // process buttons; the progress panel above `panelDialog`, which
                // holds the `DirectiveEditorDialog`.
                HorizontalLayout {
                    MainDirectiveEditorPanel {
                        width: 160px;
                        status-bar-text: root.manager-frame-status-bar-text;
                        show-status-panel: false;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Colors.background-tools;
                        VerticalLayout {
                            AxisProgressPanel { }
                            Flickable {
                                viewport-height: directive-editor-dialog.preferred-height;
                                viewport-width: max(self.width, directive-editor-dialog.preferred-width);
                                directive-editor-dialog := VerticalLayout {
                                    alignment: start;
                                    DirectiveEditorDialog {
                                        column-1-sections: root.directive-column-1;
                                        column-2-sections: root.directive-column-2;
                                        column-3-sections: root.directive-column-3;
                                        column-1-extra-row: root.directive-column-1-extra-row;
                                        column-2-extra-row: root.directive-column-2-extra-row;
                                        column-3-extra-row: root.directive-column-3-extra-row;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // `EtomoMenu.createPanel(frame, dataset = false, savable)`:
            // File (Close, Save, Save As, separator, Cancel), Tools, View,
            // Options, Help.  Items are clicked in the frame's own menu bar
            // (bridge kind "fmn").
            MenuBar {
                x: 0;
                y: 24px;
                width: parent.width;
                Menu {
                    title: "File";
                    mnemonic: "F";
                    open: root.manager-frame-open-menu == 0;
                    activated => { root.manager-frame-open-menu = root.manager-frame-open-menu == 0 ? -1 : 0; }
                    MenuItem { kind: "fmn"; text: "Close"; mnemonic: "C"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Save"; mnemonic: "S"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Save As..."; mnemonic: "A"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuSeparator { }
                    MenuItem { kind: "fmn"; text: "Cancel"; activated(command) => { root.manager-frame-open-menu = -1; } }
                }
                Menu {
                    title: "Tools";
                    mnemonic: "T";
                    open: root.manager-frame-open-menu == 1;
                    activated => { root.manager-frame-open-menu = root.manager-frame-open-menu == 1 ? -1 : 1; }
                    MenuItem { kind: "fmn"; text: "Flatten Volume"; mnemonic: "F"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Test GPU"; mnemonic: "U"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Align Frames"; mnemonic: "A"; activated(command) => { root.manager-frame-open-menu = -1; } }
                }
                Menu {
                    title: "View";
                    mnemonic: "V";
                    open: root.manager-frame-open-menu == 2;
                    activated => { root.manager-frame-open-menu = root.manager-frame-open-menu == 2 ? -1 : 2; }
                    MenuItem { kind: "fmn"; text: "Fit Window"; mnemonic: "F"; accelerator: "Ctrl+F"; activated(command) => { root.manager-frame-open-menu = -1; } }
                }
                Menu {
                    title: "Options";
                    mnemonic: "O";
                    open: root.manager-frame-open-menu == 3;
                    activated => { root.manager-frame-open-menu = root.manager-frame-open-menu == 3 ? -1 : 3; }
                    MenuItem { kind: "fmn"; text: "Settings"; mnemonic: "S"; accelerator: "Ctrl+S"; activated(command) => { root.manager-frame-open-menu = -1; } }
                }
                Menu {
                    title: "Help";
                    mnemonic: "H";
                    open: root.manager-frame-open-menu == 4;
                    activated => { root.manager-frame-open-menu = root.manager-frame-open-menu == 4 ? -1 : 4; }
                    MenuItem { kind: "fmn"; text: "Tomography Guide"; mnemonic: "T"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Imod Users Guide"; mnemonic: "I"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "3dmod Users Guide"; mnemonic: "3"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Etomo Users Guide"; mnemonic: "E"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Join Users Guide"; mnemonic: "J"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    // `peetAvailable` gates these two, as in the main frame's
                    // Help menu (whose `peet-available` is not wired either).
                    MenuItem { kind: "fmn"; text: "PEET Users Guide"; mnemonic: "P"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "PEET Help"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "Batch Interface Guide"; mnemonic: "B"; activated(command) => { root.manager-frame-open-menu = -1; } }
                    MenuItem { kind: "fmn"; text: "About"; mnemonic: "A"; activated(command) => { root.manager-frame-open-menu = -1; } }
                }
            }
        }
    }
    // The showing `JPopupMenu` (context menus), above everything else.
    if EtomoBridge.popup-shown: BridgedPopupMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
}
