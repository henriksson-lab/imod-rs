// Mirrors `IMOD/Etomo/src/etomo/ui/swing/MainParallelPanel.java`, a `MainPanel`
// subclass.  It instantiates the base component from `MainPanel.slint` and
// puts its one axis column in the base's `panelCenter` slot:
//
// `MainParallelPanel(ParallelManager)` (`:43-46`) forwards to
// `super(manager)`; `createAxisPanelA` (`:66-69`) builds a
// `ParallelProcessPanel`, and `addAxisPanelA` (`:48-51`) puts its container in
// `scrollA`.
//
// `createAxisPanelB` is empty (`:72`), `getAxisPanelB()` returns null and
// `isAxisPanelBNull()` returns true (`:61-64`), so there is no B column.
// `getDataFileFilter()` returns null.
//
// Appearance only: no callbacks, no state, static defaults everywhere.

import { EtomoStyle } from "../../etomo-ui-common/ui/widgets.slint";
import { Colors } from "MainWindowWidgets.slint";
import { MainPanel } from "MainPanel.slint";
import { ParallelProcessPanel } from "ParallelProcessPanel.slint";

export component MainParallelPanel inherits Rectangle {
    in property <string> status-bar-text: "No data set loaded";
    in property <color> panel-background: Colors.background-parallel;
    background: EtomoStyle.background;
    MainPanel {
        width: 100%;
        height: 100%;
        status-bar-text: root.status-bar-text;
        panel-background: root.panel-background;
        // `addAxisPanelA()`: `getScrollA().add(axisPanelA.getContainer())`.
        ParallelProcessPanel {
            panel-background: root.panel-background;
        }
        // `createAxisPanelB` has an empty body and `getAxisPanelB()` returns
        // null, so there is no B column to draw.
    }
}

export component MainParallelPanelWindow inherits Window {
    title: "eTomo MainParallelPanel";
    preferred-width: 800px;
    preferred-height: 600px;
    background: EtomoStyle.background;
    MainParallelPanel { }
}
