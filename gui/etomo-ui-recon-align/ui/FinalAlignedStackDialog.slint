// Mirrors `IMOD/Etomo/src/etomo/ui/swing/FinalAlignedStackDialog.java`.
//
// Appearance only: no callbacks, no process launching, no manager state.

import { EtomoStyle, BeveledBorder, PanelHeader, LabeledTextField, CheckBox,
         RadioButton, MultiLineButton, TabbedPane, BridgedTabbedPane }
    from "../../etomo-ui-common/ui/widgets.slint";
import { EtchedBorder, TextField, SimpleButton, FileTextField,
         ExitButtons } from "widgets_local.slint";
import { NewstackOrBlendmontPanel } from "NewstackOrBlendmontPanel.slint";
import { CpuGpuPanel } from "CpuGpuPanel.slint";
import { EraseGoldPanel } from "EraseGoldPanel.slint";

export component FinalAlignedStackDialog inherits VerticalLayout {
    // `FinalAlignedStackDialog.Tab`: 0 NEWST, 1 CTF_CORRECTION, 2 CCD_ERASER,
    // 3 MTF_FILTER.  `changeTab()` moves the body panel into the selected tab.
    in property <int> tab: 0;
    // `ctfCorrectionHeader.setOpen(false)` at the end of
    // `layoutCtfCorrectionPanel()`; the body is shown here so the source
    // layout is visible.
    in property <bool> ctf-correction-open: true;
    in property <bool> filter-open: true;
    // `ViewType.MONTAGE` selects `BlendmontPanel` over `NewstackPanel` for the
    // Create tab (`FinalAlignedStackDialog.java:241-247`).
    in property <bool> montage: false;

    spacing: EtomoStyle.row-gap;

    // `rootPanel`, bordered with `new BeveledBorder("Final Aligned Stack")`.
    BeveledBorder {
        title: "Final Aligned Stack";

        stack-tabs := BridgedTabbedPane {
            // Tab order follows the constructor's `layoutNewstPanel()`,
            // `layoutCtfCorrectionPanel()`, `layoutCcdEraser()`,
            // `layoutFilterPanel()`.
            tabs: ["Create", "Correct CTF", "Erase Gold", "2D Filter"];
            current: root.tab;

            // ---- Tab.NEWST ----
            // `layoutNewstPanel()` (`FinalAlignedStackDialog.java:905-910`)
            // adds nothing but `newstackOrBlendmontPanel.getComponent()`;
            // `:241-247` picks `BlendmontPanel` for a montage dataset and
            // `NewstackPanel` otherwise.
            if stack-tabs.shown-current == 0: NewstackOrBlendmontPanel { montage: root.montage; }

            // ---- Tab.CTF_CORRECTION: `ctfCorrectionMainPanel` ----
            if stack-tabs.shown-current == 1: Rectangle {
                background: EtomoStyle.panel;
                border-width: 1px;
                border-color: EtomoStyle.border;
                VerticalLayout {
                    padding: EtomoStyle.inset;
                    spacing: EtomoStyle.row-gap;
                    ph-body-4 := PanelHeader { title: "CTF Correction"; open: root.ctf-correction-open; }
                    // The header's body: drawn while it is open (`PanelHeader`, `expand`).
                    if ph-body-4.shown-open: VerticalLayout {
                        spacing: EtomoStyle.row-gap;
                        if root.ctf-correction-open: VerticalLayout {
                            spacing: EtomoStyle.row-gap;
                            LabeledTextField { label: "Voltage (KV): "; text: "300"; }
                            LabeledTextField { label: "Spherical Aberration (mm): "; text: "2.0"; }
                            LabeledTextField { label: "Amplitude contrast: "; text: "0.07"; }
                            CheckBox { text: "Invert sign of tilt angles"; }
                            // `ctfPlotterPanel`
                            EtchedBorder {
                                title: "CTF Plotter";
                                FileTextField { label: "Config file: "; text: ""; }
                                LabeledTextField { label: "Defocus range to scan (low, high in microns): "; text: ""; }
                                LabeledTextField { label: "Expected defocus (microns): "; text: ""; }
                                LabeledTextField { label: "Expected phase shift (degrees): "; text: ""; }
                                LabeledTextField { label: "Offset to add to image values: "; text: ""; }
                                MultiLineButton { text: "Run CTF Plotter"; }
                            }
                            // `ctfCorrectionPanel`
                            EtchedBorder {
                                title: "CTF Correction";
                                CheckBox { text: "Use expected defocus instead of ctfplotter output"; }
                                // `cpuGpuPanel`, built with
                                // `CpuGpuPanel.getInstance(appMgr, axisID,
                                // PanelId.CTF_PHASE_FLIP, -1, false,
                                // BoxLayout.X_AXIS)` (`:239-240`) — no recommended
                                // GPU or CPU counts, X layout.
                                CpuGpuPanel { horizontal: true; }
                                LabeledTextField { label: "Interpolation width (pixels): "; text: ""; }
                                // `pnlCtfPhaseFlipXAxisTilt`
                                HorizontalLayout {
                                    spacing: EtomoStyle.gap;
                                    alignment: start;
                                    CheckBox { text: "Correct for X axis tilt of"; }
                                    TextField { label: "Correct for X axis tilt of"; text: ""; enabled: false; field-width: 70px; }
                                    Text { text: " (takes much longer)"; vertical-alignment: center; }
                                }
                                // `pnlScaleByCtfPower`
                                HorizontalLayout {
                                    spacing: EtomoStyle.gap;
                                    alignment: start;
                                    CheckBox { text: "Scale by CTF to the power:"; }
                                    TextField { label: "Scale by CTF to the power:"; text: ""; enabled: false; field-width: 70px; }
                                }
                                LabeledTextField { label: "Defocus tolerance (nm): "; text: ""; }
                                LabeledTextField { label: "Minimum zero spacing in strip FFTs:"; text: ""; }
                                // `pnlCtf3dCorrectCtf`; `lCtf3dCorrectCtf` starts
                                // invisible (`setVisible(false)`) and is drawn in
                                // `ProcessControlPanel.colorComplete` when shown.
                                // `buttonPanel`
                                HorizontalLayout {
                                    spacing: EtomoStyle.gap;
                                    alignment: center;
                                    MultiLineButton { text: "Correct CTF"; width: 160px; }
                                    MultiLineButton { text: "View CTF Correction"; width: 160px; }
                                    MultiLineButton { text: "Use CTF Correction"; width: 160px; }
                                }
                            }
                        }
                    }
                }
            }

            // ---- Tab.CCD_ERASER ----
            // `eraseGoldPanel.getComponent()`, built at `:237-238`.
            if stack-tabs.shown-current == 2: EraseGoldPanel { }

            // ---- Tab.MTF_FILTER: `filterPanel` ----
            if stack-tabs.shown-current == 3: Rectangle {
                background: EtomoStyle.panel;
                border-width: 1px;
                border-color: EtomoStyle.border;
                VerticalLayout {
                    padding: EtomoStyle.inset;
                    spacing: EtomoStyle.row-gap;
                    ph-body-5 := PanelHeader { title: "2D Filtering (optional)"; open: root.filter-open; }
                    // The header's body: drawn while it is open (`PanelHeader`, `expand`).
                    if ph-body-5.shown-open: VerticalLayout {
                        spacing: EtomoStyle.row-gap;
                        if root.filter-open: VerticalLayout {
                            spacing: EtomoStyle.row-gap;
                            CheckBox { text: "Apply dose weighting"; }
                            // `pnlUniformFiltering`
                            EtchedBorder {
                                title: "Uniform Filtering";
                                LabeledTextField { label: "Low pass (cutoff,sigma): "; text: ""; }
                                // `inverseParamsPanel`
                                EtchedBorder {
                                    title: "Inverse Filtering Parameters: ";
                                    // `mtfFilePanel`
                                    HorizontalLayout {
                                        spacing: EtomoStyle.gap;
                                        LabeledTextField { label: "MTF file: "; text: ""; }
                                        // `btnMtfFile.setName(MTF_FILE_LABEL)`.
                                        SimpleButton { name-label: "MTF file: "; }
                                    }
                                    // `inversePanel`
                                    HorizontalLayout {
                                        spacing: EtomoStyle.gap;
                                        LabeledTextField { label: "Maximum Inverse: "; text: ""; }
                                        LabeledTextField { label: "Rolloff (radius,sigma): "; text: ""; }
                                    }
                                }
                            }
                            // `pnlDoseWeighting`
                            EtchedBorder {
                                title: "Dose Weighting";
                                // `pnlFixedImageDose`
                                HorizontalLayout {
                                    spacing: EtomoStyle.gap;
                                    alignment: start;
                                    CheckBox { text: "No dose file; use fixed dose per image: "; }
                                    TextField { label: "No dose file; use fixed dose per image: "; text: ""; field-width: 70px; }
                                    Text { text: " e/sq A"; vertical-alignment: center; }
                                }
                                // `pnlGlueTypeOfDoseFile` centres `pnlTypeOfDoseFile`.
                                HorizontalLayout {
                                    alignment: center;
                                    EtchedBorder {
                                        title: "Type of Dose File";
                                        RadioButton { text: "Metadata in .mdoc file"; selected: true; }
                                        RadioButton { text: "Dose for each image"; }
                                        RadioButton { text: "Prior dose and dose of image"; }
                                        RadioButton { text: "Cumulative dose before and after image"; }
                                    }
                                }
                                FileTextField { label: "Dose information file: "; text: ""; }
                                CheckBox { text: "Microscope voltage is 200 KV"; }
                                LabeledTextField { label: "Optimal dose scaling"; text: ""; }
                                // `tfBidirectionalNumViews`'s Java label carries a
                                // leading newline so Swing's HTML label wraps it
                                // onto its own line; there is no equivalent here.
                                LabeledTextField { label: "# of views in first half of bidirectional series"; text: ""; }
                            }
                            LabeledTextField { label: "Starting and ending views: "; text: ""; }
                            // `pnlCtf3d2dFilter`; `lCtf3d2dFilter1`/`2` start
                            // invisible (`setVisible(false)`).
                            // `buttonPanel`
                            HorizontalLayout {
                                spacing: EtomoStyle.gap;
                                alignment: start;
                                MultiLineButton { text: "Filter"; width: 160px; }
                                MultiLineButton { text: "View Filtered Stack"; width: 160px; }
                                MultiLineButton { text: "Use Filtered Stack"; width: 160px; }
                            }
                        }
                    }
                }
            }
        }
    }

    // `ProcessDialog.addExitButtons()`.  `btnExecute.setText("Done")`.
    ExitButtons { execute-text: "Done"; }
}

export component FinalAlignedStackDialogWindow inherits Window {
    title: "Final Aligned Stack";
    background: EtomoStyle.background;
    preferred-width: 760px;
    preferred-height: 820px;
    VerticalLayout {
        FinalAlignedStackDialog { }
    }
}
