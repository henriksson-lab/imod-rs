<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputVolume">
    
    <short>inputvolume</short>
    
    <type>FN</type>
    
    <usage>Input file to be transformed</usage>
    
    <tooltip />
    
    <manpage>Input file to be transformed.  If this option is not entered, the first nonoption argument is taken as the input volume.</manpage>
  
  </Field>
  
  <Field name="OutputVolume">
    
    <short>outputvolume</short>
    
    <type>FN</type>
    
    <usage>Transformed output file</usage>
    
    <tooltip />
    
    <manpage>Name of transformed file to be produced.  If this option is not entered, the second nonoption argument is taken as this name.</manpage>
  
  </Field>
  
  <Field name="SizeXYZorVolume">
    
    <short>size</short>
    
    <type>CH</type>
    
    <usage>Either name or X,Y,Z size of file being matched to</usage>
    
    <tooltip />
    
    <manpage>Specifies the size of the volume being matched to; the entry can be either the name of that file or its NX,NY,NZ dimensions.</manpage>
  
  </Field>
  
  <Field name="RefineLimit">
    
    <short>refinelimit</short>
    
    <type>F</type>
    
    <usage>Mean residual limit for using refinematch and matchvol (default 0.3)</usage>
    
    <tooltip />
    
    <manpage>The maximum mean residual that will be allowed when running Refinematch(1) and Matchvol(1).</manpage>
  
  </Field>
  
  <Field name="WarpLimits">
    
    <short>warplimit</short>
    
    <type>CH</type>
    
    <usage>Mean residual limits which findwarp will try to achieve, or 0 not to warp (default 0.2,0.27,0.35)</usage>
    
    <tooltip />
    
    <manpage>A list of mean residuals that Warpvol(1) will attempt to achieve automatically.  Values should be in increasing order and separated by commas.</manpage>
  
  </Field>
  
  <Field name="StructureCriteria">
    
    <short>structurecrit</short>
    
    <type>CH</type>
    
    <usage>Criterion values for selecting patches based on a structure measure</usage>
    
    <tooltip />
    
    <manpage>A list of one or more criterion values for selecting patches based on a measure of structure contained in the patch file.  Both Refinematch(1) and Findwarp(1) will be run with these limits for selecting patches with the structure value greater than the criterion.  In Findwarp(1), each criterion will be applied at a mean residual limit before going on to the next residual limit.  The measure of structure will be the fraction of analyzed boxes within a patch with a standard deviation indicative of a strong structure, which is saved in the patch file by Corrsearch3d(1) as an extra column with ID 5.</manpage>
  
  </Field>
  
  <Field name="ExtentToFit">
    
    <short>extentfit</short>
    
    <type>FN</type>
    
    <usage>Minimum number of rows and columns of patches in local fits</usage>
    
    <tooltip />
    
    <manpage>Minimum number of rows and columns of patches to include in each local fit in Findwarp(1).</manpage>
  
  </Field>
  
  <Field name="ModelFile">
    
    <short>modelfile</short>
    
    <type>FN</type>
    
    <usage>Model file defining patches to include</usage>
    
    <tooltip />
    
    <manpage>Name of a model file with contours enclosing the patches to include in fits.</manpage>
  
  </Field>
  
  <Field name="PatchFile">
    
    <short>patchfile</short>
    
    <type>FN</type>
    
    <usage>File of patch displacements (default patch.out)</usage>
    
    <tooltip />
    
    <manpage>Name of the existing file with list of patch displacements (default patch.out).</manpage>
  
  </Field>
  
  <Field name="SolveFile">
    
    <short>solvefile</short>
    
    <type>FN</type>
    
    <usage>Initial transform file (default solve.xf)</usage>
    
    <tooltip />
    
    <manpage>Name of the existing file with the initial transformation between volumes (default solve.xf).</manpage>
  
  </Field>
  
  <Field name="RefineFile">
    
    <short>refinefile</short>
    
    <type>FN</type>
    
    <usage>Refining transform output file (default refine.xf)</usage>
    
    <tooltip />
    
    <manpage>Name of the file into which Refinematch(1) will place the refining transformation (default refine.xf).</manpage>
  
  </Field>
  
  <Field name="InverseFile">
    
    <short>inversefile</short>
    
    <type>FN</type>
    
    <usage>Inverse transform output file (default inverse.xf)</usage>
    
    <tooltip />
    
    <manpage>Name of the file into which Matchvol(1) will place the inverse cumulative transformation (default inverse.xf).</manpage>
  
  </Field>
  
  <Field name="WarpFile">
    
    <short>warpfile</short>
    
    <type>FN</type>
    
    <usage>Warp transform output file (default warp.xf)</usage>
    
    <tooltip />
    
    <manpage>Name of the file into which Warpvol(1) will place the inverse warping transformations (default warp.xf).</manpage>
  
  </Field>
  
  <Field name="ResidualFile">
    
    <short>residualfile</short>
    
    <type>FN</type>
    
    <usage>Output file for patch displacements with residuals</usage>
    
    <tooltip />
    
    <manpage>Name of the file into which Refinematch(1) and/or Warpvol(1) will place a new list of the patches, their displacements, and the residual from the fits.</manpage>
  
  </Field>
  
  <Field name="VectorModel">
    
    <short>vectormodel</short>
    
    <type>FN</type>
    
    <usage>Output file for model of patches with residuals</usage>
    
    <tooltip />
    
    <manpage>Name of patch vector model file to create from the residual file with Patch2imod(1).</manpage>
  
  </Field>
  
  <Field name="ClipPlaneBoxSize">
    
    <short>clipsize</short>
    
    <type>I</type>
    
    <usage>Size of clipping plane box in patch model</usage>
    
    <tooltip />
    
    <manpage>If writing a patch vector model, set up four clipping planes enclosing a square central area of the given size.</manpage>
  
  </Field>
  
  <Field name="TemporaryDirectory">
    
    <short>tempdir</short>
    
    <type>FN</type>
    
    <usage>Directory for temporary files</usage>
    
    <tooltip />
    
    <manpage>Path name of directory into which Matchvol or Warpvol can place temporary files.</manpage>
  
  </Field>
  
  <Field name="XLowerExclude">
    
    <short>xlowerexclude</short>
    
    <type>I</type>
    
    <usage>Columns to exclude on the left side</usage>
    
    <tooltip />
    
    <manpage>The number of columns of patches to exclude on the left side of the volume.</manpage>
  
  </Field>
  
  <Field name="XUpperExclude">
    
    <short>xupperexclude</short>
    
    <type>I</type>
    
    <usage>Columns to exclude on the right side</usage>
    
    <tooltip />
    
    <manpage>The number of columns of patches to exclude on the right side of the volume.</manpage>
  
  </Field>
  
  <Field name="YLowerExclude">
    
    <short>ylowerexclude</short>
    
    <type>I</type>
    
    <usage>Rows or slabs to exclude at low Y</usage>
    
    <tooltip />
    
    <manpage>The number of rows or slabs of patches to exclude on the lower Y side of the volume.</manpage>
  
  </Field>
  
  <Field name="YUpperExclude">
    
    <short>yupperexclude</short>
    
    <type>I</type>
    
    <usage>Rows or slabs to exclude at high Y</usage>
    
    <tooltip />
    
    <manpage>The number of rows or slabs of patches to exclude on the upper Y side of the volume.</manpage>
  
  </Field>
  
  <Field name="ZLowerExclude">
    
    <short>zlowerexclude</short>
    
    <type>I</type>
    
    <usage>Slabs or rows to exclude at low Z</usage>
    
    <tooltip />
    
    <manpage>The number of slabs or rows of patches to exclude on the lower Z side of the volume.  This would be used to specify rows on the bottom when viewing a volume in flipped orientation.</manpage>
  
  </Field>
  
  <Field name="ZUpperExclude">
    
    <short>zupperexclude</short>
    
    <type>I</type>
    
    <usage>Slabs or rows to exclude at high Z</usage>
    
    <tooltip />
    
    <manpage>The number of slabs or rows of patches to exclude on the upper Z side of the volume.  This would be used to specify rows on the top when viewing a volume in flipped orientation.</manpage>
  
  </Field>
  
  <Field name="LinearInterpolation">
    
    <short>linear</short>
    
    <type>B</type>
    
    <usage>Use linear interpolation in Matchvol/Warpvol</usage>
    
    <tooltip />
    
    <manpage>Use linear instead of quadratic interpolation for transforming the volume with Matchvol(1) or Warpvol(1).</manpage>
  
  </Field>
  
  <Field name="TrialMode">
    
    <short>trial</short>
    
    <type>B</type>
    
    <usage>Run Refinewarp/Findwarp but not Matchvol/Warpvol</usage>
    
    <tooltip />
    
    <manpage>Use a trial mode, in which the program exits after finding a good fit rather than going on to Matchvol or Warpvol.</manpage>
  
  </Field>
  
  <Field name="IterationsToRun">
    
    <short>iterations</short>
    
    <type>I</type>
    
    <usage>Number of times to find warping and warp the volume</usage>
    
    <tooltip />
    
    <manpage>Number of times to run the operations of finding a warping and warping the volume.  Iterations are numbered from 1, the initial sequence of Findwarp(1) and Warpvol(1) considered to be iteration 1.</manpage>
  
  </Field>
  
  <Field name="StopIteratingCriteria">
    
    <short>stop</short>
    
    <type>FT</type>
    
    <usage>Factors for counting increases in mean residual and for stopping from increases in mean and max</usage>
    
    <tooltip />
    
    <manpage>The program stops iterating if the the mean residual error from Findwarp(1) increases enough twice in a row, or if either the mean or the maximum mean residual increase too much from the prior iteration.  This option takes 3 entries: the factor by which the mean residual must increase for it to be counted as an increase for stopping purposes (default 1.03), and the factors by which the mean or maximum mean residual must increase for it to stop immediately (defaults 1.25 and 2.0).  When the iterations are stopped through this mechanism, the program will issue a warning that the existing &quot;mat&quot; file from the previous iteration is still usable for combining.  This stopping capability was introduced when the wrong transforms were being written but might still be useful for pathological situations.</manpage>
  
  </Field>
  
  <Field name="PatchcorrCommandFile">
    
    <short>patchcorr</short>
    
    <type>FN</type>
    
    <usage>Command file for running Corrsearch3d when iterating (default patchcorr.com)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
