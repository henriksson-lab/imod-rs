<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData />
  
  <Field name="ImageInputFile">
    
    <short>imin</short>
    
    <type>FN</type>
    
    <usage>Image input file</usage>
    
    <tooltip />
    
    <manpage>Image input file, which may or may not be a montage.  If this option is not entered, the first non-option argument is taken as the input file.</manpage>
  
  </Field>
  
  <Field name="PieceListInput">
    
    <short>plin</short>
    
    <type>FN</type>
    
    <usage>File with list of piece coordinates for image input file</usage>
    
    <tooltip />
    
    <manpage>File with list of piece coordinates for image input file, if it is a montage.</manpage>
  
  </Field>
  
  <Field name="ImageOutputFile">
    
    <short>imout</short>
    
    <type>FN</type>
    
    <usage>Output file for montaged images</usage>
    
    <tooltip />
    
    <manpage>Output file for montaged images.  If this option is not entered, the second non-option argument is taken as the output file.</manpage>
  
  </Field>
  
  <Field name="PieceListOutput">
    
    <short>plout</short>
    
    <type>FNM</type>
    
    <usage>File for list of coordinates of pieces in output image file (required)</usage>
    
    <tooltip />
    
    <manpage>File for list of coordinates of pieces in output image file.</manpage>
  
  </Field>
  
  <Field name="SectionsToDo">
    
    <short>sections</short>
    
    <type>LIM</type>
    
    <usage>List of sections to use from input file, numbered from 0 (default all)</usage>
    
    <tooltip />
    
    <manpage>List of sections to use from input file, numbered from 0. Ranges may be entered (e.g., 1-3,5,8). If no list is entered, all sections will be used.  Note that montages can have missing sections, and a list that includes such missing sections will generate an error.</manpage>
  
  </Field>
  
  <Field name="ModeToOutput">
    
    <short>mode</short>
    
    <type>I</type>
    
    <usage>Mode of output file; 0 for byte, 1 or 6 for integer, 2 or 12 for float</usage>
    
    <tooltip />
    
    <manpage>The storage mode of the output file; 0 for byte, 1 for 16-bit signed integer, 6 for 16-bit unsigned integer, 2 for 32-bit floating point, or 12 for 16-bit floating point. The default is the mode of the input file, although the default mode of floating point output for MRC files is governed by the value of environment variable IMOD_WRITE_FLOATS_16BIT.  Mode 12 is allowed only if the output format is MRC.</manpage>
  
  </Field>
  
  <Field name="FloatToRange">
    
    <short>float</short>
    
    <type>B</type>
    
    <usage>Rescale densities of sections separately to fill data range</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="BinByFactor">
    
    <short>bin</short>
    
    <type>I</type>
    
    <usage>Use binning to reduce images in size by the given factor (default 1)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="StartingAndEndingX">
    
    <short>xminmax</short>
    
    <type>IP</type>
    
    <usage>Minimum and maximum X index coordinates to output</usage>
    
    <tooltip />
    
    <manpage>Minimum and maximum X index coordinates to output (numbered from 0). The default is to output the entire image.</manpage>
  
  </Field>
  
  <Field name="StartingAndEndingY">
    
    <short>yminmax</short>
    
    <type>IP</type>
    
    <usage>Minimum and maximum Y index coordinates to output</usage>
    
    <tooltip />
    
    <manpage>Minimum and maximum Y index coordinates to output (numbered from 0).</manpage>
  
  </Field>
  
  <Field name="MaximumFrameSizeXandY">
    
    <short>frame</short>
    
    <type>IP</type>
    
    <usage>Maximum size of output pieces in X and Y (default 0,0 for unlimited)</usage>
    
    <tooltip />
    
    <manpage>Maximum size of output pieces in X and Y; pieces will be made smaller as needed to divide the output region into equal pieces.  Enter 0,0 to output data in a single frame (which is the default)</manpage>
  
  </Field>
  
  <Field name="MinimumOverlapXandY">
    
    <short>overlap</short>
    
    <type>IP</type>
    
    <usage>Minimum overlap between output pieces in X and Y (default 0, 0)</usage>
    
    <tooltip />
    
    <manpage>Minimum overlap between output pieces in X and Y.  Pieces may overlap more than this as needed to divide the output region into equal pieces.  The default is 0,0 for no overlap.</manpage>
  
  </Field>
  
  <Field name="NoResizeForFFT">
    
    <short>nofft</short>
    
    <type>B</type>
    
    <usage>Do not increase output frame size to legal size for FFT</usage>
    
    <tooltip />
    
    <manpage>Do not increase the size of the output to be suitable for taking an FFT.  By default, output sizes are increased to have no higher prime factor than 19.  This option suppresses that increase, and the only constraint is that the output frame sizes be even.</manpage>
  
  </Field>
  
  <Field name="LineLoadLimit">
    
    <short>line</short>
    
    <type>I</type>
    
    <usage>Maximum megabytes of memory allowed for loading a single-frame image</usage>
    
    <tooltip />
    
    <manpage>When the input image is a single frame, it will be loaded in strips when loading an entire section would take more than the given number of meagabytes of memory.  The default is 1000.</manpage>
  
  </Field>
  
  <Field name="ParameterFile">
    
    <short>param</short>
    
    <type>PF</type>
    
    <usage>Read parameter entries from file</usage>
    
    <tooltip />
    
    <manpage>Read parameter entries as keyword-value pairs from a parameter file.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
