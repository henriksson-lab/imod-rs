<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="XCorrCommandFile">
    
    <short>xcorr</short>
    
    <type>FN</type>
    
    <usage>Command file for running Tiltxcorr</usage>
    
    <tooltip />
    
    <manpage>Command file for running Tiltxcorr(1).  Parameters such as number of patches or patch overlap and whether to use a structure measure must already be set.  The default is &quot;xcorr_pt.com&quot; for a single axis data set, or &quot;xcorr_pta.com&quot; or &quot;xcorr_ptb.com&quot; for dual axis.</manpage>
  
  </Field>
  
  <Field name="AlignCommandFile">
    
    <short>align</short>
    
    <type>FN</type>
    
    <usage>Command file for running Tiltalign</usage>
    
    <tooltip />
    
    <manpage>Command file for running Tiltalign(1).  The default is &quot;align.com&quot; for a single axis data set, or &quot;align_pta.com&quot; or &quot;align_ptb.com&quot; for dual axis.</manpage>
  
  </Field>
  
  <Field name="AxisAorB">
    
    <short>axis</short>
    
    <type>I</type>
    
    <usage>A or a for A axis of dual-axis data set, B or b for B axis</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="SearchBlockSize">
    
    <short>search</short>
    
    <type>I</type>
    
    <usage>Number of adjacent sizes and filters to try later in search, or 0 to scan</usage>
    
    <tooltip />
    
    <manpage>Number of adjacent sizes and filters to try at the later steps of the search, or 0 to not search and just scan all the combinations of filters, sizes, binnings, and K factor scalings specified.</manpage>
  
  </Field>
  
  <Field name="TestBinningRange">
    
    <short>binning</short>
    
    <type>IP</type>
    
    <usage>Starting and ending binning values to test (default 1 and 2 for search)</usage>
    
    <tooltip />
    
    <manpage>Starting and ending binning values to test.  If a search is being done and this option is not entered, binning 1 and 2 will be tested if the incoming command file does not specify a higher binning to apply.  The test binnings do not include the amount the images are already binned.</manpage>
  
  </Field>
  
  <Field name="NumFilterSteps">
    
    <short>nfilt</short>
    
    <type>I</type>
    
    <usage>Number of different filters to try</usage>
    
    <tooltip />
    
    <manpage>Number of different filters to try.  The low and high frequency filter values (sigma1, radius2 and sigma2) will be changed proportionally by a multiplicative factor on each step.  If starting and ending values of the high frequency cutoff radius2 are not entered with either \fB-nmrad2\fR or \fB-pixrad2\fR, the range will be set automatically.  For 8 or more steps, the start of the range is 0.2 times the incoming values and the total range will be a 6-fold change.  The range will be scaled down to 4.2-fold for 4 steps, the minimum required for an automatic filter range.</manpage>
  
  </Field>
  
  <Field name="Radius2NanometerRange">
    
    <short>nmrad2</short>
    
    <type>FP</type>
    
    <usage>Starting and ending high frequency cutoffs to try, in reciprocal nm</usage>
    
    <tooltip />
    
    <manpage>Starting and ending high frequency cutoffs to try, in reciprocal nanometers.  Values should be entered in order from low to high.  Only one of \fB-nmrad2\fR and \fB-pixrad2\fR can be entered.</manpage>
  
  </Field>
  
  <Field name="Radius2PixelRange">
    
    <short>pixrad2</short>
    
    <type>FP</type>
    
    <usage>Starting and ending high frequency cutoffs to try, in reciprocal pixels</usage>
    
    <tooltip />
    
    <manpage>Starting and ending high frequency cutoffs to try, in reciprocal pixels.  Values should be entered in order from low to high.</manpage>
  
  </Field>
  
  <Field name="NumPatchSizeSteps">
    
    <short>nsize</short>
    
    <type>I</type>
    
    <usage>Number of different patch sizes to try</usage>
    
    <tooltip />
    
    <manpage>Number of different patch sizes to try.  Size will be increased by a multiplicative factor on each step to go from the low to the high end of the range.  If the patch size in the incoming command file is not square, the geometric mean of the X and Y sizes is used as the basis for scaling, with the aspect ratio kept the same.  If neither \fB-size\fR nor \fB-ubsize\fR is entered, a range will be set automatically.  With 8 or more steps, the start of the range is 0.85 times the incoming size, and the end of the range is twice the start.  The range is scaled down to 1.4-fold for 4 steps, the minimum required for automatic size ranges.</manpage>
  
  </Field>
  
  <Field name="PatchSizeRange">
    
    <short>size</short>
    
    <type>IP</type>
    
    <usage>Low and high end of the range of patch sizes to try, in binned pixels</usage>
    
    <tooltip />
    
    <manpage>Low and high end of the range of patch sizes to try, in binned pixels.   Only one of \fB-size\fR and \fB-ubsize\fR can be entered.</manpage>
  
  </Field>
  
  <Field name="UnbinnedPatchRange">
    
    <short>ubsize</short>
    
    <type>IP</type>
    
    <usage>Low and high end of the range of patch sizes to try, in unbinned pixels</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="NumKFactorSteps">
    
    <short>nkfac</short>
    
    <type>I</type>
    
    <usage>Number of different K factor scalings to try for robust alignment</usage>
    
    <tooltip />
    
    <manpage>Number of different K factor scalings to try for robust alignment. If no range is entered, the range will set automatically to be symmetric around 1 and have steps of 0.1 for 9 or more scalings.  The step size will increase to 0.2 and the range will decrease to 0.6 for 4 scalings, the minimum required for an automatic range.</manpage>
  
  </Field>
  
  <Field name="KFactorRange">
    
    <short>kfac</short>
    
    <type>FP</type>
    
    <usage>Starting and ending K factor scalings to try</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="NumExpandSteps">
    
    <short>nexpand</short>
    
    <type>I</type>
    
    <usage>Number of different patch expansion factors to try</usage>
    
    <tooltip />
    
    <manpage>Number of different patch expansion factors to try.  Starting and ending factors must be entered with the \fB-expand\fR option.</manpage>
  
  </Field>
  
  <Field name="ExpansionRange">
    
    <short>expand</short>
    
    <type>FP</type>
    
    <usage>Starting and ending expansion factors to try (1 for no expansion)</usage>
    
    <tooltip />
    
    <manpage>Starting and ending expansion factors to try.  No expansion occurs with 1, so this would be the typical starting value.</manpage>
  
  </Field>
  
  <Field name="PatchOverlapToUseXandY">
    
    <short>overlap</short>
    
    <type>FP</type>
    
    <usage>Overlap between patches in X and Y to use for tests and in new command file</usage>
    
    <tooltip />
    
    <manpage>Overlap between patches in X and Y to use for tests and in the new command file that is written; this is used for the \fB-overlap\fR option to Tiltxcorr(1) if the incoming command file specifies overlap instead of number of patches. Otherwise, this entry is ignored.</manpage>
  
  </Field>
  
  <Field name="ConstantNumberOfPatches">
    
    <short>constant</short>
    
    <type>B</type>
    
    <usage>Switch from using a fixed patch overlap to a fixed number of patches</usage>
    
    <tooltip />
    
    <manpage>Switch from using a fixed patch overlap to a fixed number of patches.  This will prevent the number of patches from dropping as the size is increased and will avoid having to use cross-validation.  The number of patches is set from the size and overlap entries in the incoming command file, or from a revised overlap given with the \fB-overlap\fR option.  The new command file written at the end will have a number of patches instead of an overlap.  This option is ignored if patch number is already specified in the input command file.</manpage>
  
  </Field>
  
  <Field name="MinStructureModeFrac">
    
    <short>struct</short>
    
    <type>F</type>
    
    <usage>Skip patches with a structure measure less than this fraction of the mode</usage>
    
    <tooltip />
    
    <manpage>Skip patches with a summed structure measure less than the given fraction of the mode of this measure.  This option is passed to Tiltxcorr(1); see that man page for details.  Values around 0-6-0.7 may be useful.</manpage>
  
  </Field>
  
  <Field name="CrossValidation">
    
    <short>cross</short>
    
    <type>B</type>
    
    <usage>Do cross-validation and use leave-out error in all cases</usage>
    
    <tooltip />
    
    <manpage>Do cross-validation and use the leave-out error and the error to minimize regardless of the parameters.  By default, the program will skip cross-validation and use the mean residual in situations where the two kinds of errors are expected to change in tandem.  Not only is this faster, but it gives a somewhat smoother surface for the minimization because leave-out errors vary from run to run.  However, this option is available to avoid this assumption that errors change together,</manpage>
  
  </Field>
  
  <Field name="UseGPU">
    
    <short>gpu</short>
    
    <type>I</type>
    
    <usage>Set the UseGPU option in the Tiltxcorr command file with given value</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="VerboseOutput">
    
    <short>verbose</short>
    
    <type>I</type>
    
    <usage>1 for more detailed output instead of summaries</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
