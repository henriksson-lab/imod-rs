<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputImageFile">
    
    <short>input</short>
    
    <long>InputImageFile</long>
    
    <type>FN</type>
    
    <usage>Image file with tilt angles and intensities in header</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="OutputFile">
    
    <short>output</short>
    
    <long>OutputFile</long>
    
    <type>FN</type>
    
    <usage>Output file for tilt angles and mag gradients</usage>
    
    <tooltip />
    
    <manpage>Output file for tilt angles and mag gradients.  This file will be in the format required for the -gradient entries to Newstack and Xfmodel.</manpage>
  
  </Field>
  
  <Field name="GradientTable">
    
    <short>gradient</short>
    
    <long>GradientTable</long>
    
    <type>FN</type>
    
    <usage>File with table of mag gradients versus intensity (required)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="RotationAngle">
    
    <short>rotation</short>
    
    <long>RotationAngle</long>
    
    <type>F</type>
    
    <usage>Rotation angle from the Y axis to the tilt axis (required)</usage>
    
    <tooltip />
    
    <manpage>Angle of rotation of the tilt axis in the images; specifically, the angle from the vertical to the tilt axis (counterclockwise positive).</manpage>
  
  </Field>
  
  <Field name="PixelSize">
    
    <short>pixel</short>
    
    <long>PixelSize</long>
    
    <type>F</type>
    
    <usage>Pixel size in nanometers (optional if pixel size is in header)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="DeltaGradient">
    
    <short>dgrad</short>
    
    <long>DeltaGradient</long>
    
    <type>F</type>
    
    <usage>Amount to add to all mag gradients, in % per micron of Z height</usage>
    
    <tooltip />
    
    <manpage>Amount to add to all mag gradients, in % per micron of Z height. This can be used to experiment with different gradients.</manpage>
  
  </Field>
  
  <Field name="DeltaRotation">
    
    <short>drot</short>
    
    <long>DeltaRotation</long>
    
    <type>F</type>
    
    <usage>Amount to add to all rotations, in degrees per micron of Z height</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <long>usage</long>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
