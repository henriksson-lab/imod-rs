<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputFile">
    
    <short>input</short>
    
    <type>FN</type>
    
    <usage>Input image file with distortion pairs</usage>
    
    <tooltip />
    
    <manpage>Input image file with distortion pairs.  If this option is not entered, the first non-option argument will be taken as the input file name.</manpage>
  
  </Field>
  
  <Field name="OutputRoot">
    
    <short>output</short>
    
    <type>FN</type>
    
    <usage>Root name for output files</usage>
    
    <tooltip />
    
    <manpage>Root name for output files.  If this option is not entered, the second non-option argument will be used as the root name.</manpage>
  
  </Field>
  
  <Field name="PairsToAnalyze">
    
    <short>pairs</short>
    
    <type>LI</type>
    
    <usage>List of images to analyze in pairs (from 0, default is all images)</usage>
    
    <tooltip />
    
    <manpage>List of images to analyze in pairs; for example 0-7 if sections 0 and 1, 2 and 3, 4 and 5, and 6 and 7 are all image pairs.  The default is to assume that all images in the file form successive pairs.  Sections are numbered from 0.</manpage>
  
  </Field>
  
  <Field name="ImageBinning">
    
    <short>binning</short>
    
    <type>I</type>
    
    <usage>Binning of images on the CCD camera (default 2)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="FieldSpacing">
    
    <short>field</short>
    
    <type>I</type>
    
    <usage>Pixel spacing for output distortion field (default 40)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="DataSpacing">
    
    <short>data</short>
    
    <type>I</type>
    
    <usage>Pixel spacing for data used to solve linear equations (default 20)</usage>
    
    <tooltip />
    
    <manpage>Pixel spacing for data used to solve linear equations for the distortion field.  This spacing should be about half of the spacing for the output field.  The default is 20.</manpage>
  
  </Field>
  
  <Field name="GridSpacing">
    
    <short>grid</short>
    
    <type>I</type>
    
    <usage>Pixel spacing for grid of displacements in overlap zones (default 16)</usage>
    
    <tooltip />
    
    <manpage>Pixel spacing for grid on which displacements will be measured in the overlap zones between paired images (default 16).</manpage>
  
  </Field>
  
  <Field name="BoxSize">
    
    <short>box</short>
    
    <type>I</type>
    
    <usage>Size of box used to measure local displacements (default 24)</usage>
    
    <tooltip />
    
    <manpage>Size of box used to measure local displacements.  Boxes of this size will be correlated between the two images at every position on the grid. The default is 24.  This value should be increased if the solution is noisy.</manpage>
  
  </Field>
  
  <Field name="GridIndent">
    
    <short>indent</short>
    
    <type>I</type>
    
    <usage>Amount to indent the boxes in the grid of displacements (default 4)</usage>
    
    <tooltip />
    
    <manpage>Amount to indent the boxes in the grid of displacements from the edge of the overlap zone.  The default is 4 pixels; this vakue can be dropped to 2 for larger than default boxes.</manpage>
  
  </Field>
  
  <Field name="Iterations">
    
    <short>iterations</short>
    
    <type>I</type>
    
    <usage>Maximum number of iterations when solving equations</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="UseOldTransforms">
    
    <short>usexf</short>
    
    <type>B</type>
    
    <usage>Use existing transforms on first iteration</usage>
    
    <tooltip />
    
    <manpage>Use existing transforms instead of running Tiltxcorr on the first iteration; these transforms are stored in the file rootname.rawxf when Tiltxcorr is run on the first iteration.</manpage>
  
  </Field>
  
  <Field name="StretchFile">
    
    <short>strfile</short>
    
    <type>FN</type>
    
    <usage>File with transformation aligning 90-degree rotated images</usage>
    
    <tooltip />
    
    <manpage>File with transformation that aligns two 90-degree rotated images of the same area.  This transformation is used to determine the absolute stretch in the distortion field.</manpage>
  
  </Field>
  
  <Field name="PatchOutput">
    
    <short>patch</short>
    
    <type>B</type>
    
    <usage>Output a patch file to convert to a model with patch2imod</usage>
    
    <tooltip />
    
    <manpage>Output a patch file to convert to a model with patch2imod.  The patch file will be named rootname.patch.</manpage>
  
  </Field>
  
  <Field name="CoverageImage">
    
    <short>coverage</short>
    
    <type>FN</type>
    
    <usage>Name of output file for image of data coverage for vectors</usage>
    
    <tooltip />
    
    <manpage>Name of file in which to place an image representing the amount of data available for solving each vector.  This is image is based on the sum of the coefficients for each distortion vectors, normalized so that the mean sum will equal the ratio of total measurements to unknowns (rows to columns in the data matrix).  To get a true representation of the amount of nonredundant coverage of each field position, use -data to set the data spacing the same as the field spacing.</manpage>
  
  </Field>
  
  <Field name="RedirectOutput">
    
    <short>redirect</short>
    
    <type>CH</type>
    
    <usage>String for redirecting output (default &quot;&gt; /dev/null&quot;)</usage>
    
    <tooltip />
    
    <manpage>String for redirecting output from Tiltxcorr and Newstack.  The default is &quot;&gt; /dev/null&quot;, which will not work in Windows.  A valid Windows path must be entered; &quot;&gt; xcorr.tmp&quot; would work.</manpage>
  
  </Field>
  
  <Field name="SolveWithMultr">
    
    <short>multr</short>
    
    <type>B</type>
    
    <usage>Use matrix inversion instead of iterative method</usage>
    
    <tooltip />
    
    <manpage>Use matrix inversion instead of iterative method to solve equations.</manpage>
  
  </Field>
  
  <Field name="ParameterFile">
    
    <short>param</short>
    
    <type>PF</type>
    
    <usage>Read parameter entries from file</usage>
    
    <tooltip />
    
    <manpage>Read parameter entries as keyword-value pairs from a parameter file.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage>Print help output.</manpage>
  
  </Field>

</autodoc>
