<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputStack">
    
    <short>input</short>
    
    <type>FN</type>
    
    <usage>Input image file</usage>
    
    <tooltip />
    
    <manpage>Input image file.</manpage>
  
  </Field>
  
  <Field name="OutputFileName">
    
    <short>output</short>
    
    <type>FN</type>
    
    <usage>Output image file, the filtered image or a mask image</usage>
    
    <tooltip />
    
    <manpage>Output image file, the filtered image or a mask image</manpage>
  
  </Field>
  
  <Field name="AnglesFile">
    
    <short>angles</short>
    
    <type>FN</type>
    
    <usage>Tilt angles file.</usage>
    
    <tooltip />
    
    <manpage>Tilt angles file, one angle per line.</manpage>
  
  </Field>
  
  <Field name="Sigma">
    
    <short>s</short>
    
    <type>FA</type>
    
    <usage>Initial sigma (in pixels), typically the radius of gold particles</usage>
    
    <tooltip />
    
    <manpage>Sigma (in pixels) for initial Gaussian smoothing, typically approximately the same as the radius of the gold particles.  This entry is required.</manpage>
  
  </Field>
  
  <Field name="Alpha">
    
    <short>a</short>
    
    <type>FA</type>
    
    <usage>Alpha, typical values from 0.2 to 0.5</usage>
    
    <tooltip />
    
    <manpage>Alpha, the fraction of the initial sigma used as the sigma of a Gaussian for smoothing the difference between the initially smoothed and original image.  Typical values are 0.2 to 0.5; default is 0.5.</manpage>
  
  </Field>
  
  <Field name="Beta">
    
    <short>b</short>
    
    <type>FA</type>
    
    <usage>Sigma beta (in pixels),  typical values from 0.5 to 8</usage>
    
    <tooltip />
    
    <manpage>Sigma beta (in pixels) for Gaussian smoothing of regions above threshold during diffusion iterations.  Typical values are from 0.5 to 8; the default is 0.5 and not very useful.</manpage>
  
  </Field>
  
  <Field name="Tau">
    
    <short>t</short>
    
    <type>FA</type>
    
    <usage>Tau (threshold value), typical values from  0.1 to 0.2</usage>
    
    <tooltip />
    
    <manpage>Tau, the threshold fraction of the maximum gradient for regions to be smoothed.  Typical values are from 0.1 to 0.2; the default is 0.1.</manpage>
  
  </Field>
  
  <Field name="Iterations">
    
    <short>ite</short>
    
    <type>IA</type>
    
    <usage>Number of iterations in the smoothing process, typically from 3 to 20, 1 if -mask</usage>
    
    <tooltip />
    
    <manpage>Number of iterations in the smoothing process, irrelevant if the \fB-mask\fR option is used.  The default is 1, which is not very useful; typical values are 3 to 20.</manpage>
  
  </Field>
  
  <Field name="InputMask">
    
    <short>im</short>
    
    <type>FN</type>
    
    <usage>Input image file with mask to apply, defining areas to be smoothed</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="MaskOutput">
    
    <short>mask</short>
    
    <type>B</type>
    
    <usage>Produce a binary mask as output</usage>
    
    <tooltip />
    
    <manpage>Produce a binary mask as output</manpage>
  
  </Field>
  
  <Field name="ViewsToProcess">
    
    <short>views</short>
    
    <type>LI</type>
    
    <usage>List of views to process (not implemented)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
