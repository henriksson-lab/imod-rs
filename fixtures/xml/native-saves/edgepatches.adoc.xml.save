<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InfoFile">
    
    <short>info</short>
    
    <type>FN</type>
    
    <usage>Name of supermontage info file</usage>
    
    <tooltip />
    
    <manpage>Name of a supermontage info file in which data about the files are stored.  The file must exists.  It will be read in when the program starts, and renamed to filename~ before writing a new version after various operations. If this option is not entered, the first non-option argument will be taken as the name of the info file.</manpage>
  
  </Field>
  
  <Field name="RunAll">
    
    <short>all</short>
    
    <type>B</type>
    
    <usage>Analyze overlap zones for all frames</usage>
    
    <tooltip />
    
    <manpage>Analyze overlap zones for all frames.  No analysis will be done unless this option or one or more of -xrun, -yrun, or -zrun are entered.</manpage>
  
  </Field>
  
  <Field name="XRunStartEnd">
    
    <short>xrun</short>
    
    <type>IP</type>
    
    <usage>Starting and ending frame numbers in X for overlap zones to analyze</usage>
    
    <tooltip />
    
    <manpage>Starting and ending frame numbers in X surrounding the overlap zones to analyze.</manpage>
  
  </Field>
  
  <Field name="YRunStartEnd">
    
    <short>yrun</short>
    
    <type>IP</type>
    
    <usage>Starting and ending frame number in Y for overlap zones to analyze</usage>
    
    <tooltip />
    
    <manpage>Starting and ending frame numbers in Y surrounding the overlap zones to analyze.  For example, to analyze one overlap zone between two pieces adjacent in X, enter the two frame numbers in X for -xrun and the Y frame number for -yrun, such as &quot;-xrun 2,3 -yrun 2,2&quot;.</manpage>
  
  </Field>
  
  <Field name="ZRunStartEnd">
    
    <short>zrun</short>
    
    <type>IP</type>
    
    <usage>Starting and ending Z value for overlap zones to analyze</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="SkipDone">
    
    <short>skip</short>
    
    <type>B</type>
    
    <usage>Skip any overlap zones that were already analyzed</usage>
    
    <tooltip />
    
    <manpage>Skip any overlap zones that were already analyzed.  The default is to use any shifts that were found previously but to rerun patch correlations.</manpage>
  
  </Field>
  
  <Field name="RedoShifts">
    
    <short>redo</short>
    
    <type>B</type>
    
    <usage>Recompute the shifts between frames if already done</usage>
    
    <tooltip />
    
    <manpage>Recompute the shifts between frames for any that were already done.</manpage>
  
  </Field>
  
  <Field name="UseProjXformFile">
    
    <short>use</short>
    
    <type>B</type>
    
    <usage>Recompute 3D shifts starting with the 2D shifts in the .projxf files</usage>
    
    <tooltip />
    
    <manpage>Redo the 3D cross-correlations in the center of the overlap zones, taking the initial shifts from existing &quot;.projxf&quot; for each overlap zone instead of redoing projections and 2D correlations.  Use this option after fixing the initial shift with Midas(1).  This option implies the &quot;-redo&quot; option.</manpage>
  
  </Field>
  
  <Field name="IgnoreLastShifts">
    
    <short>ignore</short>
    
    <type>B</type>
    
    <usage>Use original overlap values as starting shifts for 2D correlations</usage>
    
    <tooltip />
    
    <manpage>Use original overlap values as the basis for the starting shifts when redoing 2D correlations.  By default, the program uses the current shift from the info file to determine what areas to project and correlate in an overlap zone, so that one can edit a correct value into the file.  Use this option to make it ignore previous, incorrect values of the shift, such as if you need to rerun the correlations with a different long fraction value.</manpage>
  
  </Field>
  
  <Field name="LongFraction">
    
    <short>long</short>
    
    <type>F</type>
    
    <usage>Fraction of long dimension of the overlap zone to use for finding shift</usage>
    
    <tooltip />
    
    <manpage>Fraction of long dimension of the overlap zone to use for finding the X/Y shift between the projections of the two pieces.  The default is 0.5.  When pieces are significantly skewed from each other, rather than arranged nearly horizontally or vertically, this fraction should be made higher, such as 1.0.</manpage>
  
  </Field>
  
  <Field name="OverlapToAssume">
    
    <short>overlap</short>
    
    <type>I</type>
    
    <usage>Number of pixels of overlap to assume when finding initial shifts</usage>
    
    <tooltip />
    
    <manpage>Number of pixels of overlap to assume when finding initial shifts with correlations of 3D projections.  The nominal overlap determines how wide an area is projected for correlating; this entry overrides the overlap entered with Setupstitch.</manpage>
  
  </Field>
  
  <Field name="PatchSizeXYZ">
    
    <short>size</short>
    
    <type>IT</type>
    
    <usage>Size in X, Y, Z of patches to correlate (default 100,100,50)</usage>
    
    <tooltip />
    
    <manpage>Size in X, Y, and Z of patches to correlate.  The default is 100 x 100 x 50.</manpage>
  
  </Field>
  
  <Field name="IntervalsShortLongZ">
    
    <short>intervals</short>
    
    <type>IT</type>
    
    <usage>Interval between patches in short, long, and Z dimension (default 80,120,50)</usage>
    
    <tooltip />
    
    <manpage>Interval between patches in the short, long, and Z dimensions of overlap zones.  The program will use these intervals to determine how many patches to specify when running Corrsearch3d(1).  The defaults are 80,120,50.</manpage>
  
  </Field>
  
  <Field name="ForceNumberInZ">
    
    <short>force</short>
    
    <type>I</type>
    
    <usage>Set the number of patches in Z to the given value</usage>
    
    <tooltip />
    
    <manpage>Set the number of patches in Z to the given value, regardless of the interval between them.</manpage>
  
  </Field>
  
  <Field name="BordersInXYandZ">
    
    <short>borders</short>
    
    <type>IP</type>
    
    <usage>Borders in X/Y and in Z for region to do patches in (default 50,10)</usage>
    
    <tooltip />
    
    <manpage>Borders in X/Y and in Z for region in which to do patch correlations.  These borders are distances from the edge of each image file, and thus define borders in the overlap zone.  The border is X and Y is redundant to limiting the region with a patch region model.  The border in Z is a default value that will be overriden by a Zlimits entry for an individual piece.  The default is 50,10.</manpage>
  
  </Field>
  
  <Field name="KernelSigma">
    
    <short>kernel</short>
    
    <type>F</type>
    
    <usage>Sigma in pixels for real-space smoothing with 3D Gaussian kernel</usage>
    
    <tooltip />
    
    <manpage>Sigma for real-space smoothing with 3D Gaussian kernel (in pixels). Patches will be smoothed before correlating with 3x3x3 kernel (for sigma &lt; 1.5) or a 5x5x5 kernel (sigma not &lt; 1.5) whose coefficients are proportional to a Gaussian with the given sigma centered on the central pixel.</manpage>
  
  </Field>
  
  <Field name="TestMode">
    
    <short>test</short>
    
    <type>I</type>
    
    <usage>Sum of 1 for verbose output and 2 to leave temporary files</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
