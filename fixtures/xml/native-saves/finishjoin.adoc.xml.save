<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="RootName">
    
    <short>name</short>
    
    <type>CH</type>
    
    <usage>Rootname for info file, joined tomogram, and other files</usage>
    
    <tooltip />
    
    <manpage>Rootname for info file, joined tomogram, and other intermediate files. If this option is not entered, the first non-option argument will be taken as the root name.</manpage>
  
  </Field>
  
  <Field name="UseSliceRange">
    
    <short>use</short>
    
    <type>IPM</type>
    
    <usage>Starting and ending slices to include from one tomogram (required for each)</usage>
    
    <tooltip />
    
    <manpage>Starting and ending slices to include from one tomogram. This option must be entered for each tomogram if it is entered at all.  If the option is not entered, the second and following non-option arguments will be used for the entries.  Thus, the program may be run as ^   finishjoin [options]  root_name  slice_range1  slice_range2</manpage>
  
  </Field>
  
  <Field name="ReferenceTomogram">
    
    <short>ref</short>
    
    <type>I</type>
    
    <usage>Tomogram number to use as reference for alignment (numbered from 1)</usage>
    
    <tooltip />
    
    <manpage>Make the given tomogram be the reference for alignment, in which case slices from it will not be transformed, and other tomograms will be transformed into alignment with it.  By default, all tomograms will be transformed into alignment to a position averaged over all tomograms with similar orientations.</manpage>
  
  </Field>
  
  <Field name="AngleRange">
    
    <short>angle</short>
    
    <type>F</type>
    
    <usage>Range of angles for tomograms used to compute the average rotation angle</usage>
    
    <tooltip />
    
    <manpage>Base the average alignment on tomograms whose rotation angles fall within the given range of each other (default 50 degrees).  If a minority of the tomograms are rotated by large angles like 90 or 180 degrees relative to the rest, then they will be excluded when determining the average alignment. This prevents all of the sections from being rotated to an intermediate orientation.</manpage>
  
  </Field>
  
  <Field name="SizeInXandY">
    
    <short>size</short>
    
    <type>IP</type>
    
    <usage>The dimensions of the joined tomogram in X and Y in unbinned pixels</usage>
    
    <tooltip />
    
    <manpage>Set the size of the output slices to X by Y pixels.  The default size will be the maximum X size by the maximum Y size of the input tomograms.  Enter a size in unbinned pixels if binning is being used.</manpage>
  
  </Field>
  
  <Field name="OffsetInXandY">
    
    <short>offset</short>
    
    <type>IP</type>
    
    <usage>Offsets in X and Y from center of image to point that will be new center</usage>
    
    <tooltip />
    
    <manpage>Set the X and Y offsets for the output slices, in unbinned pixels if binning is being used.  These follow the same sign convention as in Newstack(1); namely, the numbers entered should be the offsets from the center of the current image to the image point which is intended to end up in the center of the output image.  A positive offset in X will thus shift the image to the left.</manpage>
  
  </Field>
  
  <Field name="TrialInterval">
    
    <short>trial</short>
    
    <type>I</type>
    
    <usage>Build trial joined file using slices at the given interval</usage>
    
    <tooltip />
    
    <manpage>Build a trial joined tomogram using only slices at the given interval.  The first and last slice of each slice range will always be included.  The output file will be named &quot;rootname&quot;_trial.join.</manpage>
  
  </Field>
  
  <Field name="BinningForTrial">
    
    <short>binning</short>
    
    <type>I</type>
    
    <usage>Binning to apply to images in trial joined file</usage>
    
    <tooltip />
    
    <manpage>Bin images by the given value when building a trial joined tomogram.</manpage>
  
  </Field>
  
  <Field name="LocalFits">
    
    <short>local</short>
    
    <type>B</type>
    
    <usage>Use local fits to 7 sections when running xftoxg</usage>
    
    <tooltip />
    
    <manpage>When running Xftoxg(1) on the primary alignment transforms, run the program in its default mode, which does local fits to 7 adjacent sections. This option may eliminate unwanted trends in data sets with many sections. When it is not entered, Xftoxg(1) is run with &quot;-nfit 0&quot;, which computes a global alignment.</manpage>
  
  </Field>
  
  <Field name="TransformFile">
    
    <short>xform</short>
    
    <type>FN</type>
    
    <usage>Refine alignment with g transforms in the given file</usage>
    
    <tooltip />
    
    <manpage>Use the refinement transforms contained in the given file to compute the transforms to apply to the tomograms.  The file should contain global transforms as computed by Xfjointomo(1).</manpage>
  
  </Field>
  
  <Field name="MaximumSizeOnly">
    
    <short>maxsize</short>
    
    <type>B</type>
    
    <usage>Just compute maximum size and offsets needed to contain transformed data</usage>
    
    <tooltip />
    
    <manpage>Just compute the maximum size and offsets needed to contain the transformed images from all of the sections, given the current transformations.  No image file will be created.</manpage>
  
  </Field>
  
  <Field name="FillGaps">
    
    <short>gaps</short>
    
    <type>B</type>
    
    <usage>Fill gaps with blank slices for slice ranges out of bounds</usage>
    
    <tooltip />
    
    <manpage>Create blank slices when the slice ranges include values out of bounds (below 1 or above the number of slices in the file).  This option can be used to make the gap between two sections bigger than what would be provided by simply stacking all the slices from each file.  Without this option, values out of bounds are not allowed.</manpage>
  
  </Field>
  
  <Field name="NoImage">
    
    <short>no</short>
    
    <type>B</type>
    
    <usage>Do not run anything that requires complete image files</usage>
    
    <tooltip />
    
    <manpage>Do not run anything that requires complete image files, specifically, Newstack(1), and output a file with the Newstack input.</manpage>
  
  </Field>
  
  <Field name="PID">
    
    <type>B</type>
    
    <usage>Print process ID</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
