<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
    
    <DoubleDashOptions />
    
    <NoHelpAbbreviations />
    
    <NoAbbreviations />
  
  </PreData>
  
  <SectionHeader name="Options">
    
    <usage>OPTIONS</usage>
  
  </SectionHeader>
  
  <Field name="help">
    
    <short>h</short>
    
    <type>B</type>
    
    <usage>Output usage message.</usage>
  
  </Field>
  
  <Field name="computersection">
    
    <format>\fR[\fIIalternative_computer_section\fR]</format>
    
    <usage>Controls which type of section in cpu.adoc will be loaded into the CPU and GPU tables.  To prevent these tables from being filled from cpu.adoc, omit the value.</usage>
    
    <manpage>Used to customize which sections from the cpu.adoc will be loaded into the CPU and GPU tables.  When not in use, &quot;Computer&quot; sections will be loaded.  If the value is omitted, nothing will be loaded from the cpu.adoc into the CPU and GPU tables.</manpage>
  
  </Field>
  
  <Field name="listen">
    
    <type>B</type>
    
    <usage>Run 3dmod with -L (Windows only).</usage>
    
    <manpage>Forces all 3dmods to be run with the -L option.  This only has an effect on Windows computers because -L is always used on Linux and Mac.</manpage>
  
  </Field>
  
  <Field name="moveb">
    
    <type>B</type>
    
    <usage>Automatically keeps the B axis window out of the way of the A axis window.</usage>
    
    <manpage>Moves the B axis window to the left of the A axis window when a major resizing event occurs.</manpage>
  
  </Field>
  
  <Field name="namingstyle">
    
    <format>\fB0\fR|\fB1\fR|\fB2</format>
    
    <usage>Sets the file name style for a new dataset.  \fB0\fRnon-standard,\fB1\fRmrc,\fB2\fRhdf.</usage>
    
    <manpage>Sets the file name style for a new dataset.  Overrides the IMOD_OUTPUT_FORMAT environment variable for file name style only.  This does not affect the file format - just the file names.  \fB0\fR: the old non-standard file name.  \fB1\fR:the standard mrc extension.  \fB2\fR:The standard hdf extension.</manpage>
  
  </Field>
  
  <Field name="queuesection">
    
    <format>\fR[\fIIalternative_queue_section\fR]</format>
    
    <usage>Controls which type of section in cpu.adoc will be loaded into the Queue table.  To prevent this table from being fileed from cpu.adoc, omit the value.</usage>
    
    <manpage>Used to customize which sections from the cpu.adoc will be loaded into the Queue table.  When not in use, &quot;Queue&quot; sections will be loaded.  If the value is omitted, nothing will be loaded from the cpu.adoc into the Queue table.</manpage>
  
  </Field>
  
  <Field name="timestamp">
    
    <type>B</type>
    
    <usage>Timestamp processes.</usage>
    
    <manpage>Send timestamps to standard error before and after processes are run.</manpage>
  
  </Field>
  
  <Field name="userTemplateLoc">
    
    <format>\fB&quot;\fIdirectory_path\fB&quot;</format>
    
    <usage>Adds a second User Template directory.</usage>
    
    <manpage>Adds a second User Template directory, in addition to one set in the Settings dialog.</manpage>
  
  </Field>
  
  <SectionHeader name="DirectiveAutomationOptions">
    
    <usage>AUTOMATION OPTIONS - DIRECTIVE FILE</usage>
  
  </SectionHeader>
  
  <Field name="directive">
    
    <format>\fB&quot;\fIdirective_file\fB.adoc&quot;</format>
    
    <usage>Do automation based on the directive_file.adoc.</usage>
    
    <manpage>Causes automation to be performed based on a file called \fIdirective_file\fB.adoc\fR.  No interface will come up and some command-line automation options will have no effect. ^Command-line automation options\fR that can be used with these options: ^   \fB--axis\fR ^   \fB--cpus\fR ^   \fB--dataset\fR ^   \fB--fiducial\fR ^   \fB--frame\fR ^   \fB--gpus\fR ^These options are automatically set to true when \fB--directive\fR is used: ^   \fB--fg\fR ^   \fB--headless\fR ^   \fB--create\fR ^   \fB--exit\fR ^The directive file must end in &quot;.adoc&quot; and conform to autodoc syntax.</manpage>
  
  </Field>
  
  <Field name="fromBRT">
    
    <type>B</type>
    
    <usage>Prevents Etomo from calling batchruntomo for validation.  Only used by batchruntomo when calling Etomo.</usage>
    
    <manpage>Used when batchruntomo calls Etomo.  Prevents Etomo from calling batchruntomo for validation.  Not used for calling Etomo from the command line.  When this option is used values from \fBbatchDefaults.adoc\fR will be used in addition to any templates that are set.</manpage>
  
  </Field>
  
  <SectionHeader name="CommandAutomationOptions">
    
    <usage>AUTOMATION OPTIONS - COMMAND LINE</usage>
  
  </SectionHeader>
  
  <Field name="axis">
    
    <format>\fBsingle\fR|\fBdual</format>
    
    <usage>Sets the Axis Type in the Setup Tomogram dialog during automation.</usage>
  
  </Field>
  
  <Field name="cpus">
    
    <format>\fR[ignored]</format>
    
    <usage>Turns on the Parallel Processing checkbox in the Setup Tomogram dialog.</usage>
  
  </Field>
  
  <Field name="create">
    
    <type>B</type>
    
    <usage>Runs Create Com Scripts in the Setup Tomogram dialog during automation.</usage>
  
  </Field>
  
  <Field name="dataset">
    
    <format>\fItilt_series_file</format>
    
    <usage>Deprecated.  Same as rawimagestack.</usage>
  
  </Field>
  
  <Field name="rawimagestack">
    
    <format>\fItilt_series_file</format>
    
    <usage>Sets Raw Image Stack in the Setup Tomogram dialog during automation.</usage>
    
    <manpage>Sets Raw Image Stack in the Setup Tomogram dialog during automation. The value should be set to a file containing a tilt series. The file must be in the local directory unless a file path is included or the \fB--dir\fR option is used.</manpage>
  
  </Field>
  
  <Field name="dir">
    
    <format>\fB&quot;\fIdirectory_path\fB&quot;</format>
    
    <usage>The location of the dataset during automation.</usage>
    
    <manpage>For automation.  The absolute or relative directory containing the file or dataset specified with the \fB--dataset\fR option.</manpage>
  
  </Field>
  
  <Field name="exit">
    
    <type>B</type>
    
    <usage>During automation, exit after the Setup Tomogram dialog has completed.</usage>
  
  </Field>
  
  <Field name="fg">
    
    <type>B</type>
    
    <usage>Run Etomo in the foreground.</usage>
    
    <manpage>Causes Etomo to be run in the foreground rather then in the background.  This is useful when running Etomo with automation from a script because a script will not wait until a background command has completed.</manpage>
  
  </Field>
  
  <Field name="fiducial">
    
    <type>F</type>
    
    <usage>Sets the Fiducial Diameter in the Setup Tomogram dialog during automation.</usage>
  
  </Field>
  
  <Field name="frame">
    
    <format>\fBsingle\fR|\fBmontage</format>
    
    <usage>Sets the Frame Type in the Setup Tomogram dialog during automation.</usage>
  
  </Field>
  
  <Field name="gpus">
    
    <format>\fR[ignored]</format>
    
    <usage>Selects the Graphics Card Processing checkbox in the Setup Tomogram dialog.</usage>
  
  </Field>
  
  <Field name="scan">
    
    <type>B</type>
    
    <usage>Runs Scan Header in the Setup Tomogram dialog during automation.</usage>
  
  </Field>
  
  <SectionHeader name="ExtensionOptions">
    
    <usage>EXTENSIONS</usage>
  
  </SectionHeader>
  
  <Field name="plugin">
    
    <type>B</type>
    
    <usage>For loading built-in plugins.  Will be expanded as necessary.  Currently causes the etomo.plugin.demo package to be loaded in preference to external plugins implementing the same interface.</usage>
  
  </Field>
  
  <SectionHeader name="DiagnosticOptions">
    
    <usage>DIAGNOSTIC OPTIONS</usage>
  
  </SectionHeader>
  
  <Field name="actions">
    
    <type>B</type>
    
    <usage>Send actions and file name to Etomo's _err.log.</usage>
    
    <manpage>Send actions and file name to Etomo's \fB_err.log\fR.  File names which do not contain an extension or are entirely numeric will be excluded.</manpage>
  
  </Field>
  
  <Field name="debug">
    
    <type>I</type>
    
    <format>\fR[\fB-1\fR|\fB0\fR|\fB1\fR|\fB2\fR|\fB3\fR|\fB4\fR]</format>
    
    <usage>Send extra information to Etomo's _err.log.</usage>
    
    <manpage>Send extra information to Etomo's \fB_err.log\fR. ^The optional parameter has the following meaning: ^  \fB-1\fR - limited output ^   \fB0\fR - no debug output ^   \fB1\fR - default debug output ^   \fB2\fR - more information ^   \fB3\fR - extensive information - log will be very large ^   \fB4\fR - may degrade performance</manpage>
  
  </Field>
  
  <Field name="grabit">
    
    <format>\fR[\fBc\fR|\fBp\fR]</format>
    
    <usage>Causes the file parameter to be processed by the message processor.</usage>
    
    <manpage>Grabit causes etomo to run as a command line program.  The purpose of grabit is to allow specific elements of etomo functionality to be tried out.  Currently it can only try out message processing so its possible that the parameters will change in the future. When grabit is used the file names at the end of the command line will be assumed to contain program output file(s) to be processed by etomo's message processor.  The result will be printed out.  Etomo will exit after doing this.  The parameter is optional.  Without a parameter it will create a generic message processor default settings. ^Optional Parameter: ^   \fBb\fR - batchruntomo but with logging off - has a special error tag ^   \fBc\fR - copytomocoms - multi-line warning and info messages ^   \fBp\fR - parallel processing with no multi-line messages</manpage>
  
  </Field>
  
  <Field name="ignoresettings">
    
    <type>B</type>
    
    <manpage>ETomo will not load from or save to the \fB.etomo\fR configuration file.</manpage>
  
  </Field>
  
  <Field name="memory">
    
    <type>I</type>
    
    <format>\fR[\fIinterval_in_minutes\fR]</format>
    
    <usage>Log memory usage statements before and after processes are run.</usage>
    
    <manpage>Send memory usage statements to Etomo's \fB_err.log\fR before and after processes are run.  \fInterval_in_minutes\fR is the interval at which to send additional memory usage statements.</manpage>
  
  </Field>
  
  <Field name="selftest">
    
    <type>B</type>
    
    <usage>Causes Etomo to do some internal testing.</usage>
    
    <manpage>Causes Etomo to do some internal testing. ETomo may run more slowly.</manpage>
  
  </Field>
  
  <SectionHeader name="DevelopmentOptions">
    
    <usage>DEVELOPMENT AND TESTING OPTIONS</usage>
  
  </SectionHeader>
  
  <Field name="autoclose3dmod">
    
    <type>B</type>
    
    <usage>ETomo automatically closes the 3dmod instance.</usage>
    
    <manpage>Instead of popping up a message asking to close an open \fB3dmod\fR instance, Etomo automatically closes it.  Used for automated user interface testing.</manpage>
  
  </Field>
  
  <Field name="headless">
    
    <type>B</type>
    
    <usage>No interface will come up.</usage>
    
    <manpage>No interface will come up.  Used for unit testing.</manpage>
  
  </Field>
  
  <Field name="ignoreloc">
    
    <type>B</type>
    
    <usage>The interface will come up in the default location.</usage>
    
    <manpage>The interface will come up in the default location rather then the location saved in \fB.etomo\fR.  Used for automated user interface testing.</manpage>
  
  </Field>
  
  <Field name="names">
    
    <type>B</type>
    
    <usage>The names of screen elements are sent to Etomo's _out.log.</usage>
    
    <manpage>The names of screen elements are sent to Etomo's \fB_out.log\fR.  Used for automated user interface testing.</manpage>
  
  </Field>
  
  <Field name="newstuff">
    
    <type>B</type>
    
    <manpage>May cause Etomo to run with unreleased functionality.</manpage>
  
  </Field>
  
  <Field name="noload">
    
    <type>B</type>
    
    <manpage>Suppresses the computer and queue load updates.</manpage>
  
  </Field>
  
  <Field name="test">
    
    <type>B</type>
    
    <usage>Used for unit testing and automated user interface testing.</usage>
  
  </Field>
  
  <SectionHeader name="DeprecatedOptions">
    
    <usage>DEPRECATED OPTIONS</usage>
  
  </SectionHeader>
  
  <Field name="demo">
    
    <type>B</type>
    
    <usage>Deprecated</usage>
  
  </Field>

</autodoc>
