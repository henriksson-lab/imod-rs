<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="AImageFile">
    
    <short>ia</short>
    
    <type>FN</type>
    
    <usage>Name of image file A</usage>
    
    <tooltip />
    
    <manpage>Name of image file A. If this option is not entered, the first non-option argument will be taken as this name.</manpage>
  
  </Field>
  
  <Field name="BImageFile">
    
    <short>ib</short>
    
    <type>FN</type>
    
    <usage>Name of image file B</usage>
    
    <tooltip />
    
    <manpage>Name of image file B. If this option is not entered, the second non-option argument will be taken as this name.</manpage>
  
  </Field>
  
  <Field name="OutputFile">
    
    <short>output</short>
    
    <type>FN</type>
    
    <usage>Name of output transform file</usage>
    
    <tooltip />
    
    <manpage>Name of output transform file. If this option is not entered, the third non-option argument will be taken as this name.</manpage>
  
  </Field>
  
  <Field name="AStartingEndingViews">
    
    <short>za</short>
    
    <type>IP</type>
    
    <usage>Starting and ending views to search from A</usage>
    
    <tooltip />
    
    <manpage>The starting and ending sections from the first input file to include in the search, numbered from 1.  The default is to use all sections from the first file.</manpage>
  
  </Field>
  
  <Field name="BStartingEndingViews">
    
    <short>zb</short>
    
    <type>IP</type>
    
    <usage>Starting and ending views to search from B</usage>
    
    <tooltip />
    
    <manpage>The starting and ending sections from the second input file to include in the search, numbered from 1.  The default is to use all sections from the second file.  Note that the two tilt series can be placed in the same file, that file name can be given for both input files, and the \fB-za\fR and \fB-zb\fR options can be used to indicate where the two tilt series are in the file.</manpage>
  
  </Field>
  
  <Field name="SwapAandB">
    
    <short>swap</short>
    
    <type>B</type>
    
    <usage>Swap A and B in the processing to get a transformation from B to A</usage>
    
    <tooltip />
    
    <manpage>Swap A and B in the processing to get a transformation from B to A; otherwise the output transform aligns an image in A to one in B.</manpage>
  
  </Field>
  
  <Field name="AngleOfRotation">
    
    <short>a</short>
    
    <type>I</type>
    
    <usage>Rotation direction or angle to search (+1, -1, +90, -90 all work, default is to search both directions)</usage>
    
    <tooltip />
    
    <manpage>Use this option to specify the direction of rotation from the first to the second axis.  Only the sign of this number matters, so you can enter -1 or -90 for clockwise rotations, or 1 or 90 for counterclockwise rotations.  In the absence of this option, the program will consider both directions of rotation.</manpage>
  
  </Field>
  
  <Field name="MirrorXaxis">
    
    <short>mirror</short>
    
    <type>I</type>
    
    <usage>Mirror one image around X axis (1), do not mirror (-1), or try with and without mirroring (0, the default)</usage>
    
    <tooltip />
    
    <manpage>This option controls whether the image from one stack is mirrored around the X axis before rotating by 90 degrees.  Enter 1 to mirror always, -1 to never mirror, or 0 to have the program assess both with and without mirroring.  The default is 0.</manpage>
  
  </Field>
  
  <Field name="DistortionFile">
    
    <short>d</short>
    
    <type>FN</type>
    
    <usage>Name of (zero-stretch) distortion field file to apply</usage>
    
    <tooltip />
    
    <manpage>Name of file with zero-stretch image distortion field from Finddistort(1).</manpage>
  
  </Field>
  
  <Field name="ImagesAreBinned">
    
    <short>b</short>
    
    <type>I</type>
    
    <usage>Binning of images, needed if undistorting images</usage>
    
    <tooltip />
    
    <manpage>The binning at which images were acquired, which usually needs to be specified when undistorting.</manpage>
  
  </Field>
  
  <Field name="RunMidas">
    
    <short>m</short>
    
    <type>B</type>
    
    <usage>Run Midas to set initial translational/rotational alignment</usage>
    
    <tooltip />
    
    <manpage>Run Midas on the first pair of views, and use the alignment that you set in Midas as the initial alignment for all pairs of views that are considered. A correction for stretch will be applied in the initial alignment of the other pairs and may be needed in some cases.</manpage>
  
  </Field>
  
  <Field name="ScanRotationMaxAndStep">
    
    <short>scan</short>
    
    <type>FP</type>
    
    <usage>Maximum angle and step size to scan for best rotation, or one angle and 0</usage>
    
    <tooltip />
    
    <manpage>Either the maximum angle and angular step size at which to apply rotation in order to estimate the best rotation; or a single rotation angle to apply and a 0 step size; or 0,0 for no rotation scan (legacy behavior).  In the latter case, or when the rotation scan finds the best rotation at the end the range, an initial run of Xfsimplex(1) will be done to search for rotation/translation only.  The default is 20 and 4, which will accommodate inaccuracies in 90-degree rotation of up to ~22 degrees, and give fairly accurate interpolated rotation values that allow the first Xfsimplex(1) step to be skipped.</manpage>
  
  </Field>
  
  <Field name="NearestNeighbor">
    
    <short>nearest</short>
    
    <type>B</type>
    
    <usage>Use nearest neighbor instead of linear interpolation in Xfsimplex</usage>
    
    <tooltip />
    
    <manpage>Use nearest neighbor instead of linear interpolation in Xfsimplex(1).  This option will trigger other changes in program behavior that are appropriate when it is not being used for analyzing stretch.</manpage>
  
  </Field>
  
  <Field name="WriteAllTransforms">
    
    <short>x</short>
    
    <type>B</type>
    
    <usage>Write out the transformations between all pairs of sections</usage>
    
    <tooltip />
    
    <manpage>Write out the transformations between all pairs of sections; a separate file will be written for each view in B containing the transformations that align each view in A to that view in B as a reference.</manpage>
  
  </Field>
  
  <Field name="LeaveTempFiles">
    
    <short>t</short>
    
    <type>B</type>
    
    <usage>Leave temporary files in temporary directory</usage>
    
    <tooltip />
    
    <manpage>For diagnosing problems, leave temporary files in the standard temporary directory (/usr/tmp, /tmp, or defined by IMOD_TMPDIR) or in the current directory if there is no temporary directory.</manpage>
  
  </Field>
  
  <Field name="PID">
    
    <type>B</type>
    
    <usage>Print process ID</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
