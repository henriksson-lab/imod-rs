<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="n">
    
    <short />
    
    <type>I</type>
    
    <usage>Expected number of machines or processors (default 4)</usage>
    
    <tooltip />
    
    <manpage>Expected number of machines or processors.  The default is 4. The number of chunks will be 4 times the number of processors, unless specified with &quot;-t&quot;.</manpage>
  
  </Field>
  
  <Field name="t">
    
    <short />
    
    <type>I</type>
    
    <usage>Target number of chunks (default is 4 times number of processors)</usage>
    
    <tooltip />
    
    <manpage>The desired number of chunks to set up.  The actual number will be limited by the number of sections when chunks are in Z.</manpage>
  
  </Field>
  
  <Field name="y">
    
    <short />
    
    <type>B</type>
    
    <usage>Do chunks in Y instead of in Z</usage>
    
    <tooltip />
    
    <manpage>Do chunks in Y instead of in Z.  Chunks in Y are chosen automatically if there is only one section in Z.</manpage>
  
  </Field>
  
  <Field name="e">
    
    <short />
    
    <type>B</type>
    
    <usage>Do edge functions only, without blending images</usage>
    
    <tooltip />
    
    <manpage>Compute edge functions without blending images.  This option is not allowed if the command file specifies to use old edge functions, unless you enter the &quot;-r&quot; option too.</manpage>
  
  </Field>
  
  <Field name="u">
    
    <short />
    
    <type>B</type>
    
    <usage>Use old edge functions and displacements; just blend images</usage>
    
    <tooltip />
    
    <manpage>Just blend images using existing edge functions and displacements, regardless of the values of the corresponding options in the command file.</manpage>
  
  </Field>
  
  <Field name="r">
    
    <short />
    
    <type>B</type>
    
    <usage>Recompute edge functions but use existing displacements</usage>
    
    <tooltip />
    
    <manpage>Recompute edge functions using existing displacements between pieces, regardless of the values of the corresponding options in the command file.</manpage>
  
  </Field>
  
  <Field name="b">
    
    <short />
    
    <type>I</type>
    
    <usage>Number of boundary pixels between chunks (default 2048)</usage>
    
    <tooltip />
    
    <manpage>Set the number of boundary pixels saved in separate files to the given value.  The boundary pixels are rewritten to the output file after all chunks are done.</manpage>
  
  </Field>
  
  <Field name="help">
    
    <short />
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
