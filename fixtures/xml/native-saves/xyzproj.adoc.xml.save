<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputFile">
    
    <short>input</short>
    
    <type>FN</type>
    
    <usage>Input image file</usage>
    
    <tooltip />
    
    <manpage>Input image file to project.  If this option is not entered, the first non-option argument will be used for the input file.</manpage>
  
  </Field>
  
  <Field name="OutputFile">
    
    <short>output</short>
    
    <type>FN</type>
    
    <usage>Output image file</usage>
    
    <tooltip />
    
    <manpage>Output file for projection.  If this option is not entered, the second non-option argument will be used for the output file.</manpage>
  
  </Field>
  
  <Field name="AxisToTiltAround">
    
    <short>axis</short>
    
    <type>CH</type>
    
    <usage>Axis to tilt around (X, Y, or Z)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="XMinAndMax">
    
    <short>xminmax</short>
    
    <type>IP</type>
    
    <usage>Starting and ending X index coordinates of block to project</usage>
    
    <tooltip />
    
    <manpage>Starting and ending X index coordinates of block to project (numbered from 0).  The default is the whole extent in X.</manpage>
  
  </Field>
  
  <Field name="YMinAndMax">
    
    <short>yminmax</short>
    
    <type>IP</type>
    
    <usage>Starting and ending Y index coordinates of block to project</usage>
    
    <tooltip />
    
    <manpage>Starting and ending Y index coordinates of block to project (numbered from 0).  The default is the whole extent in Y.</manpage>
  
  </Field>
  
  <Field name="ZMinAndMax">
    
    <short>zminmax</short>
    
    <type>IP</type>
    
    <usage>Starting and ending Z index coordinates of block to project</usage>
    
    <tooltip />
    
    <manpage>Starting and ending Z index coordinates of block to project (numbered from 0).  The default is the whole extent in Z.</manpage>
  
  </Field>
  
  <Field name="StartEndIncAngle">
    
    <short>angles</short>
    
    <type>FT</type>
    
    <usage>Starting, ending, and increment tilt angle</usage>
    
    <tooltip />
    
    <manpage>Starting, ending, and increment tilt angle.  Enter the same value for starting and ending angle to get only one image.  When input images are not from a tilt series, projection angles must be entered with either this option, \fB-tiltfile\fR, or \fB-tangles\fR.</manpage>
  
  </Field>
  
  <Field name="TiltFile">
    
    <short>tiltfile</short>
    
    <type>FN</type>
    
    <usage>File with tilt angles to use, or for input images from a tilt series</usage>
    
    <tooltip />
    
    <manpage>File with tilt angles to project at, or for input images from a tilt series.  Use this option if tilt angles in degrees are in a file, one per line.</manpage>
  
  </Field>
  
  <Field name="AdjustFileAngles">
    
    <short>adjust</short>
    
    <type>FN</type>
    
    <usage>Value to add to angles read in from file</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="TiltAngles">
    
    <short>tangles</short>
    
    <type>FAM</type>
    
    <usage>Individual tilt angles to use, or for each view for tilt series images</usage>
    
    <tooltip />
    
    <manpage>Use this option to enter the individual tilt angles in degrees, either to project at or for input images from a tilt series.</manpage>
  
  </Field>
  
  <Field name="ModeToOutput">
    
    <short>mode</short>
    
    <type>I</type>
    
    <usage>Mode of output file (0 for byte, 1/6 for integer, 2/12 for float)</usage>
    
    <tooltip />
    
    <manpage>Mode of output file (0 for byte, 1 of 6 for signed or unsigned integer, 2 or 12 for 32-bit or 16-bit floats).  The default is mode 1 for input mode 0 or 1; the default mode of floating point output with float input for MRC files is governed by the value of environment variable IMOD_WRITE_FLOATS_16BIT. Mode 12 is allowed only if the output format is MRC.</manpage>
  
  </Field>
  
  <Field name="WidthToOutput">
    
    <short>width</short>
    
    <type>I</type>
    
    <usage>Width of output file (default is same as width of input coordinates)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="AddThenMultiply">
    
    <short>addmult</short>
    
    <type>FP</type>
    
    <usage>Factors to add then multiply by (default 0,1)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="FillValue">
    
    <short>fill</short>
    
    <type>F</type>
    
    <usage>Value to fill empty areas with (default is mean)</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="ConstantScaling">
    
    <short>constant</short>
    
    <type>B</type>
    
    <usage>Scale all projection sums by the same amount</usage>
    
    <tooltip />
    
    <manpage>Scale all projection sums by the same amount, by dividing by the thickness of the slab being projected.  The default is to divide each projection sum by the number of pixels along the projection ray. Constant scaling is more appropriate when projecting a largely empty volume.</manpage>
  
  </Field>
  
  <Field name="UseRayIntersections">
    
    <short>ray</short>
    
    <type>B</type>
    
    <usage>Compute projections from areas of intersection between rays and pixels</usage>
    
    <tooltip />
    
    <manpage>Compute projections from areas of intersection between rays and pixels, instead of by interpolating between sets of 4 pixels along each ray. Each pixel is intersected by one to 3 rays.  The fraction of area in each intersection is computed and that fraction of the pixel's value is added to the respective ray.  This may give a more accurate result than interpolating, particularly when projecting model data.</manpage>
  
  </Field>
  
  <Field name="InputIsTiltSeries">
    
    <short>series</short>
    
    <type>B</type>
    
    <usage>The input file is a tilt series</usage>
    
    <tooltip />
    
    <manpage>The input file is a tilt series and will be treated as described above.  The angles of the tilt series must be entered with either \fB-tiltfile\fR, \fB-first\fR and \fB-increment\fR, or \fB-tangles\fR.</manpage>
  
  </Field>
  
  <Field name="FirstTiltAngle">
    
    <short>first</short>
    
    <type>F</type>
    
    <usage>Tilt angle of first view in degrees for tilt series images</usage>
    
    <tooltip />
    
    <manpage>Tilt angle of first view, in degrees, for images from a tilt series. Use this option together with \fB-increment\fR.  Both of these options may only be entered with \fB-series\fR.</manpage>
  
  </Field>
  
  <Field name="TiltIncrement">
    
    <short>increment</short>
    
    <type>F</type>
    
    <usage>Increment between tilt angles of input images</usage>
    
    <tooltip />
    
    <manpage>Increment between tilt angles, in degrees, for input images from a tilt series.  Use this option together with \fB-first\fR.</manpage>
  
  </Field>
  
  <Field name="FullAreaAtTilt">
    
    <short>full</short>
    
    <type>B</type>
    
    <usage>Do not tilt-foreshorten when projecting a tilt series</usage>
    
    <tooltip />
    
    <manpage>Use this option to keep the projection box the same size on all images of a tilt series, rather than making it smaller at higher tilt.  The box will thus include new material at each higher tilt.</manpage>
  
  </Field>
  
  <Field name="ParameterFile">
    
    <short>param</short>
    
    <type>PF</type>
    
    <usage>Read parameter entries from file</usage>
    
    <tooltip />
    
    <manpage>Read parameter entries as keyword-value pairs from a parameter file.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
