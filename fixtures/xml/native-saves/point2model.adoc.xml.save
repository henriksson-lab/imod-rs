<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputFile">
    
    <short>input</short>
    
    <type>FN</type>
    
    <usage>Input text fie with points</usage>
    
    <tooltip />
    
    <manpage>Input text file with points.  If this option is not entered, the first non-option argument will be used for the input file.</manpage>
  
  </Field>
  
  <Field name="OutputFile">
    
    <short>output</short>
    
    <type>FN</type>
    
    <usage>Output file for model</usage>
    
    <tooltip />
    
    <manpage>Output file for model.  If this option is not entered, the second non-option argument will be used for the output file.</manpage>
  
  </Field>
  
  <Field name="OpenContours">
    
    <short>open</short>
    
    <type>B</type>
    
    <usage>Make objects be open contour type (default is closed contour)</usage>
    
    <tooltip />
    
    <manpage>The default is to make all objects be closed contour type.  This option and -scat can be used to make all objects be open or scattered, respectively.</manpage>
  
  </Field>
  
  <Field name="ScatteredPoints">
    
    <short>scat</short>
    
    <type>B</type>
    
    <usage>Make objects be scattered point type</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="PointsPerContour">
    
    <short>number</short>
    
    <type>I</type>
    
    <usage>Maximum number of points per contour</usage>
    
    <tooltip />
    
    <manpage>Maximum number of points per contour.  The default is to put all points into one contour.  This option is not allowed if the point file has contour numbers.</manpage>
  
  </Field>
  
  <Field name="PlanarContours">
    
    <short>planar</short>
    
    <type>B</type>
    
    <usage>Start a new contour at each new Z value encountered</usage>
    
    <tooltip />
    
    <manpage>Start a new contour at each new Z value encountered when reading sequentially through the lines of input.  This option is not allowed if the point file has contour numbers.</manpage>
  
  </Field>
  
  <Field name="NumberedFromZero">
    
    <short>zero</short>
    
    <type>B</type>
    
    <usage>Objects and contours are numbered from 0 instead of 1</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="SkipLinesAtStart">
    
    <short>skip</short>
    
    <type>I</type>
    
    <usage>Number of lines to skip at the start of the file</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="ObjectNumbersOnly">
    
    <short>object</short>
    
    <type>B</type>
    
    <usage>The lines contain object numbers but no contour numbers</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="ZCoordinatesFromZero">
    
    <short>zcoord</short>
    
    <type>B</type>
    
    <usage>Z coordinates of points start at 0 instead of -0.5</usage>
    
    <tooltip />
    
    <manpage>Z coordinates of points are 0 instead of -0.5 at the bottom of the volume.  In IMOD models, integer Z values are defined as being located in the middle of a pixel in Z, which makes model coordinates range from -0.5 to NZ - 0.5 for a volume of NZ slices.  Use this option if the point coordinates range from 0 to NZ instead, i.e., if the fractional part of a Z coordinate corresponds to its fractional position within a pixel in Z.</manpage>
  
  </Field>
  
  <Field name="PointSizes">
    
    <short>sizes</short>
    
    <type>B</type>
    
    <usage>Each line has an individual point size after the Z coordinate</usage>
    
    <tooltip />
    
    <manpage>Each line has an individual point size (radius) after the Z coordinate. Values and sizes can both be present.</manpage>
  
  </Field>
  
  <Field name="SetAsDefaultSize">
    
    <short>default</short>
    
    <type>B</type>
    
    <usage>Set a point size to default if its size matches the sphere radius</usage>
    
    <tooltip />
    
    <manpage>If individual point sizes are present and the size for a point matches the default size for the object entered with the \FB-sphere\fR option, store a size of -1 so that it will continue to have the default size if that is later changed.  Otherwise, the value itself will be stored for the point.</manpage>
  
  </Field>
  
  <Field name="ValuesInLastColumn">
    
    <short>values</short>
    
    <type>I</type>
    
    <usage>1 or -1 to store last number on each line as a point or contour value</usage>
    
    <tooltip />
    
    <manpage>Use this option to indicate that lines have a general value at the end, after the Z coordinate.   Enter 1 to have the value stored as a point value, or -1 to have the value stored as a contour value.  With point values, a value must appear on every line.  With contour values, the first point in each contour must have a value, and values on later points in a contour will be ignored and need not be present.  Note that if a file has values and this option is not given, the coordinates will NOT be read correctly unless the file has both object and contour numbers, because the program will think that the X coordinate is a contour number.</manpage>
  
  </Field>
  
  <Field name="TimesForContours">
    
    <short>times</short>
    
    <type>B</type>
    
    <usage>Each contour has a time index on the first point</usage>
    
    <tooltip />
    
    <manpage>Use this option to indicate that contours have time indexes.  These indexes should appear after point sizes, if any, just for the first point in a contour.  If there are point or contour values, the time should be before the value.</manpage>
  
  </Field>
  
  <Field name="LabelsStartInColumn">
    
    <short>labels</short>
    
    <type>I</type>
    
    <usage>Starting column number for text to be made into point labels</usage>
    
    <tooltip />
    
    <manpage>Starting column number for text to be made into point labels, numbered from 1.  The label will consist of all remaining text on the line starting in that column.  Not every line needs to have a label.  However, all lines with labels must have the same number of numeric values preceding it. If either contour values or contour times are included, enter the column number after the contour value or time for the first point in the contour. For other points, pad the line with one or two zeros before the label to make it start in the indicated column.</manpage>
  
  </Field>
  
  <Field name="LabelFontSize">
    
    <short>font</short>
    
    <type>I</type>
    
    <usage>Size of font for drawing labels</usage>
    
    <tooltip />
    
    <manpage>Size of font for drawing labels, the same value that is shown in the 3dmod Edit-Object-Type dialog.</manpage>
  
  </Field>
  
  <Field name="DisplayFlags">
    
    <short>flags</short>
    
    <type>I</type>
    
    <usage>Sum of 1 to display values and 2 to display in false color</usage>
    
    <tooltip />
    
    <manpage>This entry is a sum of flags controlling display options, currently including just 1 to turn on the option to &quot;Show stored values&quot; in the Model View Edit Objects Values panel, and 2 to turn on the option for false color.</manpage>
  
  </Field>
  
  <Field name="CircleSize">
    
    <short>circle</short>
    
    <type>I</type>
    
    <usage>Turn on display of circles of this size (radius) at each point</usage>
    
    <tooltip />
    
    <manpage>Turn on display of circles of this size (radius) at each point.  If the points form open contours that progress through Z, this option will let you see them in the Zap window of 3dmod without having to edit the object.</manpage>
  
  </Field>
  
  <Field name="SymbolType">
    
    <short>symbol</short>
    
    <type>I</type>
    
    <usage>Type of symbol: 0-2 for circle, triangle, square, add 3 to fill</usage>
    
    <tooltip />
    
    <manpage>Type of symbol to display instead of open circles: 1 or 2 for open squares or triangles, 3, 4, or 5 for filled circles, squares, or triangles</manpage>
  
  </Field>
  
  <Field name="SphereRadius">
    
    <short>sphere</short>
    
    <type>I</type>
    
    <usage>Turn on display of spheres of this radius at each point</usage>
    
    <tooltip />
    
    <manpage>Turn on display of spheres of this radius at each point.  Use this option to see scattered points in 3dmod without having to edit the object.</manpage>
  
  </Field>
  
  <Field name="LineWidthIn2D">
    
    <short>width</short>
    
    <type>I</type>
    
    <usage>Line width for object in 2D displays</usage>
    
    <tooltip />
    
    <manpage>Line width for the object in 2D displays like the Zap window.  This sets the same line width as in the 3dmod Edit Object Type dialog.</manpage>
  
  </Field>
  
  <Field name="LineThicknessIn3D">
    
    <short>thick</short>
    
    <type>I</type>
    
    <usage>Line width for object in Model View 3D display</usage>
    
    <tooltip />
    
    <manpage>Line width for the object in the Model View display.  This sets the same value as the 3D line width in the Line panel of the 3dmod Model View Edit Objects dialog.</manpage>
  
  </Field>
  
  <Field name="ColorOfObject">
    
    <short>color</short>
    
    <type>ITM</type>
    
    <usage>Color to make object (red, green, blue ranging from 0 to 255)</usage>
    
    <tooltip />
    
    <manpage>Color to make an object; enter red, green, and blue values ranging from 0 to 255.  To assign colors to multiple objects, enter this option multiple times.</manpage>
  
  </Field>
  
  <Field name="NameOfObject">
    
    <short>name</short>
    
    <type>CHM</type>
    
    <usage>Name to give object</usage>
    
    <tooltip />
    
    <manpage>Name to give an object; enter a text string, enclosed in quotes if it contains spaces.  To assign names to multiple objects, enter this option multiple times.</manpage>
  
  </Field>
  
  <Field name="ImageForCoordinates">
    
    <short>image</short>
    
    <type>FN</type>
    
    <usage>Make the model's coordinate system match this image file</usage>
    
    <tooltip />
    
    <manpage>Make the model's coordinate system match this image file.  This is not needed for loading the model onto this image in 3dmod, but will allow the model to be used together with this image file in various programs (e.g., Beadtrack) without having to load it into 3dmod and save it.  As of IMOD 4.10.30, this entry also sets the pixel size in the model header.</manpage>
  
  </Field>
  
  <Field name="VolumeSizeXYZ">
    
    <short>volume</short>
    
    <type>IT</type>
    
    <usage>Size of volume in X, Y, and Z to store in model header</usage>
    
    <tooltip />
    
    <manpage>Size of a volume in X, Y, and Z to store in the &quot;max&quot; fields of the model header.  Correct max values are needed for some operations such as rotation in Imodtrans(1).  By default, the program stores max values that are a few pixels past the actual data, or the size of an image file if one is entered with \fB-image\fR.  This entry overrides a size from such an image file.</manpage>
  
  </Field>
  
  <Field name="PixelSpacingOfImage">
    
    <short>pixel</short>
    
    <type>FT</type>
    
    <usage>Pixel spacing, or scale in X, Y, and Z, of the model's coordinate system</usage>
    
    <tooltip />
    
    <manpage>Set the reference scaling information of the model to the given X, Y, and Z scale factors, which would correspond to the pixel spacing in an image file header.  The entry together with \fB-origin\fR provides an alternative to the \fB-image option\fR, so \fB-image\fR cannot be used together with \fB-pixel\fR or \fB-origin\fR.  Like \fB-image\fR, these entries are not needed for loading the model into 3dmod together with an image file of the same scaling, but would be useful for loading into 3dmod with an image at a different binning, or for use in other programs that require the scaling to be correct.  As of IMOD 4.10.30, this entry also sets the pixel size in the model header.</manpage>
  
  </Field>
  
  <Field name="OriginOfImage">
    
    <short>origin</short>
    
    <type>FT</type>
    
    <usage>Origin in X, Y, and Z of the model's coordinate system</usage>
    
    <tooltip />
    
    <manpage>Set the reference information of the model to the given X, Y, and Z translations, which would correspond to the origin in an image file header.</manpage>
  
  </Field>
  
  <Field name="ModelPixelSize">
    
    <short>modpix</short>
    
    <type>F</type>
    
    <usage>Pixel size to assign to model header, in nanometers</usage>
    
    <tooltip />
    
    <manpage>Pixel size to assign to model header, in nanometers.  This option can be entered along with \fB-image\fB or \fB-pixel\fR and overrides the pixel size in the image file header or entered with \fB-pixel\fR, respectively.</manpage>
  
  </Field>
  
  <Field name="ZScaleOfModel">
    
    <short>zscale</short>
    
    <type>F</type>
    
    <usage>Z scale to assign to the model</usage>
    
    <tooltip />
    
    <manpage>Z scale to assign to the model, corresponding to the value set in the 3dmod Model Header and Model View Edir Controls dialogs.  This Z-scale is separate from the pixel spacing in Z and is used for display, quantitative measurements, and determination of the normals to the surface.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
