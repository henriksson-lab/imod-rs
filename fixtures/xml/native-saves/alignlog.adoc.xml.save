<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="m">
    
    <type>B</type>
    
    <usage>Mappings: print variable mappings</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="e">
    
    <type>B</type>
    
    <usage>Errors: print errors and ratio of measured to unknowns</usage>
    
    <tooltip />
    
    <manpage>Errors: print errors and ratio of measured to unknowns.  If cross-validation is being done, both the residual errors and the errors in predicting the positions of points left out will be printed.</manpage>
  
  </Field>
  
  <Field name="s">
    
    <type>B</type>
    
    <usage>Solution: print the alignment solution for each view</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="l">
    
    <type>B</type>
    
    <usage>Print results from local alignments</usage>
    
    <tooltip />
    
    <manpage>Local: print the location and size of each local area, the number of fiducials on each surface, and the mean residual.</manpage>
  
  </Field>
  
  <Field name="c">
    
    <type>B</type>
    
    <usage>Coordinates: print the 3-D coordinates of the fiducials</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="r">
    
    <type>B</type>
    
    <usage>Residuals: print large residuals</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="a">
    
    <type>B</type>
    
    <usage>Angles: print planar fits and recommended change in angles</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="b">
    
    <type>B</type>
    
    <usage>Beam tilt: print F values (RMS errors) from beam tilt search</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="w">
    
    <type>B</type>
    
    <usage>Robust weighting: print output from robust fitting and weighted mean residuals</usage>
    
    <tooltip />
    
    <manpage>Robust weighting: print output from robust fitting and weighted mean residuals.  If cross-validation is being done, both the residual errors and the leave-out errors will be printed.  It reports leave-out errors without and with robust fitting and the benefit from robust fitting (the difference of the two).  It reports both unweighted and weighted errors and benefits; the weighted benefit value should be the most valid reflection of whether robust fitting helped.</manpage>
  
  </Field>
  
  <Field name="p">
    
    <type>B</type>
    
    <usage>Project log: print output selected for the project log</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
