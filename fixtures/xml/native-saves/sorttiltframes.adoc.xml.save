<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputFile">
    
    <short>input</short>
    
    <type>FNM</type>
    
    <usage>Input file to analyze for tilt angle in the filename</usage>
    
    <tooltip />
    
    <manpage>Input file to analyze for tilt angle in the filename.  Non-option arguments will also be used for input files, with those entries used after any names entered with this option.</manpage>
  
  </Field>
  
  <Field name="ListOfInputFiles">
    
    <short>listin</short>
    
    <type>FN</type>
    
    <usage>File with list of filenames to sort, instead of names on command line</usage>
    
    <tooltip />
    
    <manpage>File with list of filenames to sort.  You can not enter some names with this option and other names with \fB-input\fR or as command-line arguments; names must be entered one way or the other.</manpage>
  
  </Field>
  
  <Field name="TiltSeriesFile">
    
    <short>stack</short>
    
    <type>FN</type>
    
    <usage>Tilt series stack file with tilt angles to match in extended header</usage>
    
    <tooltip />
    
    <manpage>Tilt series stack file with tilt angles that can be extracted from the extended header.  Filenames matching those angles will be put out in the same order as those angles.</manpage>
  
  </Field>
  
  <Field name="TiltAngleFile">
    
    <short>angle</short>
    
    <type>FN</type>
    
    <usage>Text file with tilt angles to match, one per line</usage>
    
    <tooltip />
    
    <manpage>Text file with tilt angles, one per line.  Filenames matching those angles will be put out in the same order as those angles.</manpage>
  
  </Field>
  
  <Field name="OutputFileList">
    
    <short>outlist</short>
    
    <type>FN</type>
    
    <usage>Output file for list of sorted filenames</usage>
    
    <tooltip />
    
    <manpage>Output file for list of sorted or unsorted filenames.  This file can be used with the \fB-list\fR option to Alignframes(1).</manpage>
  
  </Field>
  
  <Field name="OutputTiltAngleFile">
    
    <short>tilt</short>
    
    <type>FN</type>
    
    <usage>Output file for tilt angles, unsorted unless -o entered also</usage>
    
    <tooltip />
    
    <manpage>Output file for list of sorted or unsorted tilt angles extracted from the filenames.  This file can be used with the \fB-tilt\fR option to Alignframes(1).  This option can be used only if there are no tilt series angles to match.</manpage>
  
  </Field>
  
  <Field name="ReverseOrder">
    
    <short>reverse</short>
    
    <type>B</type>
    
    <usage>Reverse order from positive to negative (if no angles to match)</usage>
    
    <tooltip />
    
    <manpage>Reverse order from positive to negative.  This option can be used only if there are no tilt series angles to match.</manpage>
  
  </Field>
  
  <Field name="UnsortedOutput">
    
    <short>unsorted</short>
    
    <type>B</type>
    
    <usage>Output unsorted lists (if no angles to match)</usage>
    
    <tooltip />
    
    <manpage>Produce unsorted output lists.  This option cannot be used with \fB-reverse\fB, \fB-series\fB, or \fB-angle\fB.</manpage>
  
  </Field>
  
  <Field name="Delimiters">
    
    <short>delim</short>
    
    <type>CH</type>
    
    <usage>Starting and ending delimiters of tilt angle (2 characters, default &quot;[]&quot;)'</usage>
    
    <tooltip />
    
    <manpage>Starting and ending delimiters of tilt angle in the filenames.  Two characters must be entered, even if they are the same.  The default is &quot;[]&quot; for tilt angles enclosed in brackets.  Files from SerialEM would require either &quot;__&quot; or &quot;_.&quot;</manpage>
  
  </Field>
  
  <Field name="FixedImageDose">
    
    <short>fixed</short>
    
    <type>F</type>
    
    <usage>Fixed dose for each image in electrons per square Angstrom</usage>
    
    <tooltip />
    
    <manpage>Fixed dose for each image in electrons per square Angstrom.  The \fB-dose\fR option must also be entered.</manpage>
  
  </Field>
  
  <Field name="DoseOutputFile">
    
    <short>dose</short>
    
    <type>FN</type>
    
    <usage>Output dose information file of type 2 (accumulated dose and image dose)</usage>
    
    <tooltip />
    
    <manpage>Output file for dose information in the type 2 accepted by Alignframes(1) and Mtffilter(1), namely the prior accumulated dose and image dose for each tilt series image.  The \fB-fixed\fR option must also be entered.  These options are appropriate only if input files are in the order of acquisition, but they work with both unsorted and sorted output.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <long>usage</long>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage>Print help output.</manpage>
  
  </Field>

</autodoc>
