<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="RootNameForProcesses">
    
    <short>rootname</short>
    
    <type>CH</type>
    
    <usage>Root name common to the processes (required)</usage>
    
    <tooltip />
    
    <manpage>Root name common to the processes; i.e., all processes should pass this same name.  This entry is required.</manpage>
  
  </Field>
  
  <Field name="ProcessID">
    
    <short>pid</short>
    
    <type>I</type>
    
    <usage>PID of the calling process (required)</usage>
    
    <tooltip />
    
    <manpage>Process ID of the calling process.  This entry is required.</manpage>
  
  </Field>
  
  <Field name="ControllingMachine">
    
    <short>controller</short>
    
    <type>CH</type>
    
    <usage>Name of machine with process requesting use (required)</usage>
    
    <tooltip />
    
    <manpage>Name of machine with process requesting use.  This should be the first component of the full hostname (i.e., with with domain name omitted). This entry is required.</manpage>
  
  </Field>
  
  <Field name="FullListOfGPUs">
    
    <short>fulllist</short>
    
    <type>CH</type>
    
    <usage>Full list of machines and GPUs available (e.g., host:1:2,host2,host3:2)</usage>
    
    <tooltip />
    
    <manpage>Full list of machines and GPUs available, in the same format as is given to the \fB-G\fR option to Processchunk(1), for example, host:1:2,host2,host3:2.  If this option is entered, \fB-maxgpu\fR must be entered also.</manpage>
  
  </Field>
  
  <Field name="MaximumGPUsToAssign">
    
    <short>maxgpu</short>
    
    <type>I</type>
    
    <usage>Maximum number of GPUs to allocate for this request</usage>
    
    <tooltip />
    
    <manpage>Maximum number of GPUs to allocate for this request.  If this option is entered, \fB-fullist\fR must be entered also.</manpage>
  
  </Field>
  
  <Field name="CommonDirectory">
    
    <short>common</short>
    
    <type>CH</type>
    
    <usage>Directory common to the processes in which to keep the usage list</usage>
    
    <tooltip />
    
    <manpage>Directory in which the usage list will be kept.  All calling processes should provide the same entry if any do.  The default is the current directory.</manpage>
  
  </Field>
  
  <Field name="VerboseOutput">
    
    <short>verbose</short>
    
    <type>B</type>
    
    <usage>Give diagnostic output</usage>
    
    <tooltip />
    
    <manpage>Give diagnostic output about allocations and removals.  This option cannot be used unless the calling program can distinguish this output from allocated</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
