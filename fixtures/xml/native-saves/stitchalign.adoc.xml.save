<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InfoFile">
    
    <short>info</short>
    
    <type>FN</type>
    
    <usage>Name of supermontage information file</usage>
    
    <tooltip />
    
    <manpage>Name of autodoc-type file with information about the supermontage. If this option is not entered, the first non-option argument will be taken as the name of the info file.</manpage>
  
  </Field>
  
  <Field name="ZvaluesToDo">
    
    <short>zvalues</short>
    
    <type>LI</type>
    
    <usage>List of Z values to analyze</usage>
    
    <tooltip />
    
    <manpage>List of Z values at which to run the analysis (comma-separated ranges allowed).  The default is to do all Z values.</manpage>
  
  </Field>
  
  <Field name="RotationInXYplane">
    
    <short>rotation</short>
    
    <type>F</type>
    
    <usage>Angle to rotate in X/Y plane</usage>
    
    <tooltip />
    
    <manpage>Angle to rotate all volumes in the X/Y plane.  If this option is not entered, the program will find the angle that brings the centers of the aligned volumes onto a rectangular grid.  Enter an angle or zero to override this behavior.</manpage>
  
  </Field>
  
  <Field name="SizeOfOutputFramesXandY">
    
    <short>size</short>
    
    <type>IP</type>
    
    <usage>Size in X and Y of transformed files to be created by Warpvol</usage>
    
    <tooltip />
    
    <manpage>Size in X and Y of transformed files to be created by Matchvol or Warpvol.  The default is the size of the largest input volume.</manpage>
  
  </Field>
  
  <Field name="FindMagnification">
    
    <short>mag</short>
    
    <type>B</type>
    
    <usage>Find overall magnification factors</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="FindStretch">
    
    <short>stretch</short>
    
    <type>B</type>
    
    <usage>Find in-plane stretch parameters</usage>
    
    <tooltip />
    
    <manpage>Find in-plane stretch parameters, which are expressed as size change and rotation of the Y axis relative to the X axis.</manpage>
  
  </Field>
  
  <Field name="FindThinning">
    
    <short>thinning</short>
    
    <type>B</type>
    
    <usage>Find thinning factors</usage>
    
    <tooltip />
    
    <manpage>Find thinning factors, factors by which to change the thickness of the volumes.</manpage>
  
  </Field>
  
  <Field name="FindAngles">
    
    <short>angles</short>
    
    <type>IT</type>
    
    <usage>Values indicating whether to find rotations around X, Y, and Z</usage>
    
    <tooltip />
    
    <manpage>Values or 1 or 0 indicating whether to find rotations around X, Y, and Z, respectively.  The default is 1,1,1, so this option would be used to turn off solutions for some angles.</manpage>
  
  </Field>
  
  <Field name="MetroFactor">
    
    <short>metro</short>
    
    <type>F</type>
    
    <usage>Initial step size in minimization; default 0.24</usage>
    
    <tooltip />
    
    <manpage>Initial step size or &quot;metro factor&quot; in the minimization procedure; the default is 0.24.  Vary this value slightly if a minimization fails.</manpage>
  
  </Field>
  
  <Field name="XRunStartEnd">
    
    <short>xrun</short>
    
    <type>IP</type>
    
    <usage>Starting and ending volumes in X to analyze</usage>
    
    <tooltip />
    
    <manpage>Starting and ending volumes in X to analyze, numbered from 1.  The default is to do all volumes in X.</manpage>
  
  </Field>
  
  <Field name="YRunStartEnd">
    
    <short>yrun</short>
    
    <type>IP</type>
    
    <usage>Starting and ending volumes in Y to analyze</usage>
    
    <tooltip />
    
    <manpage>Starting and ending volumes in Y to analyze, numbered from 1.  The default is to do all volumes in Y.</manpage>
  
  </Field>
  
  <Field name="WarpFitResidualCriterion">
    
    <short>residual</short>
    
    <type>F</type>
    
    <usage>Criterion residual in findwarp fits for excluding vectors (default 100)</usage>
    
    <tooltip />
    
    <manpage>Criterion residual from fits in Findwarp(1) for excluding vectors; vectors with mean residual greater than or equal this to value will be excluded.  The default value of 100 will generally not exclude any vectors. Use Fitpatches(1) to produce an appropriate patch file with residuals.</manpage>
  
  </Field>
  
  <Field name="OutlierFractionCriterion">
    
    <short>outlier</short>
    
    <type>F</type>
    
    <usage>Criterion outlier fraction for excluding a vector (default 0.33)</usage>
    
    <tooltip />
    
    <manpage>Criterion fraction of times that a vector was excluded as an outlier from fits in Findwarp(1); vectors with an outlier fraction greater than or equal this to value will be excluded here.  The default is 0.33.  Use Fitpatches(1) to produce an appropriate patch file with outlier fractions.</manpage>
  
  </Field>
  
  <Field name="VectorSpacingFactor">
    
    <short>spacing</short>
    
    <type>F</type>
    
    <usage>Factor by which to change spacing of vectors for warping fields</usage>
    
    <tooltip />
    
    <manpage>This factor makes the spacing of the vectors put out in the warping fields for each volume be less than the spacing of the patch vectors measured in the overlap zones.  The default is 0.7, which makes the density of warping vectors be about three times higher than the density of the patch vectors.</manpage>
  
  </Field>
  
  <Field name="AllTogether">
    
    <short>all</short>
    
    <type>B</type>
    
    <usage>Analyze all volumes in a single minimization procedure</usage>
    
    <tooltip />
    
    <manpage>Analyze all volumes in a single minimization procedure.  The default is to get a solution for each pair of overlapping volumes and resolve the results into a single solution.  When parameters are searched for all volumes together, the results are poor, probably due to multiple minima.</manpage>
  
  </Field>
  
  <Field name="ParameterFile">
    
    <short>param</short>
    
    <long>ParameterFile</long>
    
    <type>PF</type>
    
    <usage>Read parameter entries from file</usage>
    
    <tooltip />
    
    <manpage>Read parameter entries as keyword-value pairs from a parameter file.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <long>usage</long>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
