<?xml version="1.0" encoding="utf-8"?>

<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="RootName">
    
    <short>root</short>
    
    <type>CH</type>
    
    <usage>Root name of files to use</usage>
    
    <tooltip />
    
    <manpage>Root name of files to use (include the a or b if dual axis)</manpage>
  
  </Field>
  
  <Field name="TrackCommandFile">
    
    <short>track</short>
    
    <type>FN</type>
    
    <usage>Command file for running Beadtrack</usage>
    
    <tooltip />
    
    <manpage>Command file for running Beadtrack(1).  This entry may be needed if the default track command file cannot be found, since several parameter values are obtained from there.</manpage>
  
  </Field>
  
  <Field name="MinSpacing">
    
    <short>spacing</short>
    
    <type>F</type>
    
    <usage>Minimum spacing between peaks as fraction of bead size (default 0.85)</usage>
    
    <tooltip />
    
    <manpage>Minimum spacing between peaks found in Imodfindbeads(1), as a fraction of the bead size.  When two peaks are closer than this distance apart, the weaker one is eliminated. The default is 0.85, since values of 0.8 to 0.9 are helpful for getting a more complete set of beads.</manpage>
  
  </Field>
  
  <Field name="BeadSize">
    
    <short>size</short>
    
    <type>F</type>
    
    <usage>Diameter of beads in images to track, in pixels</usage>
    
    <tooltip />
    
    <manpage>Diameter of beads in the images to track, in pixels.  This entry is not needed if there is a bead size entry in the Beadtrack(1) command file and a raw stack so that the binning of the aligned stack can be detected. If it is entered, it must be in units of the potentially binned pixels of the stack being tracked.</manpage>
  
  </Field>
  
  <Field name="AdjustSizes">
    
    <short>adjust</short>
    
    <type>I</type>
    
    <usage>1 to change parameters using measured size of averaged bead, 0 not to</usage>
    
    <tooltip>Change size-based parameters for finding beads using measured size of averaged bead.  Use only for cryo or other data sets taken with significant underfocus.</tooltip>
    
    <manpage>1 to change all size-based parameters in Imodfindbeads(1) using the measured size of the averaged bead, or 0 not to.  When this option is not entered, the value is taken from &quot;autofidseed.com&quot; if that is found. This option should be used only for cryo-samples or other samples taken with significant underfocus.</manpage>
  
  </Field>
  
  <Field name="PeakStorageFraction">
    
    <short>peak</short>
    
    <type>F</type>
    
    <usage>Fraction of peaks above histogram dip to store in model (default 1.0)</usage>
    
    <tooltip>Fraction of correlation peaks above histogram dip to store in model; a value &lt; 1 will omit some peaks above the dip and a vlue &gt; 1 will store extra peaks below the dip</tooltip>
    
    <manpage>Fraction of the correlation peaks above the histogram dip that Imodfindbeads(1) should store in the model.  The default is 1.0 to store all peaks above the dip.  A value below 1 will omit the weakest peaks from the seed models for tracking and could be used if some non-gold particles are being selected. A value above 1 will include peaks below the dip and could be used if some gold particles are being missed. For example, 1.1 would include the strongest peaks below the dip, 10% as many as are above the dip. The negative of this entry is used for the \fB-store\fR entry to Imodfindbeads(1).</manpage>
  
  </Field>
  
  <Field name="ReplaceAboveAngle">
    
    <short>replace</short>
    
    <type>F</type>
    
    <usage>Replace points in existing model with points found here above given angle</usage>
    
    <enum.sel.tooltip>Replace points in existing model with points found here above the given angle; use with points from Findbeads3d, not with points from fiducial model</enum.sel.tooltip>
    
    <enum.val.tooltip>Angle above which to replace points; enter 0 to replace all</enum.val.tooltip>
    
    <manpage>Replace points in the existing model with the duplicate points found in this program when the tilt angle is higher than the entered value.  With a value of zero, all points will be replaced. Especially at high tilt, points found here may be better centered than ones projected from a 3D model generated by Findbeads3d(1). Replacement should not be done if the existing model is derived from a fiducial model.</manpage>
  
  </Field>
  
  <Field name="FillInMissingPoints">
    
    <short>fill</short>
    
    <type>I</type>
    
    <usage>Fill in missing points, extending tracks by given amount</usage>
    
    <enum.sel.tooltip>Fill in gaps between points that are detected (after determining how points connect between views), and extrapolate positions to high tilt by up to the given number of views</enum.sel.tooltip>
    
    <enum.views.tooltip>Number of views to fill in or extrapolate past a detected bead</enum.views.tooltip>
    
    <manpage>Detect how the added points are connected between different views, fill in gaps between connected points up to the entered size, and add up to the entered number of points past the end of a set of connected points. The default is 6; an entry of 0 will disable filling.</manpage>
  
  </Field>
  
  <Field name="FindBeadOptions">
    
    <short>find</short>
    
    <type>CH</type>
    
    <usage>One or more options to pass to ImodFindBeads</usage>
    
    <tooltip />
    
    <manpage>Additional options to pass to ImodFindBeads.  The entry should be a single string (quoted when running from the command line) that contains the text that would be entered directly to ImodFindBeads, for example, &quot;-peakmin .15 -store 30&quot;.  Each option, recognized by the dash, is placed on a separate line of input to ImodFindBeads, at the end of the usual input.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

</autodoc>
