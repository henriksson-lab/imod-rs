<autodoc>
  
  <PreData>
    
    <Version>1.0</Version>
    
    <Pip>1</Pip>
  
  </PreData>
  
  <Field name="InputFile">
    
    <short>input</short>
    
    <long>InputFile</long>
    
    <type>FN</type>
    
    <usage>Input file with image or Fourier transform</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="OutputFile">
    
    <short>output</short>
    
    <long>OutputFile</long>
    
    <type>FN</type>
    
    <usage>Output file for Fourier transform or inverse transform</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="3dfft">
    
    <short />
    
    <long>3dfft</long>
    
    <type>B</type>
    
    <usage>Take 3D instead of 2D FFT</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="Mode">
    
    <short>mode</short>
    
    <long>Mode</long>
    
    <type>I</type>
    
    <usage>Output mode for inverse transform (0 byte, 1/6 integer; default is 2)</usage>
    
    <tooltip />
    
    <manpage>Mode of output file for inverse transform: 0 for bytes, 1 or 6 for signed or unsigned integers, or 12 for 16-bit floats.  The default is floating point output, and the default mode used for MRC files is governed by the value of environment variable IMOD_WRITE_FLOATS_16BIT.</manpage>
  
  </Field>
  
  <Field name="Quiet">
    
    <short>quiet</short>
    
    <long>Quiet</long>
    
    <type>B</type>
    
    <usage>Suppress header and min/max/mean outputs</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <long>usage</long>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage>Print help output.</manpage>
  
  </Field>

</autodoc>
