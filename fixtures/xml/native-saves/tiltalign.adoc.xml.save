  <SectionHeader name="UniversalOptions">
    
    <usage>OTHER OPTIONS</usage>
  
  </SectionHeader>
  
  <Field name="CreatedDayStamp">
    
    <short />
    
    <type>I</type>
    
    <usage>A value for when the command file was created (days since 1/1/20).</usage>
    
    <tooltip />
    
    <manpage>A value indicating when the command file was created, so that the program can determine whether to use old or new behavior for some options. Copytomocoms(1) sets this with the number of days since January 1, 2020.</manpage>
  
  </Field>
  
  <Field name="ParameterFile">
    
    <short>param</short>
    
    <type>PF</type>
    
    <usage>Read parameter entries from file</usage>
    
    <tooltip />
    
    <manpage>Read parameter entries as keyword-value pairs from a parameter file.</manpage>
  
  </Field>
  
  <Field name="usage">
    
    <short>help</short>
    
    <type>B</type>
    
    <usage>Print help output</usage>
    
    <tooltip />
    
    <manpage />
  
  </Field>

