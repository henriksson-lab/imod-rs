# Cases whose golden is the fixed translation's output, not native's
# (make-beadtrack-goldens.sh defined overwrites golden/<case> with our build):
# upstream bugs fixed in translation (BUGS.md, beadtrack, 2026-09-26).  name<TAB>fix
base	NaN position in no piece: run completes (native fails reading the image)
elong	NaN position in no piece: run completes (native fails reading the image)
err-noseed	seed-model message names the file
boxout	Sobel peaks scaled then offset (peak * scale + offset)
indexed	Sobel peaks scaled then offset (peak * scale + offset)
local	Sobel peaks scaled then offset (peak * scale + offset)
objs	Sobel peaks scaled then offset (peak * scale + offset)
rounds3	Sobel peaks scaled then offset (peak * scale + offset)
skip	Sobel peaks scaled then offset (peak * scale + offset)
snap	Sobel peaks scaled then offset (peak * scale + offset)
sobel	Sobel peaks scaled then offset; Sobel/centroid residual report prints both values
sobelelong	Sobel peaks scaled then offset (peak * scale + offset)
trace	Sobel peaks scaled then offset (peak * scale + offset)
