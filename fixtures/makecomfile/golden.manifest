text 417 golden/xcorr_pt/dfltcoms/xcorr_pt.com
$goto doxcorr
$doxcorr:
$tiltxcorr -StandardInput
BordersInXandY	3,2
IterateCorrelations	1
InputFile	b_preali.mrc
OutputFile	b_pt.fid
PrealignmentTransformFile	b.prexg
PixelSize	1.0
TiltFile	b.rawtlt
RotationAngle	-85.3
FilterSigma1	0.03
FilterRadius2	0.25
FilterSigma2	0.05
$dochop:
$imodchopconts -StandardInput
InputModel b_pt.fid
OutputModel b.fid
MinimumOverlap 4
AssignSurfaces 1
$if (-e ./savework) ./savework

