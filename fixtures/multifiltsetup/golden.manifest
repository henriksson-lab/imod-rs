text 485 golden/hamming/tilt_mulfil-001.com
# Command file to run Tilt
#
####CreatedVersion#### 4.5.59
#
#   followed by the standard deviation of the Gaussian roll-off
#
# LOG takes the logarithm of tilt data after adding the given value
#
$tilt -StandardInput
InputProjections g.ali
OutputFile	g_hlfs0.200.mrc
IMAGEBINNED 1
TILTFILE g.tlt
XTILTFILE g.xtilt
THICKNESS 30
SHIFT	0.0 0.0
HammingLikeFilter	0.2
FalloffIsTrueSigma 1
XAXISTILT 2.5
LOG 0
SCALE 0 500
PERPENDICULAR
MODE 1
FULLIMAGE 48 40
SUBSETSTART 0 0
AdjustOrigin 1

text 485 golden/hamming/tilt_mulfil-002.com
# Command file to run Tilt
#
####CreatedVersion#### 4.5.59
#
#   followed by the standard deviation of the Gaussian roll-off
#
# LOG takes the logarithm of tilt data after adding the given value
#
$tilt -StandardInput
InputProjections g.ali
OutputFile	g_hlfs0.300.mrc
IMAGEBINNED 1
TILTFILE g.tlt
XTILTFILE g.xtilt
THICKNESS 30
SHIFT	0.0 0.0
HammingLikeFilter	0.3
FalloffIsTrueSigma 1
XAXISTILT 2.5
LOG 0
SCALE 0 500
PERPENDICULAR
MODE 1
FULLIMAGE 48 40
SUBSETSTART 0 0
AdjustOrigin 1

