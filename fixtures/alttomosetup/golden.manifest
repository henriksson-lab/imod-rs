text 145 golden/alt_ctf_erase_filter/alttomo-001-sync.com
$swaptomostacks  -check -root g -from alt -to g_primts
$newstack -StandardInput
InputFile	g.st
OutputFile	g.ali
TransformFile	g.xf
BinByFactor	1

text 216 golden/alt_ctf_erase_filter/alttomo-002-sync.com
$setenv IMOD_OUTPUT_FORMAT MRC
$ctfphaseflip -StandardInput
InputStack	g.ali
AngleFile	g.tlt
OutputFileName	g_ctfcorr.ali
DefocusFile	g.defocus
StartingEndingViews -1  -1
TotalViews 1 9
UseGPU	-1
PixelSize	1.0
$sync

