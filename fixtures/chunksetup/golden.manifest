text 216 golden/basic/filt-001.com
$taperoutvol -StandardInput
InputFile vol.mrc
OutputFile filt-001.in
XMinAndMax 0,127
YMinAndMax 0,95
ZMinAndMax 0,5
TaperPadsInXYZ 8,8,8
$clip median -n 3 filt-001.in filt-001.out
$echo done

$b3dremove filt-001.in

text 211 golden/basic/filt-all.com
# THIS IS A COMMAND FILE TO RUN ALL THE PIECES AND PUT THEM TOGETHER
#
$echo Working on piece  1  of 1
$vmstopy -x filt-001.com filt-001.log
$echo Reassembling pieces
$vmstopy -x filt-finish.com filt-finish.log

text 322 golden/basic/filt-finish.com
# THIS COMMAND FILE REASSEMBLES THE PIECES
#
$setenv IMOD_OUTPUT_FORMAT mrc
$assemblevol -StandardInput
OutputFile out.mrc
StartEndToExtractInX 8,135
StartEndToExtractInY 12,107
StartEndToExtractInZ 9,14
InputFile filt-001.out
$b3dremove -g filt-[0-9][0-9][0-9]*.com* filt-[0-9][0-9][0-9]*.log* filt-[0-9][0-9][0-9]*.out*

