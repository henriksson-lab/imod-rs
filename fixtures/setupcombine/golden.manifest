CenterShiftLimit	10.
#
$ echo "STATUS: DUALVOLMATCH RAN SUCCESSFULLY"

text 413 golden/auto/matchorwarp.com
#$if (! -e ) mkdir 
#
# MATCHORWARP RUNS REFINEMATCH AND MATCHVOL, OR FINDWARP AND WARPVOL.
#
####CreatedVersion####5.2.17
#
$matchorwarp -StandardInput
InputVolume      gb.rec
OutputVolume     gb.mat
SizeXYZorVolume  ga.rec
RefineLimit      0.3
WarpLimits       0.2,0.27,0.35
ExtentToFit	3
StructureCriteria	0.5,0.57,0.65
ModelFile	reg.mod
ResidualFile     patch.resid
ClipPlaneBoxSize 600
#TemporaryDirectory  

sha256 ad6fc00858c042a71a380c835d8a0c4dfa30c4f1f61f33cb62c1d90a33a65d9c 544 golden/auto/matchvol1.com
text 428 golden/auto/matchvol2.com
#$if (! -e ) mkdir 
#
# THIS FILE RUNS A SECOND MATCHVOL
# IT IS RUN ONLY IF YOU HAVE TO DO FINDWARP BY HAND, GET A GOOD
# REFINE.XF BY OMITTING ROWS OR COLUMNS, AND HAVE TO RESTART THE PROCESS
#
$matchvol -StandardInput
InputFile       gb.rec
OutputFile      gb.mat
#TemporaryDirectory      
# The default output size is NZ, NY, NX
OutputSizeXYZ   64 20 64
TransformFile solve.xf
TransformFile refine.xf
InverseFile inverse.xf

