text 458 convert/continuation.csh
nohup
if (-e "x.log") \mv -f "x.log" "x.log~"
if ($?IMOD_DIR) then
    setenv PATH "$IMOD_DIR/bin:$PATH"
endif
if ($?IMOD_QTLIBDIR && $?LD_LIBRARY_PATH) then
    setenv LD_LIBRARY_PATH "${IMOD_QTLIBDIR}:$LD_LIBRARY_PATH"
endif
setenv PIP_PRINT_ENTRIES 1
echo2 Shell PID: $$
prog a   b c  > "x.log"
two \
next line >> "x.log"
three << HERESTRING >> "x.log"
inp1
$var
HERESTRING
pct << HERESTRING >> "x.log"
x
HERESTRING
echo SUCCESSFULLY COMPLETED >> "x.log"

