text 322 golden/xtilt_vary/tilt_for_sirt.com
# Command file to run Tilt
#
$tilt -StandardInput
InputProjections ts.ali
OutputFile ts.rec
IMAGEBINNED 1
TILTFILE ts.tlt
XTILTFILE ts.xtilt
THICKNESS 30
RADIAL .35 .035
FalloffIsTrueSigma 1
XAXISTILT 0.
LOG 0
SCALE 0 1000
PERPENDICULAR
MODE 2
FULLIMAGE 64 48
SUBSETSTART 0 0
AdjustOrigin 1
$if (-e ./savework) ./savework

text 74 golden/xtilt_vary/tilt_sirt-001-sync.com
$b3dremove ts.alilog10
$densnorm -log 0.000000 -ignore ts.ali ts.alilog10

text 386 golden/xtilt_vary/tilt_sirt-002-sync.com
$setenv IMOD_OUTPUT_FORMAT MRC
# Command file to run Tilt
#
$tilt -StandardInput
InputProjections ts.alilog10
OutputFile ts.srec00
IMAGEBINNED 1
TILTFILE ts.tlt
XTILTFILE ts.xtilt
THICKNESS 30
SLICE -1 -1
TOTALSLICES 0 47
RADIAL   0.400 0.050
MASK  2
FlatFilterFraction  1.000000
XAXISTILT 0.
SCALE  0.0 0.2
PERPENDICULAR
MODE   2
FULLIMAGE 64 48
SUBSETSTART   0 0
AdjustOrigin 1
$sync

